{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-collection.css' | asset_url | stylesheet_tag }}
{{ '2gether-search.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&f[]=boska@400,500,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-collection-active');</script>

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign products_count = collection.products_count

  assign active_filter_count = 0
  for filter in collection.filters
    case filter.type
      when 'list'
        for value in filter.values
          if value.active
            assign active_filter_count = active_filter_count | plus: 1
          endif
        endfor
      when 'price_range'
        if filter.min_value.value or filter.max_value.value
          assign active_filter_count = active_filter_count | plus: 1
        endif
    endcase
  endfor
  assign active_filter_count = active_filter_count | plus: current_tags.size

  comment
    Tag facets: every "Name: value" tag in the collection becomes a facet group.
    Known families get a Bulgarian label + fixed order; spelling variants are merged.
  endcomment
  assign facet_map = section.settings.facet_map | default: 'Tyre Size|Tire Size=Размер гума'
  assign facet_map = facet_map | newline_to_br | split: '<br />' | join: ';'
  assign facet_defs = facet_map | split: ';'
  assign facet_tags = ''
  for tag in collection.all_tags
    if tag contains ': '
      unless tag contains 'od-'
        assign facet_tags = facet_tags | append: tag | append: '||'
      endunless
    endif
  endfor
  assign facet_tags = facet_tags | split: '||'
  assign sort_query = ''
  if sort_by != blank
    assign sort_query = '?sort_by=' | append: sort_by
  endif
  assign current_handles = ''
  for t in current_tags
    assign current_handles = current_handles | append: t | handleize | append: ','
  endfor
  assign current_handles = current_handles | split: ','
-%}

<!-- Filter drawer overlay -->
<div class="tg-filter-overlay" id="tg-filter-overlay" data-tg-filter-close></div>

<div class="tg-collection-page">
  <!-- ═══ FILTERS: sidebar on desktop, drawer on mobile ═══ -->
  <aside class="tg-coll-sidebar" id="tg-filter-sidebar" aria-label="Филтри">
    <div class="tg-coll-sidebar-head">
      <span class="tg-coll-sidebar-title">Филтри{% if active_filter_count > 0 %} <em>{{ active_filter_count }}</em>{% endif %}</span>
      {% if active_filter_count > 0 %}<a href="{{ collection.url }}{{ sort_query }}" class="tg-filter-clear">Изчисти</a>{% endif %}
      <button class="tg-filter-close" type="button" data-tg-filter-close aria-label="Затвори филтрите">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    {%- comment -%} Native Shopify filters (Search & Discovery): availability, price, vendor, type, options… {%- endcomment -%}
    {% for filter in collection.filters %}
      <details class="tg-facet" open>
        <summary class="tg-facet-title">{{ filter.label }}<i aria-hidden="true"></i></summary>
        <div class="tg-facet-body">
          {% case filter.type %}
            {% when 'list' %}
              {% for value in filter.values %}
                <label class="tg-filter-option{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="tgApplyFilters()">
                  <span class="tg-filter-check"></span>
                  <span class="tg-filter-label">{{ value.label }}</span>
                  <span class="tg-filter-count">{{ value.count }}</span>
                </label>
              {% endfor %}
            {% when 'price_range' %}
              <div class="tg-filter-price-inputs">
                <input type="number" class="tg-filter-price-input" name="{{ filter.min_value.param_name }}" id="tg-price-min" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}" min="0" max="{{ filter.range_max | divided_by: 100 | ceil }}" placeholder="0">
                <span class="tg-filter-price-sep">—</span>
                <input type="number" class="tg-filter-price-input" name="{{ filter.max_value.param_name }}" id="tg-price-max" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}" min="0" max="{{ filter.range_max | divided_by: 100 | ceil }}" placeholder="{{ filter.range_max | divided_by: 100 | ceil }}">
                <button type="button" class="tg-filter-price-go" onclick="tgApplyFilters()">OK</button>
              </div>
          {% endcase %}
        </div>
      </details>
    {% endfor %}

    {%- comment -%} Tag facets — server-side filtering via /collections/handle/tag-a+tag-b (AND) {%- endcomment -%}
    {%- assign rendered_prefixes = '' -%}
    {%- comment -%} prefixes present in the collection but not in the map get a generic group {%- endcomment -%}
    {%- assign extra_prefixes = '' -%}
    {% for tag in facet_tags %}
      {%- assign pfx = tag | split: ': ' | first -%}
      {%- unless facet_map contains pfx -%}{%- assign extra_prefixes = extra_prefixes | append: pfx | append: '||' -%}{%- endunless -%}
    {% endfor %}
    {%- assign extra_prefixes = extra_prefixes | split: '||' | uniq -%}
    {%- for pfx in extra_prefixes -%}{%- if pfx != blank -%}{%- assign facet_defs = facet_defs | concat: pfx | split: '|' -%}{%- endif -%}{%- endfor -%}
    {% for def in facet_defs %}
      {%- assign def_parts = def | split: '=' -%}
      {%- assign prefixes = def_parts[0] | split: '|' -%}
      {%- assign label = def_parts[1] -%}
      {%- assign values = '' -%}
      {% for tag in facet_tags %}
        {%- assign tag_prefix = tag | split: ': ' | first -%}
        {%- if prefixes contains tag_prefix -%}
          {%- assign values = values | append: tag | append: '||' -%}
        {%- endif -%}
      {% endfor %}
      {%- assign values = values | split: '||' | uniq | sort_natural -%}
      {% if values.size > 0 %}
        {%- assign rendered_prefixes = rendered_prefixes | append: def_parts[0] | append: '|' -%}
        {%- assign group_active = false -%}
        {% for tag in values %}{% if current_tags contains tag %}{% assign group_active = true %}{% endif %}{% endfor %}
        <details class="tg-facet tg-facet--tags" {% if forloop.index <= 4 or group_active %}open{% endif %}>
          <summary class="tg-facet-title">{{ label }}<i aria-hidden="true"></i></summary>
          <div class="tg-facet-body" data-tg-facet-body>
            {% for tag in values %}
              {%- assign tag_handle = tag | handleize -%}
              {%- assign is_on = false -%}
              {%- if current_tags contains tag -%}{%- assign is_on = true -%}{%- endif -%}
              {%- comment -%} build the toggled tag set {%- endcomment -%}
              {%- assign next = '' -%}
              {%- for h in current_handles -%}
                {%- if h != blank and h != tag_handle -%}{%- assign next = next | append: h | append: '+' -%}{%- endif -%}
              {%- endfor -%}
              {%- unless is_on -%}{%- assign next = next | append: tag_handle | append: '+' -%}{%- endunless -%}
              {%- assign next = next | split: '+' | join: '+' -%}
              {%- if next == blank -%}{%- assign href = collection.url | append: sort_query -%}{%- else -%}{%- assign href = collection.url | append: '/' | append: next | append: sort_query -%}{%- endif -%}
              <a href="{{ href }}" class="tg-filter-option tg-filter-option--link{% if is_on %} is-on{% endif %}{% if forloop.index > 8 %} is-extra{% endif %}" rel="nofollow">
                <span class="tg-filter-check"></span>
                <span class="tg-filter-label">{{ tag | split: ': ' | last }}</span>
              </a>
            {% endfor %}
            {% if values.size > 8 %}<button type="button" class="tg-facet-more" data-tg-facet-more>Покажи всички ({{ values.size }})</button>{% endif %}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </aside>

  <!-- ═══ MAIN CONTENT ═══ -->
  <div class="tg-coll-main">

    <!-- Category navigation — jump between collections (shown on every collection page) -->
    {%- liquid
      assign cat_menu = linklists[section.settings.category_menu]
      assign cat_limit = section.settings.max_categories | default: 8
    -%}
    {% if cat_menu != blank and cat_menu.links.size > 0 %}
      {%- comment -%} Curated menu: top-level items are chips; an item with sub-items
        becomes a "Title ▾" dropdown listing its child collections (e.g. group all
        the separate Parts collections under one "Parts" parent). {%- endcomment -%}
      <nav class="tg-coll-cats" aria-label="Категории" data-tg-cats>
        <div class="tg-coll-cats-track">
          {% if section.settings.show_all_chip %}
            <a href="{{ routes.all_products_collection_url }}" class="tg-coll-cat{% if collection.handle == 'all' %} is-active{% endif %}">{{ section.settings.all_label | default: 'Всички' }}</a>
          {% endif %}
          {% for link in cat_menu.links %}
            {% if link.links.size > 0 %}
              <div class="tg-coll-cat-group" data-tg-cat-group>
                <button
                  type="button"
                  class="tg-coll-cat tg-coll-cat--parent{% if link.active or link.child_active %} is-active{% endif %}"
                  data-tg-cat-toggle
                  aria-expanded="false"
                >
                  {{ link.title }}
                  <svg class="tg-coll-cat-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="tg-coll-cat-panel" data-tg-cat-panel>
                  {% if link.url != blank and link.url != '#' %}
                    <a href="{{ link.url }}" class="tg-coll-cat-sub tg-coll-cat-sub--all{% if link.current or link.url == collection.url %} is-active{% endif %}">{{ link.title }}</a>
                  {% endif %}
                  {% for child in link.links %}
                    <a
                      href="{{ child.url }}"
                      class="tg-coll-cat-sub{% if child.current or child.url == collection.url %} is-active{% endif %}"
                    >{{ child.title }}</a>
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <a
                href="{{ link.url }}"
                class="tg-coll-cat{% if link.current or link.url == collection.url %} is-active{% endif %}"
              >{{ link.title }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </nav>
    {% endif %}

    <!-- Hero Banner -->
    <div class="tg-coll-hero">
      <div class="tg-coll-hero-left">
        <h1 class="tg-coll-hero-title">
          {% if section.settings.hero_title != blank %}
            {{ section.settings.hero_title }}
          {% else %}
            {{ collection.title | upcase }}<span>.</span>
          {% endif %}
        </h1>
        {% if collection.description != blank %}
          <p class="tg-coll-hero-desc">{{ collection.description | strip_html }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Toolbar: count · active chips · sort · density -->
    <div class="tg-coll-toolbar">
      <div class="tg-coll-toolbar-left">
        <button type="button" class="tg-filter-toggle" data-tg-filter-open aria-expanded="false" aria-controls="tg-filter-sidebar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6M9 8h6M17 16h6"/></svg>
          <span>Филтри</span>
          {% if active_filter_count > 0 %}<span class="tg-filter-toggle-count">{{ active_filter_count }}</span>{% endif %}
        </button>
        <div class="tg-coll-count">{{ products_count }} {{ products_count | pluralize: 'продукт', 'продукта' }}</div>
      </div>
      <div class="tg-coll-toolbar-right">
        <div class="tg-search-wrap" data-tg-suggest>
          <label class="tg-search-bar" for="tg-coll-search-input">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg>
            <input type="search" id="tg-coll-search-input" placeholder="{{ section.settings.search_placeholder | default: 'Търси в колекцията…' }}" autocomplete="off" data-tg-coll-search>
          </label>
        </div>
        <div class="tg-coll-sort">
          <label for="tg-sort-select">Подреди:</label>
          <select id="tg-sort-select" onchange="tgApplySort(this.value)">
            <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>Препоръчани</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Най-продавани</option>
            <option value="title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>А–Я</option>
            <option value="title-descending" {% if sort_by == 'title-descending' %}selected{% endif %}>Я–А</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Цена: ниска → висока</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Цена: висока → ниска</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Най-нови</option>
          </select>
        </div>
        <div class="tg-coll-density" role="group" aria-label="Изглед">
          <button type="button" data-tg-density="3" aria-label="3 колони"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="5.5" height="5.5"/><rect x="9.25" y="2" width="5.5" height="5.5"/><rect x="16.5" y="2" width="5.5" height="5.5"/><rect x="2" y="9.25" width="5.5" height="5.5"/><rect x="9.25" y="9.25" width="5.5" height="5.5"/><rect x="16.5" y="9.25" width="5.5" height="5.5"/></svg></button>
          <button type="button" data-tg-density="4" aria-label="4 колони"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="4" height="4"/><rect x="8" y="2" width="4" height="4"/><rect x="14" y="2" width="4" height="4"/><rect x="20" y="2" width="2" height="4"/><rect x="2" y="8" width="4" height="4"/><rect x="8" y="8" width="4" height="4"/><rect x="14" y="8" width="4" height="4"/><rect x="20" y="8" width="2" height="4"/></svg></button>
        </div>
      </div>
    </div>

    {% if current_tags.size > 0 or active_filter_count > current_tags.size %}
      <div class="tg-coll-chips">
        {% for tag in current_tags %}
          {%- assign tag_handle = tag | handleize -%}
          {%- assign next = '' -%}
          {%- for h in current_handles -%}{%- if h != blank and h != tag_handle -%}{%- assign next = next | append: h | append: '+' -%}{%- endif -%}{%- endfor -%}
          {%- assign next = next | split: '+' | join: '+' -%}
          {%- if next == blank -%}{%- assign href = collection.url | append: sort_query -%}{%- else -%}{%- assign href = collection.url | append: '/' | append: next | append: sort_query -%}{%- endif -%}
          <a href="{{ href }}" class="tg-coll-chip" rel="nofollow"><span>{{ tag | split: ': ' | last }}</span><i aria-hidden="true">×</i></a>
        {% endfor %}
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}<a href="{{ value.url_to_remove }}" class="tg-coll-chip"><span>{{ value.label }}</span><i aria-hidden="true">×</i></a>{% endfor %}
          {% if filter.type == 'price_range' and filter.min_value.value != blank or filter.max_value.value != blank %}<a href="{{ filter.url_to_remove }}" class="tg-coll-chip"><span>{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}</span><i aria-hidden="true">×</i></a>{% endif %}
        {% endfor %}
        <a href="{{ collection.url }}{{ sort_query }}" class="tg-coll-chip tg-coll-chip--clear">Изчисти всички</a>
      </div>
    {% endif %}

    <!-- Product Grid -->
    <div class="tg-coll-grid" id="tg-products-grid">
      {% paginate collection.products by section.settings.products_per_page %}
        {% for product in collection.products %}
          <div class="tg-coll-card" data-product-id="{{ product.id }}">
            <!-- Link wrapping image -->
            <a href="{{ product.url }}" class="tg-coll-card-image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 50vw' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}

              {%- liquid
                assign discount_pct = 0
                if product.compare_at_price > product.price
                  assign diff = product.compare_at_price | minus: product.price | times: 100.0
                  assign discount_pct = diff | divided_by: product.compare_at_price | round
                endif
              -%}

              <div class="tg-coll-badges">
                <div class="tg-coll-badges-left">
                  {% if discount_pct > 0 %}
                    <span class="tg-coll-badge tg-coll-badge--sale">-{{ discount_pct }}%</span>
                  {% elsif product.tags contains 'new' or product.tags contains 'НОВО' %}
                    <span class="tg-coll-badge tg-coll-badge--new">Ново</span>
                  {% endif %}
                  {% unless product.available %}
                    <span class="tg-coll-badge tg-coll-badge--sold-out">Изчерпан</span>
                  {% endunless %}
                </div>
                <div class="tg-coll-badges-right">
                  {%- for tag in product.tags -%}
                    {%- if tag contains '#' -%}
                      <span class="tg-coll-badge tg-coll-badge--tag">{{ tag | remove: '#' }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </a>

            <!-- Card info -->
            <div class="tg-coll-card-info">
              <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
                <div class="tg-coll-card-name">{{ product.title }}</div>
              </a>
              <div class="tg-coll-card-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="tg-coll-card-price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>

            <!-- Color swatches -->
            {% assign color_option = nil %}
            {% for option in product.options_with_values %}
              {% assign opt_lower = option.name | downcase %}
              {% if opt_lower == 'color' or opt_lower == 'colour' %}
                {% assign color_option = option %}
              {% endif %}
            {% endfor %}

            {% if color_option %}
              <div class="tg-coll-card-swatches">
                {% for value in color_option.values %}
                  <span
                    class="tg-coll-card-swatch"
                    style="background-color: {{ value | handleize }};"
                    title="{{ value }}"
                  ></span>
                {% endfor %}
              </div>
            {% endif %}

            <!-- Quick Add to Cart -->
            {%- form 'product', product, class: 'tg-coll-card-form' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button
                type="submit"
                class="tg-coll-card-add"
                {% unless product.available %}disabled{% endunless %}
              >
                {% if product.available %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                  Добави в количката
                {% else %}
                  Изчерпан
                {% endif %}
              </button>
            {%- endform -%}
          </div>
        {% endfor %}

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="tg-coll-pagination" style="grid-column: 1 / -1;">
            <div class="tg-coll-showing">
              Показани <strong>{{ paginate.current_offset | plus: 1 }}–{{ paginate.current_offset | plus: paginate.page_size | at_most: products_count }}</strong> от <strong>{{ products_count }}</strong> продукта
            </div>

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="tg-coll-load-more">Зареди още</a>
            {% endif %}

            <div class="tg-coll-pages">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" aria-label="Предишна страница">&larr;</a>
              {% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {% else %}
                  <span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>
                {% endif %}
              {% endfor %}
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" aria-label="Следваща страница">&rarr;</a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endpaginate %}
    </div>

  </div>
</div>

<script>
  // Filter drawer open / close (works on all viewports)
  (function() {
    const sidebar = document.getElementById('tg-filter-sidebar');
    const overlay = document.getElementById('tg-filter-overlay');
    if (!sidebar || !overlay) return;

    const openBtn = document.querySelector('[data-tg-filter-open]');

    function open() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
      sidebar.setAttribute('aria-hidden', 'false');
      if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
      sidebar.setAttribute('aria-hidden', 'true');
      if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', open);
    // Facet "show more"
    document.querySelectorAll('[data-tg-facet-more]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = btn.closest('[data-tg-facet-body]');
        body.classList.toggle('is-expanded');
        btn.textContent = body.classList.contains('is-expanded') ? 'Покажи по-малко' : btn.getAttribute('data-label') || 'Покажи всички';
      });
      btn.setAttribute('data-label', btn.textContent);
    });
    // Grid density (remembered)
    var grid = document.getElementById('tg-products-grid');
    var saved = localStorage.getItem('tg-coll-density');
    function setDensity(n) { if (!grid) return; grid.setAttribute('data-density', n); document.querySelectorAll('[data-tg-density]').forEach(function(b) { b.classList.toggle('is-active', b.getAttribute('data-tg-density') === String(n)); }); localStorage.setItem('tg-coll-density', n); }
    setDensity(saved || 3);
    document.querySelectorAll('[data-tg-density]').forEach(function(b) { b.addEventListener('click', function() { setDensity(b.getAttribute('data-tg-density')); }); });
    document.querySelectorAll('[data-tg-filter-close]').forEach(function(el) {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && sidebar.classList.contains('open')) close();
    });
  })();

  // Category dropdowns (grouped collections, e.g. "Parts ▾")
  (function() {
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-tg-cat-group]'));
    if (!groups.length) return;

    function closeAll(except) {
      groups.forEach(function(g) {
        if (g !== except) {
          g.removeAttribute('data-open');
          var t = g.querySelector('[data-tg-cat-toggle]');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    }

    groups.forEach(function(group) {
      var toggle = group.querySelector('[data-tg-cat-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = group.hasAttribute('data-open');
        closeAll(group);
        if (isOpen) {
          group.removeAttribute('data-open');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          group.setAttribute('data-open', '');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('[data-tg-cat-group]')) closeAll(null);
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeAll(null);
    });
  })();

  // Sort
  function tgApplySort(value) {
    var url = new URL(window.location);
    url.searchParams.set('sort_by', value);
    window.location = url.toString();
  }

  // Filter application
  function tgApplyFilters() {
    // keep the tag path (/collections/x/tag-a+tag-b) so tag facets and native filters combine
    var url = new URL(window.location.pathname, window.location.origin);

    // Preserve sort
    var sort = new URL(window.location).searchParams.get('sort_by');
    if (sort) url.searchParams.set('sort_by', sort);

    // Collect checked filters
    document.querySelectorAll('.tg-filter-option input:checked').forEach(function(input) {
      url.searchParams.append(input.name, input.value);
    });

    // Collect price range
    var minInput = document.getElementById('tg-price-min');
    var maxInput = document.getElementById('tg-price-max');
    if (minInput && minInput.value) {
      url.searchParams.set(minInput.name, (parseFloat(minInput.value) * 100).toString());
    }
    if (maxInput && maxInput.value) {
      url.searchParams.set(maxInput.name, (parseFloat(maxInput.value) * 100).toString());
    }

    window.location = url.toString();
  }

  // Quick add to cart via AJAX → refresh the header cart count and open the drawer
  document.querySelectorAll('.tg-coll-card-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = form.querySelector('.tg-coll-card-add');
      var origText = btn.innerHTML;
      btn.innerHTML = 'Добавяне...';
      btn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString()
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        btn.innerHTML = origText;
        btn.disabled = false;
        // Refresh the header cart badge and slide the drawer open.
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart:open'));
      })
      .catch(function() {
        btn.innerHTML = origText;
        btn.disabled = false;
      });
    });
  });
</script>
<script src="{{ '2gether-search.js' | asset_url }}" defer></script>
<script>
  // Live search over the product cards on this page (the global
  // product/collection bubble comes from 2gether-search.js).
  (function () {
    var input = document.querySelector('[data-tg-coll-search]');
    var grid = document.getElementById('tg-products-grid');
    if (!input || !grid) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll('.tg-coll-card'));
    var pagination = grid.querySelector('.tg-coll-pagination');
    var countEl = document.querySelector('.tg-coll-count');
    var baseCount = countEl ? countEl.textContent : '';

    var empty = document.createElement('div');
    empty.className = 'tg-coll-search-empty';
    empty.hidden = true;
    empty.innerHTML = 'Няма продукти за това търсене на страницата. <a href="#" data-tg-search-all>Търси в целия магазин &rarr;</a>';
    grid.appendChild(empty);
    var allLink = empty.querySelector('[data-tg-search-all]');

    function norm(s) { return s.toLowerCase().trim(); }

    input.addEventListener('input', function () {
      var q = norm(input.value);
      if (allLink) allLink.href = '/search?type=product&q=' + encodeURIComponent(input.value.trim());

      if (!q) {
        cards.forEach(function (c) { c.style.display = ''; });
        if (pagination) pagination.style.display = '';
        empty.hidden = true;
        if (countEl) countEl.textContent = baseCount;
        return;
      }

      var visible = 0;
      cards.forEach(function (c) {
        var name = c.querySelector('.tg-coll-card-name');
        var hit = name && norm(name.textContent).indexOf(q) !== -1;
        c.style.display = hit ? '' : 'none';
        if (hit) visible++;
      });
      if (pagination) pagination.style.display = 'none';
      empty.hidden = visible > 0;
      if (countEl) countEl.textContent = visible + ' от ' + baseCount;
    });
  })();
</script>

