{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-bike-rental.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-rental-active');</script>

{%- liquid
  assign rental_collection = collections[section.settings.collection]
  assign rental_bikes = rental_collection.products
  assign max_per_bike = section.settings.max_per_bike | default: 4
-%}

<div class="tg-rental-page" data-tg-rental>

  <!-- ═══ HERO ═══ -->
  <section class="tg-rental-hero">
    <div class="tg-rental-hero-media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', class: 'tg-rental-hero-img' }}
      {% else %}
        <div class="tg-rental-hero-placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="tg-rental-hero-veil"></div>
    </div>

    <div class="tg-rental-hero-inner">
      <span class="tg-eyebrow">{{ section.settings.hero_eyebrow | default: 'Rent a bike' }}</span>
      <h1 class="tg-rental-hero-title">
        {{ section.settings.hero_title | default: 'PICK YOUR' }} <span>{{ section.settings.hero_title_accent | default: 'RIDE' }}</span>
      </h1>
      <p class="tg-rental-hero-sub">{{ section.settings.hero_sub | default: 'By the hour, day, or 24h. Build your crew, pick a package, ride out.' }}</p>
      <a href="#tg-rental-build" class="tg-rental-hero-cta">
        {{ section.settings.hero_cta | default: 'Build your crew' }}
        <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
      </a>
    </div>
  </section>

  <!-- ═══ WIZARD ═══ -->
  <section id="tg-rental-build" class="tg-rental-build">
    {%- form 'contact', id: 'tg-rental-form', class: 'tg-rental-form', data-tg-rental-wizard: '' -%}
      <input type="hidden" name="contact[type]" value="Bike rental booking">
      <input type="hidden" name="contact[bikes]" data-tg-rental-bikes-input>
      <input type="hidden" name="contact[total_riders]" data-tg-rental-riders-input value="0">

      {% if form.posted_successfully? %}
        <div class="tg-rental-ok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          {{ section.settings.form_success | default: 'Thanks — your reservation is in. We will reply within 24h with availability.' }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="tg-rental-error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <!-- Progress -->
      <div class="tg-r-progress">
        <div class="tg-r-progress-track">
          <div class="tg-r-progress-fill" data-tg-r-fill style="width: 33%"></div>
        </div>
        <ol class="tg-r-progress-steps">
          <li class="is-active" data-tg-r-step-label="1"><span class="tg-r-step-dot">1</span><span class="tg-r-step-name">{{ section.settings.step1_tab | default: 'Roster' }}</span></li>
          <li data-tg-r-step-label="2"><span class="tg-r-step-dot">2</span><span class="tg-r-step-name">{{ section.settings.step2_tab | default: 'Plan' }}</span></li>
          <li data-tg-r-step-label="3"><span class="tg-r-step-dot">3</span><span class="tg-r-step-name">{{ section.settings.step3_tab | default: 'Contact' }}</span></li>
        </ol>
      </div>

      <!-- ── STEP 1: CHARACTER SELECT ── -->
      <div class="tg-r-step is-active" data-tg-r-step="1">
        <header class="tg-r-step-head">
          <span class="tg-r-step-num">{{ section.settings.step1_eyebrow | default: '01 · The crew' }}</span>
          <h2 class="tg-r-step-title">{{ section.settings.step1_title | default: 'Choose your character' }}</h2>
          <p class="tg-r-step-sub">{{ section.settings.step1_sub | default: 'Tap to add a bike to the crew. Tap again to add another of the same.' }} {{ 'Up to' }} {{ max_per_bike }} {{ 'per model.' }}</p>
        </header>

        {% if rental_bikes.size > 0 %}
          <div class="tg-bike-roster" data-tg-rental-roster>
            {% for product in rental_bikes %}
              {%- liquid
                assign type_label = product.type | default: 'Bike'
                assign primary_tag = ''
                for tag in product.tags
                  if tag contains 'rental:'
                    assign primary_tag = tag | remove: 'rental:' | strip
                    break
                  endif
                endfor
              -%}
              <article
                class="tg-bike-card"
                data-tg-bike
                data-bike-handle="{{ product.handle }}"
                data-bike-name="{{ product.title | escape }}"
                data-bike-price="{{ product.price | divided_by: 100.0 | round: 2 }}"
                data-bike-max="{{ max_per_bike }}"
              >
                <div class="tg-bike-card-media">
                  {% if product.featured_image != blank %}
                    {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 33vw', alt: product.title }}
                  {% else %}
                    <div class="tg-bike-card-placeholder" aria-hidden="true"></div>
                  {% endif %}
                  <div class="tg-bike-card-overlay" aria-hidden="true"></div>
                  <span class="tg-bike-card-badge">{{ type_label }}</span>
                  {% if primary_tag != blank %}
                    <span class="tg-bike-card-tag">{{ primary_tag }}</span>
                  {% endif %}
                  <span class="tg-bike-card-selected" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                </div>

                <div class="tg-bike-card-info">
                  <h3 class="tg-bike-card-name">{{ product.title }}</h3>
                  {% if product.description != blank %}
                    <p class="tg-bike-card-desc">{{ product.description | strip_html | truncate: 90 }}</p>
                  {% endif %}
                  <div class="tg-bike-card-foot">
                    <span class="tg-bike-card-price">
                      <small>{{ section.settings.bike_price_hint | default: 'From €3 / 1h' }}</small>
                    </span>
                    <div class="tg-bike-qty" data-tg-bike-qty>
                      <button type="button" class="tg-bike-qty-btn" data-tg-bike-dec aria-label="Remove one">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      </button>
                      <span class="tg-bike-qty-num" data-tg-bike-qty-num>0</span>
                      <button type="button" class="tg-bike-qty-btn" data-tg-bike-inc aria-label="Add one">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        {% else %}
          <div class="tg-rental-empty">
            <p>{{ section.settings.empty_text | default: 'No rental bikes configured yet. Pick a collection in the section settings.' }}</p>
          </div>
        {% endif %}

        <!-- Sticky roster summary -->
        <aside class="tg-roster-summary" data-tg-roster-summary aria-live="polite">
          <div class="tg-roster-summary-text">
            <span class="tg-roster-summary-count" data-tg-rental-count>0</span>
            <span class="tg-roster-summary-label" data-tg-rental-label>{{ section.settings.riders_label_plural | default: 'riders in the crew' }}</span>
          </div>
          <div class="tg-roster-summary-bikes" data-tg-rental-bikes-display></div>
          <button type="button" class="tg-r-btn tg-r-btn--next" data-tg-r-next disabled>
            {{ section.settings.step1_next | default: 'Next: Pick dates' }}
            <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
          </button>
        </aside>
      </div>

      <!-- ── STEP 2: PACKAGE + DATE + DELIVERY ── -->
      <div class="tg-r-step" data-tg-r-step="2">
        <header class="tg-r-step-head">
          <span class="tg-r-step-num">{{ section.settings.step2_eyebrow | default: '02 · The plan' }}</span>
          <h2 class="tg-r-step-title">{{ section.settings.step2_title | default: 'Pick your package' }}</h2>
          <p class="tg-r-step-sub">{{ section.settings.step2_sub | default: 'Most rentals are by the hour or for the day. Pick the package, the day, and how you would like to get the bike.' }}</p>
        </header>

        <fieldset class="tg-r-field tg-r-field--full">
          <legend class="tg-r-field-label">{{ section.settings.package_label | default: 'Rental package' }}</legend>
          <div class="tg-r-pkg-grid">
            {%- assign pkg_lines = section.settings.packages | default: '1 hour|3|Quick spin around town
1 day|12|9:00 — 19:00 same day
24 hours|20|Full day, return next day' | newline_to_br | split: '<br />' -%}
            {% for pkg in pkg_lines %}
              {%- assign p = pkg | strip_newlines | strip | split: '|' -%}
              {%- if p[0] == blank %}{% continue %}{% endif -%}
              <label class="tg-r-pkg">
                <input type="radio" name="contact[package]" value="{{ p[0] | strip }} (€{{ p[1] | strip }})" data-tg-r-pkg-price="{{ p[1] | strip }}" required data-tg-r-validate>
                <span class="tg-r-pkg-name">{{ p[0] | strip }}</span>
                <span class="tg-r-pkg-price">€{{ p[1] | strip }}<small> {{ section.settings.package_unit | default: '/ bike' }}</small></span>
                <span class="tg-r-pkg-desc">{{ p[2] | strip }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <div class="tg-r-date-grid">
          <label class="tg-r-field">
            <span class="tg-r-field-label">{{ section.settings.pickup_date_label | default: 'Pickup date' }}</span>
            <input type="date" name="contact[pickup_date]" data-tg-r-start required data-tg-r-validate>
          </label>
          <fieldset class="tg-r-field">
            <legend class="tg-r-field-label">{{ section.settings.pickup_time_label | default: 'Час на взимане' }}</legend>
            {%- assign hour_start = section.settings.hour_start | default: 9 -%}
            {%- assign hour_end = section.settings.hour_end | default: 18 -%}
            <div class="tg-r-slot-grid tg-r-slot-grid--hours">
              {%- for h in (hour_start..hour_end) -%}
                <label class="tg-r-slot tg-r-slot--hour">
                  <input type="radio" name="contact[pickup_time]" value="{{ h }}:00" required data-tg-r-validate>
                  <span class="tg-r-slot-name">{{ h }}:00</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        </div>

        <fieldset class="tg-r-field tg-r-field--full tg-r-days-field">
          <legend class="tg-r-field-label">{{ section.settings.days_label | default: 'За колко дни?' }}</legend>
          <div class="tg-r-days" data-tg-r-days>
            <button type="button" class="tg-r-days-btn" data-tg-r-days-dec aria-label="По-малко дни">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <span class="tg-r-days-num" data-tg-r-days-num>1</span>
            <span class="tg-r-days-unit" data-tg-r-days-unit>{{ section.settings.days_unit_singular | default: 'ден' }}</span>
            <button type="button" class="tg-r-days-btn" data-tg-r-days-inc aria-label="Повече дни">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
          </div>
          <input type="hidden" name="contact[days]" data-tg-r-days-input value="1">
          <p class="tg-r-days-hint">{{ section.settings.days_hint | default: 'При наем за повече от един ден дневната тарифа важи за всеки ден.' }}</p>
        </fieldset>

        <fieldset class="tg-r-field tg-r-field--full">
          <legend class="tg-r-field-label">{{ section.settings.delivery_field_label | default: 'Delivery (within Varna — hotels & addresses)' }}</legend>
          <div class="tg-r-delivery-grid">
            {%- assign delivery_lines = section.settings.delivery_options | default: 'Pickup at shop|0|Drop by at our location
One-way delivery|5|We bring it to you
Round-trip delivery|10|Drop-off & pickup at your place' | newline_to_br | split: '<br />' -%}
            {% for d in delivery_lines %}
              {%- assign dp = d | strip_newlines | strip | split: '|' -%}
              {%- if dp[0] == blank %}{% continue %}{% endif -%}
              {%- assign dp_price = dp[1] | strip -%}
              <label class="tg-r-delivery">
                <input type="radio" name="contact[delivery]" value="{{ dp[0] | strip }} (€{{ dp_price }})" data-tg-r-delivery-price="{{ dp_price }}" {% if forloop.first %}checked{% endif %} data-tg-r-validate>
                <span class="tg-r-delivery-name">{{ dp[0] | strip }}</span>
                <span class="tg-r-delivery-price">{% if dp_price == '0' %}{{ section.settings.free_label | default: 'Free' }}{% else %}€{{ dp_price }}{% endif %}</span>
                <span class="tg-r-delivery-desc">{{ dp[2] | strip }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <div class="tg-r-summary-row" data-tg-r-duration aria-live="polite">
          <span class="tg-r-summary-label">{{ section.settings.total_label | default: 'Estimated total' }}</span>
          <span class="tg-r-summary-value">{{ section.settings.total_empty | default: 'Pick a package' }}</span>
        </div>

        <div class="tg-r-actions">
          <button type="button" class="tg-r-btn tg-r-btn--back" data-tg-r-back>
            <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 5H2M6 1L2 5l4 4"/></svg>
            {{ section.settings.back_label | default: 'Back' }}
          </button>
          <button type="button" class="tg-r-btn tg-r-btn--next" data-tg-r-next>
            {{ section.settings.step2_next | default: 'Next: Your details' }}
            <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
          </button>
        </div>
      </div>

      <!-- ── STEP 3: CONTACT ── -->
      <div class="tg-r-step" data-tg-r-step="3">
        <header class="tg-r-step-head">
          <span class="tg-r-step-num">{{ section.settings.step3_eyebrow | default: '03 · The leader' }}</span>
          <h2 class="tg-r-step-title">{{ section.settings.step3_title | default: 'Who is leading the crew?' }}</h2>
          <p class="tg-r-step-sub">{{ section.settings.step3_sub | default: 'One contact for the whole reservation — the lead rider. We will message you about pickup details.' }}</p>
        </header>

        <div class="tg-r-contact-grid">
          <label class="tg-r-field">
            <span class="tg-r-field-label">{{ section.settings.name_label | default: 'Lead rider name' }}</span>
            <input type="text" name="contact[name]" required data-tg-r-validate>
          </label>
          <label class="tg-r-field">
            <span class="tg-r-field-label">{{ section.settings.phone_label | default: 'Phone' }}</span>
            <input type="tel" name="contact[phone]" required data-tg-r-validate>
          </label>
          <label class="tg-r-field tg-r-field--full">
            <span class="tg-r-field-label">{{ section.settings.email_label | default: 'Email' }}</span>
            <input type="email" name="contact[email]" required data-tg-r-validate>
          </label>
          <label class="tg-r-field">
            <span class="tg-r-field-label">{{ section.settings.experience_label | default: 'Group experience' }}</span>
            <select name="contact[experience]">
              {%- assign exp_opts = section.settings.experience_options | default: '— optional —
First time on a real bike
Casual riders
Experienced — we ride often
Mixed levels' | newline_to_br | split: '<br />' -%}
              {%- for opt in exp_opts -%}
                {%- assign opt_clean = opt | strip_newlines | strip -%}
                {%- if opt_clean != blank -%}
                  <option value="{{ opt_clean | escape }}">{{ opt_clean }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </label>
          <label class="tg-r-field">
            <span class="tg-r-field-label">{{ section.settings.heights_label | default: 'Heights (cm)' }}</span>
            <input type="text" name="contact[heights]" placeholder="{{ section.settings.heights_placeholder | default: 'e.g. 178, 165, 182' }}">
          </label>
          <label class="tg-r-field tg-r-field--full">
            <span class="tg-r-field-label">{{ section.settings.notes_label | default: 'Anything else?' }}</span>
            <textarea name="contact[notes]" rows="2" placeholder="{{ section.settings.notes_placeholder | default: "Routes you're considering, child seats, helmets, anything else." }}"></textarea>
          </label>
        </div>

        <!-- Final summary card -->
        <div class="tg-r-final-summary" data-tg-r-final-summary>
          <h4>{{ section.settings.review_label | default: 'Review' }}</h4>
          <div data-tg-r-final-content>
            <p class="tg-r-final-empty">{{ section.settings.review_empty | default: 'Fill the form to see your reservation summary.' }}</p>
          </div>
        </div>

        <div class="tg-r-actions">
          <button type="button" class="tg-r-btn tg-r-btn--back" data-tg-r-back>
            <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 5H2M6 1L2 5l4 4"/></svg>
            {{ section.settings.back_label | default: 'Back' }}
          </button>
          <button type="submit" class="tg-r-btn tg-r-btn--submit">
            {{ section.settings.form_submit | default: 'Reserve crew' }}
            <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
          </button>
        </div>

        <p class="tg-r-form-note">
          {{ section.settings.form_note | default: 'We confirm by email within 24h. A €100 deposit is held on pickup and refunded at drop-off.' }}
        </p>
      </div>
    {%- endform -%}
  </section>

  <!-- ═══ INFO STRIP ═══ -->
  <section class="tg-rental-info">
    <div class="tg-rental-info-grid">
      <div class="tg-rental-info-card">
        <span class="tg-eyebrow">{{ section.settings.hourly_eyebrow | default: '1 hour' }}</span>
        <strong>{{ section.settings.hourly_label | default: '€3 / hour' }}</strong>
        <p>{{ section.settings.hourly_text | default: 'Quick spin around town. Most popular package.' }}</p>
      </div>
      <div class="tg-rental-info-card">
        <span class="tg-eyebrow">{{ section.settings.daily_eyebrow | default: '1 day' }}</span>
        <strong>{{ section.settings.daily_label | default: '€12 / day' }}</strong>
        <p>{{ section.settings.daily_text | default: 'Pickup 9:00, drop off by 19:00 same day.' }}</p>
      </div>
      <div class="tg-rental-info-card">
        <span class="tg-eyebrow">{{ section.settings.full_eyebrow | default: '24 hours' }}</span>
        <strong>{{ section.settings.full_label | default: '€20 / 24h' }}</strong>
        <p>{{ section.settings.full_text | default: 'Full 24-hour rental. Return next day.' }}</p>
      </div>
      <div class="tg-rental-info-card tg-rental-info-card--delivery">
        <span class="tg-eyebrow">{{ section.settings.delivery_eyebrow | default: 'Delivery' }}</span>
        <strong>{{ section.settings.delivery_label | default: 'One-way €5 · Round-trip €10' }}</strong>
        <p>{{ section.settings.delivery_text | default: 'In Varna — we deliver to hotels and addresses.' }}</p>
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    const root = document.querySelector('[data-tg-rental]');
    if (!root) return;

    const TG_RIDER_SINGULAR = {{ section.settings.riders_label_singular | default: 'rider in the crew' | json }};
    const TG_RIDER_PLURAL = {{ section.settings.riders_label_plural | default: 'riders in the crew' | json }};
    const TG_TAP_HINT = {{ section.settings.tap_hint | default: 'Tap a card to add' | json }};

    const wizard = root.querySelector('[data-tg-rental-wizard]');
    const steps = Array.from(root.querySelectorAll('[data-tg-r-step]'));
    const labels = Array.from(root.querySelectorAll('[data-tg-r-step-label]'));
    const fill = root.querySelector('[data-tg-r-fill]');
    const total = steps.length;
    let current = 1;

    // ── Bike roster ────────────────────────────────────────
    const bikeCards = Array.from(root.querySelectorAll('[data-tg-bike]'));
    const countEl = root.querySelector('[data-tg-rental-count]');
    const labelEl = root.querySelector('[data-tg-rental-label]');
    const bikesDisplay = root.querySelector('[data-tg-rental-bikes-display]');
    const bikesInput = root.querySelector('[data-tg-rental-bikes-input]');
    const ridersInput = root.querySelector('[data-tg-rental-riders-input]');
    const summary = root.querySelector('[data-tg-roster-summary]');
    const stepNextButtons = Array.from(root.querySelectorAll('[data-tg-r-next]'));

    function moneyDisplay(n) {
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function readSelection() {
      const out = [];
      let total = 0;
      bikeCards.forEach(card => {
        const numEl = card.querySelector('[data-tg-bike-qty-num]');
        const qty = parseInt(numEl.textContent, 10) || 0;
        if (qty > 0) {
          out.push({
            handle: card.dataset.bikeHandle,
            name: card.dataset.bikeName,
            price: parseFloat(card.dataset.bikePrice) || 0,
            qty
          });
          total += qty;
        }
      });
      return { items: out, total };
    }

    function updateRosterSummary() {
      const sel = readSelection();

      if (countEl) countEl.textContent = sel.total;
      if (labelEl) labelEl.textContent = sel.total === 1 ? TG_RIDER_SINGULAR : TG_RIDER_PLURAL;
      if (ridersInput) ridersInput.value = sel.total;
      if (bikesInput) bikesInput.value = sel.items.map(b => b.qty + '× ' + b.name).join(', ');

      if (bikesDisplay) {
        if (sel.items.length === 0) {
          bikesDisplay.innerHTML = '<span class="tg-roster-summary-hint">' + TG_TAP_HINT + '</span>';
        } else {
          bikesDisplay.innerHTML = sel.items.map(b =>
            '<span class="tg-roster-pill">' + b.qty + '× ' + escapeHtml(b.name) + '</span>'
          ).join('');
        }
      }

      // Toggle Step 1 next button
      const step1Next = root.querySelector('[data-tg-r-step="1"] [data-tg-r-next]');
      if (step1Next) step1Next.disabled = sel.total === 0;

      if (summary) {
        summary.classList.toggle('has-selection', sel.total > 0);
      }

      // Crew size changes affect the total
      if (typeof updateDuration === 'function') updateDuration();
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
    }

    bikeCards.forEach(card => {
      const numEl = card.querySelector('[data-tg-bike-qty-num]');
      const inc = card.querySelector('[data-tg-bike-inc]');
      const dec = card.querySelector('[data-tg-bike-dec]');
      const max = parseInt(card.dataset.bikeMax, 10) || 4;

      function setQty(n) {
        n = Math.max(0, Math.min(max, n));
        numEl.textContent = n;
        card.classList.toggle('is-selected', n > 0);
        card.dataset.bikeQty = n;
        updateRosterSummary();
      }

      inc?.addEventListener('click', (e) => {
        e.stopPropagation();
        setQty((parseInt(numEl.textContent, 10) || 0) + 1);
      });
      dec?.addEventListener('click', (e) => {
        e.stopPropagation();
        setQty((parseInt(numEl.textContent, 10) || 0) - 1);
      });

      // Tap on card body adds one (skip when clicking the qty controls)
      card.addEventListener('click', (e) => {
        if (e.target.closest('[data-tg-bike-qty]')) return;
        setQty((parseInt(numEl.textContent, 10) || 0) + 1);
      });
    });

    // ── Package + delivery pricing ──────────────────────────
    const startInput = root.querySelector('[data-tg-r-start]');
    const durationBox = root.querySelector('[data-tg-r-duration]');

    // ── Rental length (days) ────────────────────────────────
    const daysWrap = root.querySelector('[data-tg-r-days]');
    const daysNumEl = root.querySelector('[data-tg-r-days-num]');
    const daysUnitEl = root.querySelector('[data-tg-r-days-unit]');
    const daysInput = root.querySelector('[data-tg-r-days-input]');
    const DAYS_MAX = {{ section.settings.days_max | default: 30 }};
    const DAYS_UNIT_SINGULAR = {{ section.settings.days_unit_singular | default: 'ден' | json }};
    const DAYS_UNIT_PLURAL = {{ section.settings.days_unit_plural | default: 'дни' | json }};

    function getDays() {
      return Math.max(1, parseInt((daysInput && daysInput.value) || '1', 10) || 1);
    }
    function setDays(n) {
      n = Math.max(1, Math.min(DAYS_MAX, n));
      if (daysNumEl) daysNumEl.textContent = n;
      if (daysUnitEl) daysUnitEl.textContent = n === 1 ? DAYS_UNIT_SINGULAR : DAYS_UNIT_PLURAL;
      if (daysInput) daysInput.value = n;
      if (typeof updateDuration === 'function') updateDuration();
    }
    if (daysWrap) {
      const decBtn = daysWrap.querySelector('[data-tg-r-days-dec]');
      const incBtn = daysWrap.querySelector('[data-tg-r-days-inc]');
      if (decBtn) decBtn.addEventListener('click', () => setDays(getDays() - 1));
      if (incBtn) incBtn.addEventListener('click', () => setDays(getDays() + 1));
    }

    function selectedPackage() {
      const checked = root.querySelector('input[name="contact[package]"]:checked');
      if (!checked) return null;
      return {
        key: checked.dataset.tgRPkgKey,
        label: checked.value,
        price: parseFloat(checked.dataset.tgRPkgPrice) || 0
      };
    }

    function selectedDelivery() {
      const checked = root.querySelector('input[name="contact[delivery]"]:checked');
      if (!checked) return { key: 'pickup', label: 'Pickup at shop (€0)', price: 0 };
      return {
        key: checked.dataset.tgRDeliveryKey,
        label: checked.value,
        price: parseFloat(checked.dataset.tgRDeliveryPrice) || 0
      };
    }

    function calcTotal() {
      const pkg = selectedPackage();
      const del = selectedDelivery();
      if (!pkg) return null;
      const crew = readSelection().total || 0;
      return pkg.price * Math.max(crew, 1) * getDays() + del.price;
    }

    function updateDuration() {
      if (!durationBox) return;
      const value = durationBox.querySelector('.tg-r-summary-value');
      if (!value) return;
      const total = calcTotal();
      if (total === null) {
        value.textContent = 'Pick a package';
        durationBox.classList.remove('has-value');
      } else {
        value.textContent = '€' + total.toFixed(2);
        durationBox.classList.add('has-value');
      }
    }

    root.querySelectorAll('input[name="contact[package]"], input[name="contact[delivery]"]').forEach(el => {
      el.addEventListener('change', updateDuration);
    });

    // Min date = today
    const todayIso = new Date().toISOString().slice(0, 10);
    if (startInput) startInput.min = todayIso;

    // ── Final summary ──────────────────────────────────────
    const finalContent = root.querySelector('[data-tg-r-final-content]');
    function updateFinalSummary() {
      if (!finalContent) return;
      const sel = readSelection();
      const slot = root.querySelector('input[name="contact[pickup_time]"]:checked')?.value || '—';
      const pkg = selectedPackage();
      const del = selectedDelivery();
      if (sel.total === 0) {
        finalContent.innerHTML = '<p class="tg-r-final-empty">Pick at least one bike to see your summary.</p>';
        return;
      }
      let html = '<dl class="tg-r-final-list">';
      html += '<div><dt>Crew</dt><dd>' + sel.total + (sel.total === 1 ? ' rider' : ' riders') + '</dd></div>';
      html += '<div><dt>Bikes</dt><dd>' + sel.items.map(b => b.qty + '× ' + escapeHtml(b.name)).join(', ') + '</dd></div>';
      if (pkg) {
        html += '<div><dt>Package</dt><dd>' + escapeHtml(pkg.label) + '</dd></div>';
      }
      const days = getDays();
      html += '<div><dt>Days</dt><dd>' + days + ' ' + (days === 1 ? DAYS_UNIT_SINGULAR : DAYS_UNIT_PLURAL) + '</dd></div>';
      if (startInput?.value) {
        html += '<div><dt>Pickup</dt><dd>' + escapeHtml(startInput.value) + ' · ' + escapeHtml(slot) + '</dd></div>';
      }
      html += '<div><dt>Delivery</dt><dd>' + escapeHtml(del.label) + '</dd></div>';
      const total = calcTotal();
      if (total !== null) {
        html += '<div class="tg-r-final-list__total"><dt>Estimated total</dt><dd>€' + total.toFixed(2) + '</dd></div>';
      }
      html += '</dl>';
      finalContent.innerHTML = html;
    }

    // ── Wizard nav ─────────────────────────────────────────
    function isVisible(el) { return el && el.offsetParent !== null; }

    function validateStep(stepNum) {
      const step = steps.find(s => s.dataset.tgRStep === String(stepNum));
      if (!step) return true;

      // Step 1 needs at least one bike
      if (stepNum === 1) {
        return readSelection().total > 0;
      }

      const fields = step.querySelectorAll('[data-tg-r-validate]');
      let firstInvalid = null;
      let ok = true;
      fields.forEach(f => {
        if (!isVisible(f)) return;
        if (!f.checkValidity()) {
          ok = false;
          if (!firstInvalid) firstInvalid = f;
          f.classList.add('tg-r-invalid');
        } else {
          f.classList.remove('tg-r-invalid');
        }
      });
      if (firstInvalid) {
        firstInvalid.focus({ preventScroll: false });
        firstInvalid.reportValidity();
      }
      return ok;
    }

    function goTo(n) {
      n = Math.max(1, Math.min(total, n));
      current = n;
      steps.forEach(s => s.classList.toggle('is-active', s.dataset.tgRStep === String(n)));
      labels.forEach(l => {
        const ln = parseInt(l.dataset.tgRStepLabel, 10);
        l.classList.toggle('is-active', ln === n);
        l.classList.toggle('is-done', ln < n);
      });
      if (fill) fill.style.width = ((n / total) * 100) + '%';

      // Hide sticky roster outside step 1
      if (summary) summary.classList.toggle('is-visible', n === 1);

      // Refresh summary on step 3
      if (n === 3) updateFinalSummary();

      // Scroll head into view
      const head = root.querySelector('.tg-r-progress');
      if (head) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    wizard.addEventListener('click', (e) => {
      if (e.target.closest('[data-tg-r-next]')) {
        if (validateStep(current)) goTo(current + 1);
      } else if (e.target.closest('[data-tg-r-back]')) {
        goTo(current - 1);
      }
    });

    wizard.addEventListener('input', (e) => {
      if (e.target.classList?.contains('tg-r-invalid')) e.target.classList.remove('tg-r-invalid');
    });

    wizard.addEventListener('submit', (e) => {
      if (!validateStep(current)) e.preventDefault();
    });

    // Server-side error → jump to last step
    if (root.querySelector('.tg-rental-error')) goTo(total);

    // Init
    if (summary) summary.classList.add('is-visible');
    updateRosterSummary();
    updateDuration();
  })();
</script>

