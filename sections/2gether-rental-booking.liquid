{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-rental-booking.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign bikes = shop.metaobjects.rental_bike.values
  assign tiers_default = st.long_tiers | newline_to_br | split: '<br />'
  assign d_day = 'tg.common.day' | t
  assign d_days = 'tg.common.days' | t
-%}

<section class="tg-rb tg-section" id="tg-rental-booking" data-tg-rb
  data-endpoint="{{ st.endpoint | default: '/apps/club' }}"
  data-hourly="{{ st.hourly_rate }}" data-day="{{ st.day_rate }}" data-h24="{{ st.h24_rate }}" data-max-hours="{{ st.max_hours | default: 24 }}"
  data-hour-start="{{ st.hour_start | default: 9 }}" data-hour-end="{{ st.hour_end | default: 19 }}"
  data-tiers="{{ st.long_tiers | newline_to_br | replace: '<br />', ';' | escape }}"
  data-min-days="{{ st.long_min_days | default: 2 }}" data-deposit="{{ st.deposit | escape }}"
  data-tiers-ebike="{{ st.long_tiers_ebike | newline_to_br | replace: '<br />', ';' | escape }}" data-rescue="{{ st.rescue_price | default: 5 }}">
  <div class="tg-rb-inner">
    <header class="tg-rb-head">
      <span class="tg-label">{{ st.eyebrow }}</span>
      <h2 class="tg-rb-title">{{ st.title }}</h2>
      {% if st.intro != blank %}<p class="tg-rb-intro">{{ st.intro }}</p>{% endif %}
    </header>

    <!-- ── 1. bikes ── -->
    <div class="tg-rb-block">
      <div class="tg-rb-step"><span>01</span>{{ st.step_bikes }}</div>
      {% if bikes.size > 0 %}
        <div class="tg-rb-bikes" data-rb-bikes>
          {% for b in bikes %}
            {%- if b.active.value != true -%}{%- continue -%}{%- endif -%}
            <article class="tg-rb-bike" data-rb-bike="{{ b.system.handle }}" data-name="{{ b.name.value | escape }}" data-count="{{ b.count.value | default: 0 }}"
              data-hourly="{{ b.hourly_rate.value }}" data-day="{{ b.day_rate.value }}" data-tiers="{{ b.long_term_tiers.value | newline_to_br | replace: '<br />', ';' | escape }}"{% assign rb_cat = b.category.value | downcase %}{% if rb_cat contains 'e-bike' or rb_cat contains 'ebike' or rb_cat contains 'електр' or rb_cat contains 'electric' %} data-electric="1"{% endif %}>
              <div class="tg-rb-bike-media">
                {% if b.photo.value != blank %}{{ b.photo.value | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 33vw', alt: b.name.value }}{% else %}<div class="tg-rb-ph"></div>{% endif %}
                {% if b.category.value != blank %}<span class="tg-rb-bike-cat">{{ b.category.value }}</span>{% endif %}
                <span class="tg-rb-bike-avail" data-rb-avail><i></i><b data-rb-avail-n>{{ b.count.value }}</b> {{ st.available_label }}</span>
              </div>
              <div class="tg-rb-bike-body">
                <h3 class="tg-rb-bike-name">{{ b.name.value }}</h3>
                {% if b.sizes.value != blank %}<span class="tg-rb-bike-sizes">{{ st.sizes_label }} {{ b.sizes.value }}</span>{% endif %}
                {% if b.description.value != blank %}<p class="tg-rb-bike-desc">{{ b.description.value | strip_html | truncate: 110 }}</p>{% endif %}
                <div class="tg-rb-bike-foot">
                  <span class="tg-rb-bike-price">{{ st.from_label }} €<b data-rb-from>{{ b.hourly_rate.value | default: st.hourly_rate }}</b>/{{ st.hour_short }}</span>
                  <div class="tg-rb-qty"><button type="button" data-rb-dec aria-label="−">−</button><span data-rb-qty>0</span><button type="button" data-rb-inc aria-label="+">+</button></div>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <p class="tg-rb-empty">{{ st.empty_text }}</p>
      {% endif %}
    </div>

    <!-- ── 2. mode + time ── -->
    <div class="tg-rb-block tg-rb-grid">
      <div>
        <div class="tg-rb-step"><span>02</span>{{ st.step_time }}</div>
        <div class="tg-rb-modes" role="tablist">
          <button type="button" class="tg-rb-mode is-active" data-rb-mode="short" role="tab" aria-selected="true"><strong>{{ st.short_title }}</strong><small>{{ st.short_sub }}</small></button>
          <button type="button" class="tg-rb-mode" data-rb-mode="long" role="tab" aria-selected="false"><strong>{{ st.long_title }}</strong><small>{{ st.long_sub }}</small></button>
        </div>

        <div class="tg-rb-pane" data-rb-pane="short">
          <label class="tg-rb-field"><span>{{ st.date_label }}</span><input type="date" data-rb-short-date required></label>
          <div class="tg-rb-field"><span>{{ st.hour_label }}</span><div class="tg-rb-chips" data-rb-hours></div></div>
          <div class="tg-rb-field"><span>{{ st.duration_label }}</span><div class="tg-rb-chips" data-rb-durations></div></div>
          <p class="tg-rb-hint">{{ st.short_hint }}</p>
        </div>

        <div class="tg-rb-pane" data-rb-pane="long" hidden>
          <div class="tg-rb-cal" data-rb-cal>
            <div class="tg-rb-cal-nav"><button type="button" data-rb-cal-prev aria-label="←">‹</button><span data-rb-cal-title></span><button type="button" data-rb-cal-next aria-label="→">›</button></div>
            <div class="tg-rb-cal-months" data-rb-cal-months></div>
            <div class="tg-rb-cal-legend"><i class="is-free"></i>{{ st.legend_free }} <i class="is-busy"></i>{{ st.legend_busy }} <i class="is-sel"></i>{{ st.legend_selected }}</div>
          </div>
          <p class="tg-rb-hint" data-rb-long-hint>{{ st.long_hint }}</p>
        </div>
      </div>

      <!-- ── 3. summary + contact ── -->
      <aside class="tg-rb-summary" data-rb-summary>
        <div class="tg-rb-step"><span>03</span>{{ st.step_confirm }}</div>
        <dl class="tg-rb-lines" data-rb-lines><dd class="tg-rb-lines-empty">{{ st.summary_empty }}</dd></dl>
        <label class="tg-rb-rescue" data-rb-rescue-wrap hidden><input type="checkbox" data-rb-rescue><span><strong>{{ st.rescue_label }}</strong> <em>+€{{ st.rescue_price | default: 5 }}/{{ st.unit_day | default: d_day }}</em><small>{{ st.rescue_text }}</small></span></label>
        <div class="tg-rb-total"><span>{{ st.total_label }}</span><strong data-rb-total>—</strong></div>
        <p class="tg-rb-note" data-rb-deposit-normal>{{ st.deposit }}</p>
        <p class="tg-rb-note tg-rb-note--warn" data-rb-deposit-ebike hidden>{{ st.deposit_ebike }}</p>
        <form class="tg-rb-form" data-rb-form novalidate>
          <label><span>{{ st.name_label }}</span><input type="text" name="name" required autocomplete="name"></label>
          <label><span>{{ st.phone_label }}</span><input type="tel" name="phone" required autocomplete="tel"></label>
          <label><span>{{ st.email_label }}</span><input type="email" name="email" autocomplete="email"></label>
          <label><span>{{ st.note_label }}</span><textarea name="note" rows="2"></textarea></label>
          <button type="submit" class="tg-btn-primary tg-rb-submit" data-rb-submit>{{ st.submit_label }}</button>
          <p class="tg-rb-status" data-rb-status aria-live="polite"></p>
        </form>
        {%- comment -%} Fallback when the booking worker is unreachable: send the request by e-mail via Shopify's contact form {%- endcomment -%}
        {%- form 'contact', id: 'tg-rb-fallback', class: 'tg-rb-fallback' -%}
          <input type="hidden" name="contact[type]" value="Резервация наем">
          <input type="hidden" name="contact[name]" data-fb-name>
          <input type="hidden" name="contact[phone]" data-fb-phone>
          <input type="hidden" name="contact[email]" data-fb-email>
          <input type="hidden" name="contact[body]" data-fb-body>
          {% if form.posted_successfully? %}<p class="tg-rb-status is-ok">{{ st.msg_success | remove: 'Резервация' | remove: '.' | strip }} — {{ 'tg.rental_booking.by_email' | t }}</p>{% endif %}
          {% if form.errors %}<p class="tg-rb-status">{{ form.errors | default_errors }}</p>{% endif %}
        {%- endform -%}
      </aside>
    </div>
  </div>

  {% if st.show_prices %}
  {%- assign pt_n = st.long_tiers | newline_to_br | split: '<br />' -%}
  {%- assign pt_e = st.long_tiers_ebike | newline_to_br | split: '<br />' -%}
  <div class="tg-rb-inner tg-rb-prices" id="tg-rb-prices">
    <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.prices_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.prices_title }}</h2></header>
    <div class="tg-rb-prices-grid">
      <div class="tg-rb-price-card">
        <h3>{{ st.prices_normal_title }}</h3><p>{{ st.prices_normal_sub }}</p>
        <dl>
          <div><dt>{{ st.prices_24h_label }}</dt><dd>€{{ st.h24_rate | default: 20 }}</dd></div>
          {% for row in pt_n %}{%- assign r = row | strip | split: '|' -%}{% if r.size == 2 and r[0] != '1' %}<div><dt>{% if forloop.last %}{{ r[0] }}+ {{ st.unit_days | default: d_days }}{% else %}{{ r[0] }}{% assign nxt = forloop.index0 | plus: 1 %}{% assign nr = pt_n[nxt] | strip | split: '|' %}{% assign upto = nr[0] | plus: 0 | minus: 1 %}{% assign from_n = r[0] | plus: 0 %}{% if upto > from_n %}–{{ upto }}{% endif %} {{ st.unit_days | default: d_days }}{% endif %}</dt><dd>€{{ r[1] }}<small>/{{ st.unit_day | default: d_day }}</small></dd></div>{% endif %}{% endfor %}
        </dl>
        <p class="tg-rb-note">{{ st.deposit }}</p>
      </div>
      <div class="tg-rb-price-card tg-rb-price-card--e">
        <h3>{{ st.prices_ebike_title }}</h3><p>{{ st.prices_ebike_sub }}</p>
        <dl>
          {% for row in pt_e %}{%- assign r = row | strip | split: '|' -%}{% if r.size == 2 %}<div><dt>{% if r[0] == '1' %}{{ st.prices_1d_label }}{% elsif forloop.last %}{{ r[0] }}+ {{ st.unit_days | default: d_days }}{% else %}{{ r[0] }}{% assign nxt = forloop.index0 | plus: 1 %}{% assign nr = pt_e[nxt] | strip | split: '|' %}{% assign upto = nr[0] | plus: 0 | minus: 1 %}{% assign from_n = r[0] | plus: 0 %}{% if upto > from_n %}–{{ upto }}{% endif %} {{ st.unit_days | default: d_days }}{% endif %}</dt><dd>€{{ r[1] }}<small>/{{ st.unit_day | default: d_day }}</small></dd></div>{% endif %}{% endfor %}
        </dl>
        <p class="tg-rb-note tg-rb-note--warn">{{ st.deposit_ebike }}</p>
      </div>
      <div class="tg-rb-price-card tg-rb-price-card--extra">
        <h3>{{ st.rescue_label }} <em>+€{{ st.rescue_price | default: 5 }}/{{ st.unit_day | default: d_day }}</em></h3><p>{{ st.rescue_text }}</p>
        <p class="tg-rb-note">{{ st.prices_hourly_note | replace: '[h]', st.hourly_rate | replace: '[day]', st.day_rate }}</p>
      </div>
    </div>
  </div>
  {% endif %}
</section>

<script src="{{ '2gether-rental-booking.js' | asset_url }}" defer></script>
<script>window.tgRbI18n = {{ st | json }};
window.tgI18n = window.tgI18n || {}; window.tgI18n.rentalBooking = { weekdays: {{ 'tg.common.weekdays_short' | t | split: ',' | json }}, months: {{ 'tg.rental_booking.months' | t | split: ',' | json }}, unit_hours: {{ 'tg.common.hours_short' | t | json }}, unit_day: {{ d_day | json }}, unit_days: {{ d_days | json }} };</script>

