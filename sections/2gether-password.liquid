{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&f[]=boska@400,500,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<section class="tg-pw tg-section">
  <div class="tg-pw-diagonal" aria-hidden="true"></div>
  <div class="tg-pw-inner">
    <div class="tg-pw-brand">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 320 | image_tag: class: 'tg-pw-logo', loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span class="tg-pw-wordmark">2GETHER<span>BIKES</span></span>
      {%- endif -%}
    </div>

    <span class="tg-label">{{ section.settings.eyebrow | default: 'Велосипеден магазин · Варна' }}</span>
    <h1 class="tg-pw-title">
      {{- section.settings.title | default: 'ОТВАРЯМЕ <strong>СКОРО</strong>' | remove: '<p>' | remove: '</p>' -}}
    </h1>
    <p class="tg-pw-editorial">{{ section.settings.tagline | default: 'Нещо ново се задава по пътеката.' }}</p>
    <p class="tg-pw-text">{{ section.settings.text | default: 'Работим по новия ни онлайн магазин. Междувременно ни намерете в магазина във Варна или в социалните мрежи.' }}</p>

    {%- if shop.password_message != blank -%}
      <p class="tg-pw-text tg-pw-shop-message">{{ shop.password_message }}</p>
    {%- endif -%}

    <div class="tg-pw-socials">
      {%- if section.settings.instagram_url != blank -%}
        <a class="tg-pw-social" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.8" cy="6.2" r="1.2" fill="currentColor" stroke="none"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.youtube_url != blank -%}
        <a class="tg-pw-social" href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.9 31.9 0 0 0 0 12a31.9 31.9 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8Z"/><path d="m9.6 15.6 6.3-3.6-6.3-3.6v7.2Z" fill="#0B1220"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.facebook_url != blank -%}
        <a class="tg-pw-social" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.3-.04-1.3-.13-2.5-.13-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.7v8h3.5Z"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="tg-pw-form-wrap">
      <span class="tg-pw-form-label">{{ section.settings.password_label | default: 'Имаш парола?' }}</span>
      {%- form 'storefront_password', class: 'tg-pw-form' -%}
        <label class="visually-hidden" for="tg-pw-input">{{ section.settings.password_placeholder | default: 'Парола' }}</label>
        <input
          id="tg-pw-input"
          class="tg-pw-input"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="{{ section.settings.password_placeholder | default: 'Парола' }}"
          {% if form.errors %}aria-invalid="true" aria-describedby="tg-pw-error"{% endif %}
        >
        <button type="submit" class="tg-pw-submit">{{ section.settings.password_button | default: 'Влез' }} &rarr;</button>
        {%- if form.errors -%}
          <p id="tg-pw-error" class="tg-pw-error">{{ section.settings.password_error | default: 'Грешна парола — опитайте отново.' }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* The stock password footer + dialog stay in the layout — this page
     brings its own form, so hide the leftovers. */
  .password-main-content + footer { display: none; }

  .tg-pw {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--tg-ink, #0B1220);
    color: var(--tg-text-primary, #E8ECF2);
    font-family: var(--tg-font-body);
    padding: var(--tg-s8, 64px) var(--tg-s6, 32px);
  }

  .tg-pw-diagonal {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 30% 0, 18% 100%, 0 100%);
    background: var(--tg-surface, #0D1526);
    pointer-events: none;
  }

  .tg-pw-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--tg-s4, 16px);
    max-width: 620px;
  }

  .tg-pw-brand { margin-bottom: var(--tg-s2, 8px); }

  .tg-pw-logo { max-height: 56px; width: auto; display: block; }

  .tg-pw-wordmark {
    font-family: var(--tg-font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: 0.02em;
  }

  .tg-pw-wordmark span { color: var(--tg-flame, #E8601C); }

  .tg-pw-title {
    font-family: var(--tg-font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 5rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
    margin: 0;
  }

  .tg-pw-title strong { color: var(--tg-flame, #E8601C); }

  .tg-pw-editorial {
    font-family: var(--tg-font-accent);
    font-style: italic;
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    line-height: 1.4;
    color: var(--tg-text-secondary, #8A9BB5);
    margin: 0;
  }

  .tg-pw-text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--tg-text-muted, #566A85);
    margin: 0;
    max-width: 460px;
  }

  .tg-pw-shop-message { color: var(--tg-text-secondary, #8A9BB5); }

  .tg-pw-socials {
    display: flex;
    gap: var(--tg-s3, 12px);
    margin-top: var(--tg-s2, 8px);
  }

  .tg-pw-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--tg-text-secondary, #8A9BB5);
    background: var(--tg-surface-raised, #121E34);
    border: 1px solid var(--tg-divider, rgba(138, 155, 181, 0.12));
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .tg-pw-social:hover { color: var(--tg-flame, #E8601C); border-color: var(--tg-flame, #E8601C); }

  .tg-pw-form-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--tg-s3, 12px);
    margin-top: var(--tg-s5, 24px);
    padding-top: var(--tg-s5, 24px);
    border-top: 1px solid var(--tg-divider, rgba(138, 155, 181, 0.12));
    width: 100%;
  }

  .tg-pw-form-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tg-text-muted, #566A85);
  }

  .tg-pw-form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--tg-s2, 8px);
  }

  .tg-pw-input {
    background: var(--tg-surface-raised, #121E34);
    border: 1px solid var(--tg-divider, rgba(138, 155, 181, 0.12));
    color: var(--tg-text-primary, #E8ECF2);
    font-family: var(--tg-font-body);
    font-size: 14px;
    padding: 13px 16px;
    width: 220px;
    outline: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    transition: border-color 150ms ease;
  }

  .tg-pw-input:focus { border-color: var(--tg-flame, #E8601C); }
  .tg-pw-input::placeholder { color: var(--tg-text-muted, #566A85); }

  .tg-pw-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px 13px 20px;
    background: var(--tg-flame, #E8601C);
    color: var(--tg-ink, #0B1220);
    font-family: var(--tg-font-body);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
    transition: background 150ms ease;
  }

  .tg-pw-submit:hover { background: var(--tg-flame-light, #F47B3E); }

  .tg-pw-error {
    width: 100%;
    margin: 4px 0 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--tg-flame, #E8601C);
  }

  @media (max-width: 640px) {
    .tg-pw { padding: var(--tg-s6, 32px) var(--tg-s4, 16px); }
    .tg-pw-form { width: 100%; }
    .tg-pw-input { flex: 1; min-width: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "2Gether Парола",
  "tag": "section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Лого (празно = надпис 2GETHERBIKES)" },
    { "type": "text", "id": "eyebrow", "label": "Етикет", "default": "Велосипеден магазин · Варна" },
    { "type": "richtext", "id": "title", "label": "Заглавие", "default": "<p>ОТВАРЯМЕ <strong>СКОРО</strong></p>" },
    { "type": "text", "id": "tagline", "label": "Подзаглавие (курсив)", "default": "Нещо ново се задава по пътеката." },
    { "type": "textarea", "id": "text", "label": "Текст", "default": "Работим по новия ни онлайн магазин. Междувременно ни намерете в магазина във Варна или в социалните мрежи." },
    { "type": "header", "content": "Социални мрежи" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "header", "content": "Форма за парола" },
    { "type": "text", "id": "password_label", "label": "Надпис над формата", "default": "Имаш парола?" },
    { "type": "text", "id": "password_placeholder", "label": "Placeholder", "default": "Парола" },
    { "type": "text", "id": "password_button", "label": "Бутон", "default": "Влез" },
    { "type": "text", "id": "password_error", "label": "Съобщение при грешка", "default": "Грешна парола — опитайте отново." }
  ]
}
{% endschema %}
