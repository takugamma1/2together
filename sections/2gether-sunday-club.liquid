{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-sunday-club.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&f[]=boska@400,500,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}
<script type="module" src="{{ '2gether-club.js' | asset_url }}" defer></script>

<script>document.body.classList.add('tg-sc-active');</script>

{%- capture tg_member_flag -%}{%- render '2gether-member' -%}{%- endcapture -%}
{%- liquid
  assign tg_is_member = false
  if tg_member_flag contains 'true'
    assign tg_is_member = true
  endif

  assign benefit_count = 0
  assign photo_count = 0
  for block in section.blocks
    case block.type
      when 'benefit'
        assign benefit_count = benefit_count | plus: 1
      when 'photo'
        assign photo_count = photo_count | plus: 1
    endcase
  endfor

  assign today = 'now' | date: '%Y-%m-%d'
  assign rides = metaobjects['sunday_ride'].values
  assign ride_count = rides | size

  comment
    Liquid sort by date: build "YYYY-MM-DD::handle" keys, string-sort them
    (ISO dates sort chronologically), then look each ride up by handle.
    Avoids sort-filter errors on metaobject field drops. A client-side
    re-sort below covers anything this misses (and CDN-cached HTML).
  endcomment
  assign ride_keys = ''
  for ride in rides
    assign ride_key = ride.date.value | date: '%Y-%m-%d' | append: '::' | append: ride.system.handle
    assign ride_keys = ride_keys | append: ride_key
    unless forloop.last
      assign ride_keys = ride_keys | append: ','
    endunless
  endfor
  assign sorted_ride_keys = ride_keys | split: ',' | sort

  assign tg_months = 'ЯНУ,ФЕВ,МАР,АПР,МАЙ,ЮНИ,ЮЛИ,АВГ,СЕП,ОКТ,НОЕ,ДЕК' | split: ','
  assign tg_weekdays = 'НЕД,ПОН,ВТО,СРЯ,ЧЕТ,ПЕТ,СЪБ' | split: ','
-%}

<section
  class="tg-sc tg-sc-page"
  data-club-section
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-msg-full="{{ section.settings.msg_full | escape }}"
  data-msg-error="{{ section.settings.msg_error | escape }}"
  data-msg-login="{{ section.settings.msg_login | escape }}"
  data-msg-members="{{ section.settings.msg_members | escape }}"
>

  <!-- ═══ HERO ═══ -->
  <div class="tg-sc-hero">
    <div class="tg-sc-hero-media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', class: 'tg-sc-hero-img' }}
      {% else %}
        <div class="tg-sc-hero-placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="tg-sc-hero-grain" aria-hidden="true"></div>
      <div class="tg-sc-hero-veil"></div>
    </div>

    <div class="tg-sc-hero-inner">
      <div class="tg-sc-hero-stack">
        <span class="tg-sc-since">{{ section.settings.since }}</span>
        <h1 class="tg-sc-hero-title">
          {{ section.settings.hero_title }}<br>
          <em>{{ section.settings.hero_title_em }}</em>
        </h1>
        <p class="tg-sc-hero-sub">{{ section.settings.hero_sub }}</p>

        <div class="tg-sc-hero-actions">
          <a href="#tg-sc-join" class="tg-sc-hero-cta">
            {{ section.settings.hero_cta }}
            <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
          </a>
          <a href="#tg-sc-events" class="tg-sc-hero-secondary">
            {{ section.settings.hero_secondary }}
          </a>
        </div>
      </div>

      <div class="tg-sc-hero-meta">
        <div class="tg-sc-meta-item">
          <strong>{{ section.settings.meta_1_value }}</strong>
          <span>{{ section.settings.meta_1_label }}</span>
        </div>
        <div class="tg-sc-meta-item">
          <strong>{{ section.settings.meta_2_value }}</strong>
          <span>{{ section.settings.meta_2_label }}</span>
        </div>
        <div class="tg-sc-meta-item">
          <strong>{{ section.settings.meta_3_value }}</strong>
          <span>{{ section.settings.meta_3_label }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ RIDES (sunday_ride metaobjects) ═══ -->
  <div id="tg-sc-events" class="tg-sc-events">
    <header class="tg-sc-section-head">
      <span class="tg-eyebrow">{{ section.settings.events_eyebrow }}</span>
      <h2 class="tg-sc-section-title">{{ section.settings.events_title }}</h2>
      {% if section.settings.events_intro != blank %}
        <p class="tg-sc-section-intro">{{ section.settings.events_intro }}</p>
      {% endif %}
    </header>

    {% if ride_count > 0 %}
      <div class="tg-sc-events-list" data-tg-sc-events>
        {% for key in sorted_ride_keys %}
          {%- assign target_handle = key | split: '::' | last -%}
          {% for ride in rides %}
            {% if ride.system.handle == target_handle %}
              {%- liquid
                assign ride_date = ride.date.value | date: '%Y-%m-%d'
                assign is_past = false
                if ride_date != blank and ride_date < today
                  assign is_past = true
                endif
                assign ride_capacity = ride.capacity.value | default: 0
                assign ride_going = ride.going_count.value | default: 0
                assign ride_diff = ride.difficulty.value | default: 'medium'
                case ride_diff
                  when 'easy'
                    assign diff_label = section.settings.diff_easy
                  when 'hard'
                    assign diff_label = section.settings.diff_hard
                  else
                    assign diff_label = section.settings.diff_medium
                endcase
                assign month_idx = ride.date.value | date: '%m' | times: 1 | minus: 1
                assign weekday_idx = ride.date.value | date: '%w' | times: 1
              -%}
              <article
                class="tg-sc-event{% if is_past %} is-past{% endif %}"
                data-ride-id="{{ ride.system.id }}"
                data-ride-date="{{ ride_date }}"
                data-capacity="{{ ride_capacity }}"
              >
                <!-- Date stamp -->
                <div class="tg-sc-event-date" aria-hidden="true">
                  {% if ride_date != blank %}
                    <span class="tg-sc-event-month">{{ tg_months[month_idx] }}</span>
                    <strong class="tg-sc-event-day">{{ ride.date.value | date: '%d' }}</strong>
                    <span class="tg-sc-event-weekday">{{ tg_weekdays[weekday_idx] }}</span>
                  {% else %}
                    <strong class="tg-sc-event-day">—</strong>
                  {% endif %}
                </div>

                <!-- Body -->
                <div class="tg-sc-event-body">
                  <div class="tg-sc-event-meta">
                    <span class="tg-sc-event-level tg-sc-level--{{ ride_diff }}">{{ diff_label }}</span>
                    {% if ride.distance.value != blank %}
                      <span class="tg-sc-event-distance">{{ ride.distance.value }}</span>
                    {% endif %}
                    {% if ride.start_time.value != blank %}
                      <span class="tg-sc-event-time">{{ section.settings.start_label }} {{ ride.start_time.value }}</span>
                    {% endif %}
                  </div>
                  <h3 class="tg-sc-event-title">{{ ride.title.value }}</h3>
                  {% if ride.location.value != blank %}
                    <p class="tg-sc-event-loc">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 7 8 12 8 12s8-5 8-12a8 8 0 0 0-8-8z"/></svg>
                      <span>{{ ride.location.value }}</span>
                    </p>
                  {% endif %}

                  {% if is_past %}
                    <div class="tg-sc-past">
                      <span class="tg-sc-past-label">{{ section.settings.past_label }}</span>
                    </div>
                  {% else %}
                    <!-- RSVP — buttons start disabled; 2gether-club.js hydrates + enables -->
                    <div class="tg-sc-rsvp" data-rsvp>
                      <button type="button" class="tg-sc-rsvp-btn" data-status="going" aria-pressed="false" disabled>{{ section.settings.rsvp_going_label }}</button>
                      <button type="button" class="tg-sc-rsvp-btn" data-status="not_going" aria-pressed="false" disabled>{{ section.settings.rsvp_not_going_label }}</button>
                      <span class="tg-sc-count-wrap">
                        <span class="tg-sc-count" data-count>{{ ride.going_count.value | default: 0 }}</span>
                        {{ section.settings.count_label }}
                        {%- if ride_capacity > 0 %}
                          <span class="tg-sc-capacity">{{ section.settings.capacity_label | replace: '[N]', ride_capacity }}</span>
                        {%- endif %}
                      </span>
                      {% unless customer %}
                        <a class="tg-sc-login" data-login-cta href="{{ routes.account_login_url }}">{{ section.settings.login_cta_label }}</a>
                      {% endunless %}
                    </div>
                  {% endif %}
                </div>

                <!-- Aside: more info + optional route link -->
                <div class="tg-sc-event-aside">
                  <button type="button" class="tg-sc-more" data-dialog-open="tg-sc-dialog-{{ ride.system.handle }}">
                    {{ section.settings.more_label }}
                    <svg width="12" height="9" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
                  </button>
                  {% if ride.route_link.value != blank %}
                    <a href="{{ ride.route_link.value }}" class="tg-sc-event-route" target="_blank" rel="noopener">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 7 8 12 8 12s8-5 8-12a8 8 0 0 0-8-8z"/></svg>
                      <span>{{ section.settings.route_label }}</span>
                    </a>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>

      <!-- Per-ride detail dialogs (native <dialog>, Esc closes natively) -->
      {% for ride in rides %}
        {%- liquid
          assign ride_capacity = ride.capacity.value | default: 0
          assign ride_going = ride.going_count.value | default: 0
          assign ride_diff = ride.difficulty.value | default: 'medium'
          case ride_diff
            when 'easy'
              assign diff_label = section.settings.diff_easy
            when 'hard'
              assign diff_label = section.settings.diff_hard
            else
              assign diff_label = section.settings.diff_medium
          endcase
        -%}
        <dialog
          class="tg-sc-dialog"
          id="tg-sc-dialog-{{ ride.system.handle }}"
          aria-labelledby="tg-sc-dialog-title-{{ ride.system.handle }}"
        >
          <button
            type="button"
            class="tg-sc-dialog-close"
            data-dialog-close
            aria-label="{{ section.settings.dialog_close_label | escape }}"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>

          <div class="tg-sc-dialog-media{% unless ride.photo.value %} tg-sc-dialog-media--empty{% endunless %}">
            {% if ride.photo.value %}
              {{ ride.photo.value | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 640px', class: 'tg-sc-dialog-img', alt: ride.title.value }}
            {% endif %}
          </div>

          <div class="tg-sc-dialog-body">
            <div class="tg-sc-event-meta">
              <span class="tg-sc-event-level tg-sc-level--{{ ride_diff }}">{{ diff_label }}</span>
              {% if ride.distance.value != blank %}
                <span class="tg-sc-event-distance">{{ ride.distance.value }}</span>
              {% endif %}
              {% if ride.date.value != blank %}
                <span class="tg-sc-event-time">{{ ride.date.value | date: '%d.%m.%Y' }}</span>
              {% endif %}
            </div>

            <h3 class="tg-sc-dialog-title" id="tg-sc-dialog-title-{{ ride.system.handle }}">{{ ride.title.value }}</h3>

            {% if ride.description.value != blank %}
              <p class="tg-sc-dialog-desc">{{ ride.description.value | newline_to_br }}</p>
            {% endif %}

            <dl class="tg-sc-dialog-facts">
              {% if ride.location.value != blank %}
                <div>
                  <dt>{{ section.settings.dialog_location_label }}</dt>
                  <dd>
                    {{ ride.location.value }}
                    {% if ride.location_url.value != blank %}
                      <a class="tg-sc-map-link" href="{{ ride.location_url.value }}" target="_blank" rel="noopener">{{ section.settings.dialog_map_label }} ↗</a>
                    {% endif %}
                  </dd>
                </div>
              {% endif %}
              {% if ride.distance.value != blank %}
                <div>
                  <dt>{{ section.settings.dialog_distance_label }}</dt>
                  <dd>{{ ride.distance.value }}</dd>
                </div>
              {% endif %}
              {% if ride.start_time.value != blank %}
                <div>
                  <dt>{{ section.settings.dialog_start_label }}</dt>
                  <dd>{{ ride.start_time.value }}</dd>
                </div>
              {% endif %}
              <div>
                <dt>{{ section.settings.dialog_count_label }}</dt>
                <dd>
                  {{ ride_going }} {{ section.settings.count_label }}
                  {%- if ride_capacity > 0 %}
                    {{ section.settings.capacity_label | replace: '[N]', ride_capacity }}
                  {%- endif %}
                </dd>
              </div>
            </dl>
          </div>
        </dialog>
      {% endfor %}
    {% else %}
      <div class="tg-sc-events-empty">
        <p>{{ section.settings.events_empty }}</p>
      </div>
    {% endif %}
  </div>

  <!-- ═══ BENEFITS ═══ -->
  {% if benefit_count > 0 %}
    <div class="tg-sc-benefits">
      <header class="tg-sc-section-head">
        <span class="tg-eyebrow">{{ section.settings.benefits_eyebrow }}</span>
        <h2 class="tg-sc-section-title">{{ section.settings.benefits_title }}</h2>
      </header>

      <div class="tg-sc-benefits-grid">
        {% assign benefit_i = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            {% assign benefit_i = benefit_i | plus: 1 %}
            <article class="tg-sc-benefit" {{ block.shopify_attributes }}>
              <span class="tg-sc-benefit-num">{{ benefit_i | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="tg-sc-benefit-title">{{ block.settings.title }}</h3>
              {% if block.settings.text != blank %}
                <p class="tg-sc-benefit-text">{{ block.settings.text }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- ═══ PHOTO STRIP ═══ -->
  {% if photo_count > 0 %}
    <div class="tg-sc-photos">
      <header class="tg-sc-section-head">
        <span class="tg-eyebrow">{{ section.settings.photos_eyebrow }}</span>
        <h2 class="tg-sc-section-title">{{ section.settings.photos_title }}</h2>
      </header>

      <div class="tg-sc-photos-strip" data-tg-sc-strip>
        {% for block in section.blocks %}
          {% if block.type == 'photo' %}
            <figure class="tg-sc-photo" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 80vw, 30vw', alt: block.settings.caption | default: 'Sunday ride' }}
              {% else %}
                <div class="tg-sc-photo-placeholder" aria-hidden="true"></div>
              {% endif %}
              {% if block.settings.caption != blank %}
                <figcaption>{{ block.settings.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- ═══ JOIN ═══ -->
  <div class="tg-sc-join">
    <div class="tg-sc-join-grid">
      <aside class="tg-sc-join-aside">
        <span class="tg-eyebrow">{{ section.settings.join_eyebrow }}</span>
        <h2 class="tg-sc-join-title">{{ section.settings.join_title }}</h2>
        <p class="tg-sc-join-text">{{ section.settings.join_text }}</p>

        <ul class="tg-sc-join-bullets">
          <li><span>01</span><span>{{ section.settings.bullet_1 }}</span></li>
          <li><span>02</span><span>{{ section.settings.bullet_2 }}</span></li>
          <li><span>03</span><span>{{ section.settings.bullet_3 }}</span></li>
          <li><span>04</span><span>{{ section.settings.bullet_4 }}</span></li>
        </ul>
      </aside>

      <div class="tg-sc-join-form-wrap" id="tg-sc-join">
        {% if tg_is_member %}
          <!-- Member card replaces the form -->
          <div class="tg-sc-member-card">
            <h3 class="tg-sc-member-title">{{ section.settings.member_title }}</h3>
            <p class="tg-sc-member-text">{{ section.settings.member_text }}</p>
          </div>
        {% else %}
          {% unless customer %}
            <div class="tg-sc-login-hint">
              <p>
                {{ section.settings.login_hint }} —
                <a href="{{ routes.account_login_url }}">{{ section.settings.login_hint_link }}</a>
              </p>
            </div>
          {% endunless %}

          {%- form 'contact', id: 'tg-sc-form', class: 'tg-sc-form' -%}
            <input type="hidden" name="contact[type]" value="Заявка за членство в Sunday Club">

            {% if form.posted_successfully? %}
              <div class="tg-sc-form-ok">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                {{ section.settings.form_success }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="tg-sc-form-error">{{ form.errors | default_errors }}</div>
            {% endif %}

            <div class="tg-sc-form-grid">
              <label class="tg-sc-field">
                <span class="tg-sc-field-label">{{ section.settings.label_name }}</span>
                <input type="text" name="contact[name]" {% if customer %}value="{{ customer.name | escape }}"{% endif %} required>
              </label>
              <label class="tg-sc-field">
                <span class="tg-sc-field-label">{{ section.settings.label_phone }}</span>
                <input type="tel" name="contact[phone]" required>
              </label>
              <label class="tg-sc-field tg-sc-field--full">
                <span class="tg-sc-field-label">{{ section.settings.label_email }}</span>
                <input type="email" name="contact[email]" {% if customer %}value="{{ customer.email | escape }}"{% endif %} required>
              </label>
              <label class="tg-sc-field">
                <span class="tg-sc-field-label">{{ section.settings.label_level }}</span>
                <select name="contact[ниво]" required>
                  <option value="" disabled selected>{{ section.settings.level_placeholder }}</option>
                  <option value="{{ section.settings.level_1 | escape }}">{{ section.settings.level_1 }}</option>
                  <option value="{{ section.settings.level_2 | escape }}">{{ section.settings.level_2 }}</option>
                  <option value="{{ section.settings.level_3 | escape }}">{{ section.settings.level_3 }}</option>
                  <option value="{{ section.settings.level_4 | escape }}">{{ section.settings.level_4 }}</option>
                </select>
              </label>
              <label class="tg-sc-field">
                <span class="tg-sc-field-label">{{ section.settings.label_bike }}</span>
                <input type="text" name="contact[велосипед]" placeholder="{{ section.settings.bike_placeholder | escape }}" required>
              </label>
              <label class="tg-sc-field tg-sc-field--full">
                <span class="tg-sc-field-label">{{ section.settings.label_strava }}</span>
                <input type="text" name="contact[Strava профил]" placeholder="{{ section.settings.strava_placeholder | escape }}">
              </label>
              <label class="tg-sc-field tg-sc-field--full">
                <span class="tg-sc-field-label">{{ section.settings.label_notes }}</span>
                <textarea name="contact[бележки]" rows="3" placeholder="{{ section.settings.notes_placeholder | escape }}"></textarea>
              </label>

              <label class="tg-sc-checkbox tg-sc-field--full">
                <input type="checkbox" name="contact[съгласие]" required>
                <span class="tg-sc-checkbox-box"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                <span class="tg-sc-checkbox-text">{{ section.settings.consent_label }}</span>
              </label>
            </div>

            <button type="submit" class="tg-sc-form-submit">
              {{ section.settings.form_submit }}
              <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
            </button>

            <p class="tg-sc-form-note">{{ section.settings.form_note }}</p>
          {%- endform -%}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- ═══ CLOSER (quote) ═══ -->
  {% if section.settings.quote != blank %}
    <div class="tg-sc-quote">
      <blockquote class="tg-sc-quote-text">
        <span class="tg-sc-quote-mark" aria-hidden="true">"</span>
        {{ section.settings.quote }}
      </blockquote>
      {% if section.settings.quote_author != blank %}
        <cite class="tg-sc-quote-cite">
          <span>{{ section.settings.quote_author }}</span>
          {% if section.settings.quote_role != blank %}
            <small>{{ section.settings.quote_role }}</small>
          {% endif %}
        </cite>
      {% endif %}
    </div>
  {% endif %}
</section>

<script>
  // Self-contained UI glue: client-side re-sort of ride cards + past re-check
  // (covers unsortable metaobject drops and CDN-cached HTML), plus native
  // <dialog> open/close wiring. RSVP/network logic lives in 2gether-club.js.
  (function () {
    var list = document.querySelector('[data-tg-sc-events]');
    if (list) {
      var cards = Array.prototype.slice.call(list.querySelectorAll('.tg-sc-event[data-ride-date]'));

      // Sort by data-ride-date ascending (ISO strings sort chronologically).
      if (cards.length > 1) {
        cards
          .slice()
          .sort(function (a, b) {
            var da = a.getAttribute('data-ride-date') || '';
            var db = b.getAttribute('data-ride-date') || '';
            if (da < db) return -1;
            if (da > db) return 1;
            return 0;
          })
          .forEach(function (card) { list.appendChild(card); });
      }

      // Re-apply is-past based on the visitor's clock.
      var now = new Date();
      var todayIso = now.getFullYear() + '-' + ('0' + (now.getMonth() + 1)).slice(-2) + '-' + ('0' + now.getDate()).slice(-2);
      cards.forEach(function (card) {
        var d = card.getAttribute('data-ride-date');
        if (d && d < todayIso) card.classList.add('is-past');
      });
    }

    // Dialog open/close (Esc handled natively by <dialog>).
    document.addEventListener('click', function (e) {
      if (!(e.target instanceof Element)) return;

      var opener = e.target.closest('[data-dialog-open]');
      if (opener) {
        var dlg = document.getElementById(opener.getAttribute('data-dialog-open'));
        if (dlg) {
          if (typeof dlg.showModal === 'function') dlg.showModal();
          else dlg.setAttribute('open', '');
        }
        return;
      }

      var closer = e.target.closest('[data-dialog-close]');
      if (closer) {
        var openDlg = closer.closest('dialog');
        if (openDlg) {
          if (typeof openDlg.close === 'function') openDlg.close();
          else openDlg.removeAttribute('open');
        }
        return;
      }

      // Click on the backdrop (outside the dialog box) closes it.
      if (e.target.matches('dialog.tg-sc-dialog[open]')) {
        var rect = e.target.getBoundingClientRect();
        var inside = e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom;
        if (!inside && typeof e.target.close === 'function') e.target.close();
      }
    });
  })();
</script>

{% schema %}
{
