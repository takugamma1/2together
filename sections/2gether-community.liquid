<section
  class="tg-community tg-section"
  id="community"
  data-club-section
  data-msg-error="{{ section.settings.msg_error | escape }}"
  data-msg-login="{{ section.settings.msg_login | escape }}"
  data-msg-members="{{ section.settings.msg_members | escape }}"
>
  <div class="tg-community-image">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 1920 | image_tag: loading: 'lazy', sizes: '100vw' }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {% endif %}
  </div>
  <div class="tg-community-overlay"></div>
  <div class="tg-community-diagonal"></div>
  <div class="tg-community-content">
    <div class="tg-community-top">
      <div class="tg-community-top-left"></div>
      <div class="tg-community-top-right">
        <span class="tg-label">{{ section.settings.label_text }}</span>
        <h2 class="tg-f-display tg-community-title">{{ section.settings.title }}</h2>
        <p class="tg-community-text">{{ section.settings.description }}</p>
        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_link }}" class="tg-btn-primary" style="align-self:flex-start;">{{ section.settings.cta_text }} &rarr;</a>
        {% endif %}
      </div>
    </div>

    {%- assign poll = section.settings.poll -%}
    {% if poll != blank %}
      {% comment %}
        '2gether-member' determines membership for the current customer
        and echoes the boolean (render isolates assigns, so we capture).
      {% endcomment %}
      {%- capture tg_member_flag -%}{%- render '2gether-member' -%}{%- endcapture -%}
      {%- liquid
        assign tg_poll_closed = false
        if poll.status.value == 'closed'
          assign tg_poll_closed = true
        endif

        assign tg_can_vote = false
        if tg_member_flag contains 'true' and tg_poll_closed == false
          assign tg_can_vote = true
        endif

        assign tg_total_votes = 0
        assign tg_max_votes = 0
        for tg_opt in poll.options.value
          assign tg_opt_votes = tg_opt.vote_count.value | default: 0
          assign tg_total_votes = tg_total_votes | plus: tg_opt_votes
          if tg_opt_votes > tg_max_votes
            assign tg_max_votes = tg_opt_votes
          endif
        endfor
      -%}
      <div class="tg-community-pool">
        <div class="tg-community-pool-left"></div>
        <div class="tg-community-pool-right">
          <div class="tg-pool-header">
            <span class="tg-label">{{ section.settings.poll_label }}</span>
          </div>
          {% if poll.question.value != blank %}
            <p class="tg-pool-question" style="margin:0;font-family:'Technor',sans-serif;font-weight:600;font-size:16px;color:var(--tg-text-primary);">{{ poll.question.value }}</p>
          {% endif %}
          <div style="display:flex;align-items:center;gap:var(--tg-s3);">
            <div class="tg-pool-avatars">
              {% for block in section.blocks %}
                {% if block.type == 'avatar' %}
                  <div class="tg-pool-avatar" {{ block.shopify_attributes }}>{{ block.settings.initials }}</div>
                {% endif %}
              {% endfor %}
            </div>
            <span class="tg-pool-count">{{ tg_total_votes }} {{ section.settings.voters_text }}</span>
          </div>
          <div
            class="tg-pool-options"
            data-poll-id="{{ poll.system.id }}"
            data-can-vote="{% if tg_can_vote %}true{% else %}false{% endif %}"
          >
            {% for tg_opt in poll.options.value %}
              {%- liquid
                assign tg_opt_votes = tg_opt.vote_count.value | default: 0
                if tg_total_votes > 0
                  assign tg_opt_pct = tg_opt_votes | times: 100.0 | divided_by: tg_total_votes | round
                else
                  assign tg_opt_pct = 0
                endif
              -%}
              <div
                class="tg-pool-option{% if tg_max_votes > 0 and tg_opt_votes == tg_max_votes %} leading{% endif %}"
                data-option-id="{{ tg_opt.system.id }}"
              >
                <div class="tg-pool-bar" style="width:{{ tg_opt_pct }}%;"></div>
                <div class="tg-pool-check"><div class="tg-pool-check-dot"></div></div>
                <span class="tg-pool-destination">{{ tg_opt.label.value }}</span>
                <span class="tg-pool-votes"><span data-votes>{{ tg_opt_votes }}</span> {{ section.settings.votes_text }}</span>
              </div>
            {% endfor %}
          </div>
          {% if tg_poll_closed %}
            <span class="tg-pool-closed" style="align-self:flex-start;font-size:12px;font-weight:600;color:var(--tg-text-secondary);">{{ section.settings.closed_text }}</span>
          {% elsif tg_can_vote == false %}
            <a
              class="tg-pool-join"
              href="{{ section.settings.member_cta_url | default: '/pages/sunday-club#tg-sc-join' }}"
              style="align-self:flex-start;font-size:12px;font-weight:600;color:var(--tg-flame);text-decoration:none;border-bottom:1px solid var(--tg-flame);padding-bottom:2px;"
            >{{ section.settings.member_cta_text }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if section.settings.youtube_url != blank %}
    <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" class="tg-yt-widget">
      <svg class="tg-yt-icon" viewBox="0 0 24 24" fill="none">
        <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.9 31.9 0 0 0 0 12a31.9 31.9 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8Z" fill="currentColor"/>
        <path d="m9.6 15.6 6.3-3.6-6.3-3.6v7.2Z" fill="var(--tg-ink)"/>
      </svg>
      <div class="tg-yt-info">
        <span class="tg-yt-subscribe">Subscribe</span>
        <div class="tg-yt-stats">
          <span class="tg-yt-stat"><strong>{{ section.settings.yt_subscribers }}</strong> subscribers</span>
          <span class="tg-yt-stat"><strong>{{ section.settings.yt_views }}</strong> views</span>
        </div>
      </div>
    </a>
  {% endif %}
</section>

{% if section.settings.poll != blank %}
  <script type="module" src="{{ '2gether-club.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "2Gether Community",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label",
      "default": "Sunday Club"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>RIDE <strong>TOGETHER</strong><br>EVERY SUNDAY</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Lorem ipsum"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Poll"
    },
    {
      "type": "metaobject",
      "id": "poll",
      "metaobject_type": "destination_poll",
      "label": "Анкета (метаобект)"
    },
    {
      "type": "text",
      "id": "poll_label",
      "label": "Заглавие на анкетата",
      "default": "Гласувай за следващата дестинация"
    },
    {
      "type": "text",
      "id": "votes_text",
      "label": "Текст след броя гласове",
      "default": "гласа"
    },
    {
      "type": "text",
      "id": "voters_text",
      "label": "Текст след общия брой гласували",
      "default": "гласували"
    },
    {
      "type": "text",
      "id": "member_cta_text",
      "label": "CTA за нечленове",
      "default": "Стани член, за да гласуваш →"
    },
    {
      "type": "text",
      "id": "member_cta_url",
      "label": "CTA линк за нечленове",
      "default": "/pages/sunday-club#tg-sc-join"
    },
    {
      "type": "text",
      "id": "closed_text",
      "label": "Текст при затворена анкета",
      "default": "Гласуването е затворено"
    },
    {
      "type": "text",
      "id": "msg_error",
      "label": "Съобщение: грешка",
      "default": "Възникна грешка, опитайте отново"
    },
    {
      "type": "text",
      "id": "msg_login",
      "label": "Съобщение: нужен е вход",
      "default": "Влезте, за да гласувате"
    },
    {
      "type": "text",
      "id": "msg_members",
      "label": "Съобщение: само за членове",
      "default": "Само за членове"
    },
    {
      "type": "header",
      "content": "YouTube Widget"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube channel URL"
    },
    {
      "type": "text",
      "id": "yt_subscribers",
      "label": "Subscriber count",
      "default": "2.4K"
    },
    {
      "type": "text",
      "id": "yt_views",
      "label": "View count",
      "default": "128K"
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Voter Avatar",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "initials",
          "label": "Initials",
          "default": "АБ"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "2Gether Community",
      "blocks": [
        { "type": "avatar", "settings": { "initials": "КВ" } },
        { "type": "avatar", "settings": { "initials": "МД" } },
        { "type": "avatar", "settings": { "initials": "ИП" } },
        { "type": "avatar", "settings": { "initials": "АС" } },
        { "type": "avatar", "settings": { "initials": "ТН" } }
      ]
    }
  ]
}
{% endschema %}
