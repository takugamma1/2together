    },
    {
      "type": "text",
      "id": "routes_title",
      "label": "Routes title",
      "default": "PICK YOUR LINE"
    },
    {
      "type": "header",
      "content": "Upcoming rides"
    },
    {
      "type": "text",
      "id": "rides_eyebrow",
      "label": "Rides eyebrow",
