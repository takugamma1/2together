{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-ramps.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-ramps-active');</script>

{%- liquid
  assign st = section.settings
  assign reasons = section.blocks | where: 'type', 'reason'
  assign faqs = section.blocks | where: 'type', 'faq'

  assign p1 = st.product_1
  if p1 == blank
    assign p1 = all_products[st.handle_1]
  endif
  assign p2 = st.product_2
  if p2 == blank
    assign p2 = all_products[st.handle_2]
  endif
  assign v1 = p1.selected_or_first_available_variant
  assign v2 = p2.selected_or_first_available_variant

  assign sum = 0
  if v1 != blank
    assign sum = sum | plus: v1.price
  endif
  if v2 != blank
    assign sum = sum | plus: v2.price
  endif

  assign set_price = st.set_price | times: 100
  if set_price <= 0 and st.set_discount > 0
    assign set_price = sum | minus: st.set_discount | times: 100
  endif
  if set_price <= 0
    assign set_price = sum
  endif
  assign saving = sum | minus: set_price

  assign c1 = st.color_1
  assign c2 = st.color_2
  assign n1 = st.name_1
  assign n2 = st.name_2
  if p1 != blank and n1 == blank
    assign n1 = p1.title
  endif
  if p2 != blank and n2 == blank
    assign n2 = p2.title
  endif
  for tag in p1.tags
    if tag contains 'color:' and st.color_from_tags
      assign c1 = tag | remove_first: 'color:' | strip
    endif
  endfor
  for tag in p2.tags
    if tag contains 'color:' and st.color_from_tags
      assign c2 = tag | remove_first: 'color:' | strip
    endif
  endfor
-%}
{%- capture rp_urls -%}{% render '2gether-ramps-urls', ramps_handle: st.ramps_page, compare_handle: st.compare_page, support_handle: st.support_page %}{%- endcapture -%}
{%- liquid
  assign rp_urls = rp_urls | strip | split: '|'
  assign ramps_url = rp_urls[0]
  assign compare_url = rp_urls[1]
  assign support_url = rp_urls[2]
  assign lineup_url = ramps_url | append: '#tg-ramps-lineup'
-%}

<div class="tg-ramps-page tg-set" id="tg-ramps-top" style="--c1: {{ c1 }}; --c2: {{ c2 }}">

  <!-- ═══ HERO: two ramps + ═══ -->
  <section class="tg-set-hero">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head tg-rp-head--split">
        <div>
          <span class="tg-eyebrow">{{ st.eyebrow }}</span>
          <h1 class="tg-rp-h2 tg-rs-title">{{ st.title }}</h1>
        </div>
        {% if st.back_text != blank %}
          <a href="{{ st.back_link | default: ramps_url }}" class="tg-rp-btn tg-rp-btn--ghost tg-rs-back"><svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 5H2M6 1L2 5l4 4"/></svg>{{ st.back_text }}</a>
        {% endif %}
      </header>

      <div class="tg-set-pair">
        <a class="tg-set-half" href="{{ p1.url | default: lineup_url }}" style="--model: var(--c1)">
          <div class="tg-rp-media">
            {% if st.image_1 != blank %}{{ st.image_1 | image_url: width: 1200 | image_tag: loading: 'eager', class: 'tg-rp-cover' }}{% elsif p1.featured_image != blank %}{{ p1.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}
          </div>
          <div class="tg-set-half-meta">
            <span class="tg-rp-tag">{{ n1 }}</span>
            {% if v1 != blank %}<span class="tg-set-half-price">{{ v1.price | money }}</span>{% endif %}
          </div>
          {% if st.sub_1 != blank %}<p class="tg-rp-text">{{ st.sub_1 }}</p>{% endif %}
        </a>

        <div class="tg-set-plus" aria-hidden="true"><span>+</span></div>

        <a class="tg-set-half" href="{{ p2.url | default: lineup_url }}" style="--model: var(--c2)">
          <div class="tg-rp-media">
            {% if st.image_2 != blank %}{{ st.image_2 | image_url: width: 1200 | image_tag: loading: 'eager', class: 'tg-rp-cover' }}{% elsif p2.featured_image != blank %}{{ p2.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}
          </div>
          <div class="tg-set-half-meta">
            <span class="tg-rp-tag">{{ n2 }}</span>
            {% if v2 != blank %}<span class="tg-set-half-price">{{ v2.price | money }}</span>{% endif %}
          </div>
          {% if st.sub_2 != blank %}<p class="tg-rp-text">{{ st.sub_2 }}</p>{% endif %}
        </a>
      </div>

      <!-- buy bar -->
      <div class="tg-set-buy" data-set-buy data-ids="{{ v1.id }},{{ v2.id }}">
        <div class="tg-set-buy-copy">
          <p class="tg-rp-text tg-set-lead">{{ st.lead }}</p>
          <div class="tg-rp-bundle-price">
            <strong>{{ set_price | money }}</strong>
            {% if saving > 0 %}<s>{{ sum | money }}</s><span class="tg-rp-tag tg-rp-tag--flame">{{ st.save_label | replace: '[amount]', saving | money }}</span>{% endif %}
            {% if st.vat_suffix != blank %}<small class="tg-set-vat">{{ st.vat_suffix }}</small>{% endif %}
          </div>
          {% if st.note != blank %}<p class="tg-pp-note">{{ st.note }}</p>{% endif %}
        </div>
        <div class="tg-set-buy-actions">
          {% if v1 != blank and v2 != blank %}
            <button type="button" class="tg-rp-btn tg-rp-btn--primary tg-set-add" data-set-add>{{ st.add_text }}</button>
            <span class="tg-set-status" data-set-status aria-live="polite"></span>
          {% else %}
            <a href="{{ lineup_url }}" class="tg-rp-btn tg-rp-btn--primary">{{ st.missing_text }}</a>
          {% endif %}
          {% if st.test_text != blank %}<a href="{{ st.test_link | default: '/pages/contact' }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.test_text }}</a>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT YOU GET ═══ -->
  <section class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.kit_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.kit_title }}</h2></header>
      <div class="tg-rp-cards" style="--cols: 2">
        <article class="tg-rp-card tg-set-card" style="--model: var(--c1)">
          <span class="tg-rp-tag">{{ n1 }}</span>
          <h3 class="tg-rp-h3">{{ st.role_1 }}</h3>
          <p class="tg-rp-text">{{ st.role_text_1 }}</p>
          {% if st.specs_1 != blank %}<ul class="tg-rp-specs">{% for x in st.specs_1 | split: '|' %}<li>{{ x | strip }}</li>{% endfor %}</ul>{% endif %}
          <a href="{{ p1.url | default: lineup_url }}" class="tg-rp-btn tg-rp-btn--ghost tg-rp-btn--sm">{{ st.view_text | replace: '[name]', n1 }}</a>
        </article>
        <article class="tg-rp-card tg-set-card" style="--model: var(--c2)">
          <span class="tg-rp-tag">{{ n2 }}</span>
          <h3 class="tg-rp-h3">{{ st.role_2 }}</h3>
          <p class="tg-rp-text">{{ st.role_text_2 }}</p>
          {% if st.specs_2 != blank %}<ul class="tg-rp-specs">{% for x in st.specs_2 | split: '|' %}<li>{{ x | strip }}</li>{% endfor %}</ul>{% endif %}
          <a href="{{ p2.url | default: lineup_url }}" class="tg-rp-btn tg-rp-btn--ghost tg-rp-btn--sm">{{ st.view_text | replace: '[name]', n2 }}</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ WHY THE SET ═══ -->
  {% if reasons.size > 0 %}
  <section class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.why_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.why_title }}</h2></header>
      <div class="tg-rp-cards" style="--cols: {{ reasons.size }}">
        {% for b in reasons %}
          <article class="tg-rp-card" {{ b.shopify_attributes }}>
            {% render '2gether-ramps-icon', name: b.settings.icon %}
            <h3 class="tg-rp-h3">{{ b.settings.title }}</h3>
            <p class="tg-rp-text">{{ b.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ═══ FAQ ═══ -->
  {% if faqs.size > 0 %}
  <section class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap tg-rp-wrap--narrow">
      <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.faq_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.faq_title }}</h2></header>
      <div class="tg-rp-faq">
        {% for b in faqs %}
          <details class="tg-rp-faq-item" {% if forloop.first %}open{% endif %} {{ b.shopify_attributes }}>
            <summary><span>{{ b.settings.question }}</span><i aria-hidden="true"></i></summary>
            <div class="tg-rp-faq-a">{{ b.settings.answer }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ═══ CTA ═══ -->
  <section class="tg-rp-section tg-rp-section--line tg-rp-cta">
    <div class="tg-rp-wrap tg-rp-cta-inner">
      <span class="tg-eyebrow tg-eyebrow--center">{{ st.cta_eyebrow }}</span>
      <h2 class="tg-rp-h2">{{ st.cta_title }}</h2>
      <div class="tg-rp-actions tg-rp-actions--center">
        {% if v1 != blank and v2 != blank and st.cta1_text != blank %}<button type="button" class="tg-rp-btn tg-rp-btn--primary" data-set-add-secondary>{{ st.cta1_text }}</button>{% endif %}
        {% if st.cta2_text != blank %}<a href="{{ compare_url }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.cta2_text }}</a>{% endif %}
      </div>
    </div>
  </section>

  {% render '2gether-ramps-tabs', settings: section.settings, href_1: lineup_url, href_2: compare_url, href_3: support_url, brand_href: '/', hero_selector: '.tg-set-hero' %}
</div>

<script>
(() => {
  const bar = document.querySelector('[data-set-buy]');
  if (!bar) return;
  const ids = (bar.dataset.ids || '').split(',').map(s => parseInt(s, 10)).filter(Boolean);
  const status = bar.querySelector('[data-set-status]');
  const buttons = [bar.querySelector('[data-set-add]'), document.querySelector('[data-set-add-secondary]')].filter(Boolean);
  const ADDING = {{ st.adding_text | json }}, ADDED = {{ st.added_text | json }}, FAIL = {{ st.failed_text | json }};
  const add = (btn) => {
    if (ids.length < 2) return;
    const label = btn.textContent;
    buttons.forEach(b => b.disabled = true); btn.textContent = ADDING;
    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: ids.map(id => ({ id, quantity: 1 })) }) })
      .then(r => { if (!r.ok) throw new Error(); return r.json(); })
      .then(() => { if (status) status.textContent = ADDED; document.dispatchEvent(new CustomEvent('cart:refresh')); document.dispatchEvent(new CustomEvent('cart:open')); })
      .catch(() => { if (status) status.textContent = FAIL; window.location = '/cart'; })
      .finally(() => { buttons.forEach(b => b.disabled = false); btn.textContent = label; });
  };
  buttons.forEach(b => b.addEventListener('click', () => add(b)));
})();
</script>

{% schema %}
{
  "name": "Ramp set (2 products)",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Adds both products to the cart in one click. The set price is informational — create an automatic discount in Shopify (Discounts → Buy X get Y / amount off when both are in the cart) so the cart matches it." },
    { "type": "header", "content": "Products" },
    { "type": "product", "id": "product_1", "label": "Product 1 (take-off)" },
    { "type": "text", "id": "handle_1", "label": "Product 1 handle fallback", "default": "breeze" },
    { "type": "product", "id": "product_2", "label": "Product 2 (landing)" },
    { "type": "text", "id": "handle_2", "label": "Product 2 handle fallback", "default": "storm" },
    { "type": "text", "id": "name_1", "label": "Name 1 override" },
    { "type": "text", "id": "name_2", "label": "Name 2 override" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1 override" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 override" },
    { "type": "text", "id": "sub_1", "label": "Caption 1", "default": "По-лека · кикър 29–38 cm" },
    { "type": "text", "id": "sub_2", "label": "Caption 2", "default": "По-висока · кикър 53–62 cm" },
    { "type": "checkbox", "id": "color_from_tags", "label": "Colours from product color: tags", "default": true },
    { "type": "color", "id": "color_1", "label": "Colour 1 (fallback)", "default": "#C8434F" },
    { "type": "color", "id": "color_2", "label": "Colour 2 (fallback)", "default": "#2F6FD6" },

    { "type": "header", "content": "Head + buy bar" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Пълният спот" },
    { "type": "text", "id": "title", "label": "Title", "default": "BREEZE + STORM · TAKE-OFF & LANDING SET" },
    { "type": "text", "id": "back_text", "label": "Back button", "default": "Назад към рампите" },
    { "type": "url", "id": "back_link", "label": "Back link override" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Използвай едната за изстрелване, а другата за приземяване. Или изгради два различни скока." },
    { "type": "number", "id": "set_price", "label": "Set price (€)", "default": 590 },
    { "type": "number", "id": "set_discount", "label": "…or discount off the sum (€)", "info": "Used only when set price is 0" },
    { "type": "text", "id": "save_label", "label": "Savings badge", "default": "Спестяваш [amount]" },
    { "type": "text", "id": "vat_suffix", "label": "Price suffix", "default": "с ДДС" },
    { "type": "text", "id": "note", "label": "Note", "default": "Доставката се изчислява отделно." },
    { "type": "text", "id": "add_text", "label": "Add both button", "default": "Добави и двете в количката" },
    { "type": "text", "id": "adding_text", "label": "Adding…", "default": "Добавяме…" },
    { "type": "text", "id": "added_text", "label": "Added", "default": "Двете рампи са в количката." },
    { "type": "text", "id": "failed_text", "label": "Failed", "default": "Нещо се обърка — отваряме количката." },
    { "type": "text", "id": "missing_text", "label": "Button when products are missing", "default": "Виж рампите" },
    { "type": "text", "id": "test_text", "label": "Test button", "default": "Запази тест във Варна" },
    { "type": "url", "id": "test_link", "label": "Test link" },

    { "type": "header", "content": "What you get" },
    { "type": "text", "id": "kit_eyebrow", "label": "Eyebrow", "default": "В комплекта" },
    { "type": "text", "id": "kit_title", "label": "Title", "default": "ДВЕ РАМПИ. ЕДИН ЦЯЛ СПОТ." },
    { "type": "text", "id": "role_1", "label": "Role 1", "default": "TAKE-OFF" },
    { "type": "textarea", "id": "role_text_1", "label": "Role text 1", "default": "По-ниският кикър те изстрелва контролирано — идеален за първата рампа от линията." },
    { "type": "text", "id": "specs_1", "label": "Specs 1 (separate with |)", "default": "7.5 kg | 130 × 58 cm | 29–38 cm | 4 позиции" },
    { "type": "text", "id": "role_2", "label": "Role 2", "default": "LANDING" },
    { "type": "textarea", "id": "role_text_2", "label": "Role text 2", "default": "Обърната, по-високата рампа поема приземяването. Или я ползваш като втори, по-агресивен скок." },
    { "type": "text", "id": "specs_2", "label": "Specs 2 (separate with |)", "default": "12.5 kg | 170 × 58 cm | 53–62 cm | 4 позиции" },
    { "type": "text", "id": "view_text", "label": "View button", "default": "Виж [name]" },

    { "type": "header", "content": "Why the set" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Защо комплектът" },
    { "type": "text", "id": "why_title", "label": "Title", "default": "ПОВЕЧЕ ОТ ДВЕ РАМПИ." },

    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Преди да поръчаш" },
    { "type": "text", "id": "faq_title", "label": "Title", "default": "ЧЕСТО ЗАДАВАНИ ВЪПРОСИ" },

    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Следващият спот е твой" },
    { "type": "text", "id": "cta_title", "label": "Title", "default": "ВЗЕМИ ЦЕЛИЯ СПОТ СЪС СЕБЕ СИ." },
    { "type": "text", "id": "cta1_text", "label": "Primary CTA (adds both)", "default": "Добави комплекта" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA → comparison page", "default": "Сравни моделите" },

    { "type": "header", "content": "Pages + tab strip" },
    { "type": "page", "id": "ramps_page", "label": "Ramps page" },
    { "type": "page", "id": "compare_page", "label": "Comparison page" },
    { "type": "page", "id": "support_page", "label": "Support page" },
    { "type": "checkbox", "id": "tabs_enabled", "label": "Show bottom tab strip", "default": true },
    { "type": "text", "id": "tab_1_label", "label": "Tab 1 label", "default": "Рампи" },
    { "type": "text", "id": "tab_2_label", "label": "Tab 2 label", "default": "Сравнение" },
    { "type": "text", "id": "tab_3_label", "label": "Tab 3 label", "default": "Поддръжка" },
    { "type": "text", "id": "tabs_aria", "label": "Strip aria-label", "default": "Навигация в страницата" }
  ],
  "blocks": [
    { "type": "reason", "name": "Reason", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "jump", "options": [ { "value": "jump", "label": "Jump" }, { "value": "landing", "label": "Landing" }, { "value": "carry", "label": "Carry" }, { "value": "shield", "label": "Shield" }, { "value": "fold", "label": "Fold" } ] },
      { "type": "text", "id": "title", "label": "Title", "default": "TAKE-OFF И LANDING" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Пълна линия с изстрелване и приземяване — навсякъде." } ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Как се прилага отстъпката за комплекта?" },
      { "type": "textarea", "id": "answer", "label": "Answer", "default": "Автоматично в количката, когато и двете рампи са в нея." } ] }
  ],
  "presets": [ { "name": "Ramp set (2 products)" } ]
}
{% endschema %}
