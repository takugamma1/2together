{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-product.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&f[]=boska@400,500,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-product-active');</script>

<div class="tg-product-page" data-product-id="{{ product.id }}">
  <!-- ═══ LEFT COLUMN: Editorial Content ═══ -->
  <div class="tg-product-left">

    <!-- Product Gallery: Hero + Thumbnail Carousel -->
    {%- liquid
      assign gallery_media = product.media
      if gallery_media.size == 0 and product.featured_image
        assign gallery_media = product.images
      endif
    -%}

    <div class="tg-product-gallery{% if gallery_media.size > 1 %} has-thumbs{% endif %}" data-tg-gallery>
      {% if gallery_media.size > 1 %}
        <div class="tg-product-thumbs-col">
          <button type="button" class="tg-thumbs-nav tg-thumbs-up" data-tg-prev aria-label="Предишна снимка">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 15 12 9 18 15"/></svg>
          </button>
          <div class="tg-product-thumbs" data-tg-thumbs role="tablist" aria-label="Снимки на продукта">
            {% for media in gallery_media %}
              {%- assign preview = media.preview_image | default: media -%}
              <button type="button" class="tg-thumb{% if forloop.first %} is-active{% endif %}" data-tg-thumb data-index="{{ forloop.index0 }}"
                data-img-src="{{ preview | image_url: width: 1600 }}"
                data-img-srcset="{{ preview | image_url: width: 800 }} 800w, {{ preview | image_url: width: 1200 }} 1200w, {{ preview | image_url: width: 1600 }} 1600w, {{ preview | image_url: width: 2000 }} 2000w"
                data-img-alt="{{ media.alt | default: product.title | escape }}"
                role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Снимка {{ forloop.index }} от {{ gallery_media.size }}">
                <img src="{{ preview | image_url: width: 240 }}" alt="" loading="lazy" width="120" height="120">
              </button>
            {% endfor %}
          </div>
          <button type="button" class="tg-thumbs-nav tg-thumbs-down" data-tg-next aria-label="Следваща снимка">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
      {% endif %}
      <div class="tg-product-hero">
        {% if gallery_media.size > 0 %}
          {%- assign first_media = gallery_media | first -%}
          {%- assign first_preview = first_media.preview_image | default: first_media -%}
          <img data-tg-hero-img src="{{ first_preview | image_url: width: 1600 }}" srcset="{{ first_preview | image_url: width: 800 }} 800w, {{ first_preview | image_url: width: 1200 }} 1200w, {{ first_preview | image_url: width: 1600 }} 1600w, {{ first_preview | image_url: width: 2000 }} 2000w" sizes="(max-width: 1024px) 100vw, 60vw" alt="{{ first_media.alt | default: product.title | escape }}" loading="eager" width="1600" height="1200">
        {% elsif product.featured_image %}
          {{ product.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(max-width: 1024px) 100vw, 60vw', data-tg-hero-img: '' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
        {% if gallery_media.size > 1 %}
          <div class="tg-hero-counter" data-tg-counter aria-hidden="true"><span data-tg-counter-current>1</span> / {{ gallery_media.size }}</div>
        {% endif %}
      </div>
    </div>

    {%- liquid
      assign stat_count = 0
      assign feature_count = 0
      assign included_count = 0
      for block in section.blocks
        case block.type
          when 'stat_tile'
            assign stat_count = stat_count | plus: 1
          when 'feature_card'
            assign feature_count = feature_count | plus: 1
          when 'included_item'
            assign included_count = included_count | plus: 1
        endcase
      endfor
    -%}

    <!-- ═══ STATS STRIP — quick scan of key data ═══ -->
    {% if section.settings.show_stats %}
    {% if stat_count > 0 %}
      <div class="tg-stats-strip">
        {% for block in section.blocks %}
          {% if block.type == 'stat_tile' %}
            <div class="tg-stat-tile" {{ block.shopify_attributes }}>
              <div class="tg-stat-tile-label">{{ block.settings.label }}</div>
              <div class="tg-stat-tile-value">
                {{ block.settings.value }}{% if block.settings.unit != blank %}<span class="tg-stat-tile-unit">{{ block.settings.unit }}</span>{% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}


    {% endif %}

    <!-- ═══ FEATURE HIGHLIGHTS — 3 sliced cards with icons ═══ -->
    {% if section.settings.show_features and feature_count > 0 %}
      <div class="tg-features">
        <div class="tg-section-head">
          <div class="tg-eyebrow">{{ section.settings.features_label | default: 'Highlights' }}</div>
          <h3 class="tg-section-title">{{ section.settings.features_title | default: 'BUILT IN' }}</h3>
        </div>
        <div class="tg-features-grid">
          {% for block in section.blocks %}
            {% if block.type == 'feature_card' %}
              <div class="tg-feature" {{ block.shopify_attributes }}>
                <div class="tg-feature-icon-wrap">
                  {% if block.settings.icon_svg != blank %}
                    {{ block.settings.icon_svg }}
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
                  {% endif %}
                </div>
                <div class="tg-feature-body">
                  <div class="tg-feature-title">{{ block.settings.title }}</div>
                  {% if block.settings.description != blank %}
                    <p class="tg-feature-desc">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- ═══ WHAT'S IN THE BOX — visual checklist ═══ -->
    {% if section.settings.show_included %}
    {% if included_count > 0 %}
      <div class="tg-included">
        <div class="tg-section-head">
          <div class="tg-eyebrow">{{ section.settings.included_label | default: 'In The Box' }}</div>
          <h3 class="tg-section-title">{{ section.settings.included_title | default: 'WHAT YOU GET' }}</h3>
        </div>
        <ul class="tg-included-list">
          {% for block in section.blocks %}
            {% if block.type == 'included_item' %}
              <li class="tg-included-item" {{ block.shopify_attributes }}>
                <span class="tg-included-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span class="tg-included-text">{{ block.settings.title }}</span>
                {% if block.settings.note != blank %}
                  <span class="tg-included-note">{{ block.settings.note }}</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% endif %}

    <!-- ═══ SUPPORT STRIP — sliced trust pills ═══ -->
    {% if section.settings.show_support %}
    <div class="tg-support">
      <div class="tg-support-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <div>
          <strong>{{ section.settings.support_1_title | default: 'Lifetime Warranty' }}</strong>
          <span>{{ section.settings.support_1_desc | default: 'On every frame' }}</span>
        </div>
      </div>
      <div class="tg-support-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <div>
          <strong>{{ section.settings.support_2_title | default: 'Free Shipping' }}</strong>
          <span>{{ section.settings.support_2_desc | default: 'Orders over €500' }}</span>
        </div>
      </div>
      <div class="tg-support-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        <div>
          <strong>{{ section.settings.support_3_title | default: '30-Day Returns' }}</strong>
          <span>{{ section.settings.support_3_desc | default: 'No questions asked' }}</span>
        </div>
      </div>
      <div class="tg-support-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <div>
          <strong>{{ section.settings.support_4_title | default: 'Expert Assembly' }}</strong>
          <span>{{ section.settings.support_4_desc | default: 'Pro fitting included' }}</span>
        </div>
      </div>
    </div>

    {% endif %}

    <!-- Related Products -->
    {% if section.settings.show_related %}
    {%- liquid
      assign related_products = nil
      assign related_count = 0
      if recommendations.performed and recommendations.products_count > 0
        assign related_products = recommendations.products
        assign related_count = recommendations.products_count
      elsif product.collections.first
        assign related_products = product.collections.first.products
        assign related_count = product.collections.first.products_count
      endif
    -%}
    {% if related_count > 1 %}
      <div class="tg-product-related">
        <div class="tg-product-related-header">
          <div class="tg-product-related-title">Подобни продукти</div>
          {% if product.collections.first %}
            <a href="{{ product.collections.first.url }}" class="tg-product-related-link">Виж всички &rarr;</a>
          {% endif %}
        </div>
        <div class="tg-product-related-grid">
          {% for item in related_products limit: 4 %}
            {% if item.id != product.id %}
              <a href="{{ item.url }}" class="tg-related-card">
                <div class="tg-related-card-image">
                  {% if item.featured_image %}
                    {{ item.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="tg-related-card-info">
                  <div class="tg-related-card-name">{{ item.title }}</div>
                  <div class="tg-related-card-price">{{ item.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% endif %}

    <!-- Brand Statement -->
    {% if section.settings.show_brand %}
    <div class="tg-product-brand">
      <div class="tg-product-brand-bg">
        {% if section.settings.brand_image != blank %}
          {{ section.settings.brand_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        {% endif %}
      </div>
      <div class="tg-product-brand-content">
        <div class="tg-product-brand-label">{{ section.settings.brand_label | default: 'Our Process' }}</div>
        <h3 class="tg-product-brand-title">{{ section.settings.brand_title | default: 'PURE FIBER' }}</h3>
        <p class="tg-product-brand-desc">{{ section.settings.brand_description | default: 'Every frame is handcrafted with aerospace-grade carbon fiber, engineered for the perfect balance of stiffness and compliance.' }}</p>
      </div>
    </div>
    {% endif %}
  </div>

  <!-- ═══ RIGHT COLUMN: Purchase Panel ═══ -->
  <div class="tg-product-right">
    <div class="tg-product-panel">

      <!-- Back link -->
      <a href="{{ product.collections.first.url | default: '/collections/all' }}" class="tg-product-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Назад
      </a>

      <!-- Product Header -->
      <div class="tg-product-header">
        {% if product.type != blank %}
          <div class="tg-product-type-label">{{ product.type }}</div>
        {% endif %}
        <h1 class="tg-product-title">{{ product.title }}</h1>
        <div class="tg-product-price" data-product-price>
          {{ product.selected_or_first_available_variant.price | money }}
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="tg-product-price-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>
      </div>

      <!-- Description -->
      {% if product.description != blank %}
        <div class="tg-product-description">
          {{ product.description }}
        </div>
      {% endif %}

      <hr class="tg-product-divider">

      <!-- Variant Pickers -->
      {%- liquid
        assign current_variant = product.selected_or_first_available_variant
      -%}

      {% for option in product.options_with_values %}
        {% if product.has_only_default_variant %}{% continue %}{% endif %}
        <div class="tg-product-option" data-option-index="{{ forloop.index0 }}">
          <div class="tg-product-option-label">
            {{ option.name }}
            <span>— {{ option.selected_value }}</span>
          </div>

          {% assign option_name_lower = option.name | downcase %}
          {% if option_name_lower == 'color' or option_name_lower == 'colour' %}
            <div class="tg-color-swatches">
              {% for value in option.values %}
                {% assign color_handle = value | handleize %}
                <button
                  type="button"
                  class="tg-color-swatch {% if option.selected_value == value %}active{% endif %}"
                  data-option-value="{{ value }}"
                  aria-label="{{ value }}"
                  title="{{ value }}"
                >
                  <span class="tg-color-swatch-inner" style="background-color: {{ color_handle }};"></span>
                </button>
              {% endfor %}
            </div>
          {% else %}
            <div class="tg-size-swatches">
              {% for value in option.values %}
                <button
                  type="button"
                  class="tg-size-swatch {% if option.selected_value == value %}active{% endif %}"
                  data-option-value="{{ value }}"
                >
                  {{ value }}
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}

      <!-- Add to Cart Form -->
      {%- form 'product', product, id: 'tg-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="tg-variant-id">

        <div class="tg-product-actions">
          <button
            type="submit"
            name="add"
            class="tg-btn-add-cart"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            {% if current_variant.available %}
              {{ section.settings.add_to_cart_text | default: 'Добави в количката' }}
            {% else %}
              {{ section.settings.sold_out_text | default: 'Изчерпано' }}
            {% endif %}
          </button>

          {% if section.settings.show_dynamic_checkout %}
            {{ form | payment_button }}
          {% elsif current_variant.available %}
            <button type="button" class="tg-btn-buy-now" data-tg-buy-now>
              {{ section.settings.buy_now_text | default: 'Купи сега' }}
            </button>
          {% endif %}
        </div>
      {%- endform -%}

      <!-- Compact reassurance line — full trust pills live in the support strip below -->
      {% if section.settings.reassure_text != blank %}
        <div class="tg-product-reassure">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>{{ section.settings.reassure_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
/* ── Product image gallery (thumbnails + arrows + swipe + keyboard) ── */
(function() {
  const gallery = document.querySelector('[data-tg-gallery]');
  if (!gallery) return;

  const heroImg = gallery.querySelector('[data-tg-hero-img]');
  const thumbs = Array.from(gallery.querySelectorAll('[data-tg-thumb]'));
  const prev = gallery.querySelector('[data-tg-prev]');
  const next = gallery.querySelector('[data-tg-next]');
  const counter = gallery.querySelector('[data-tg-counter-current]');
  const heroWrap = gallery.querySelector('.tg-product-hero');

  if (!heroImg || thumbs.length < 2) return;

  let index = 0;
  let isAnimating = false;

  function setIndex(i, opts) {
    opts = opts || {};
    const len = thumbs.length;
    if (i < 0) i = len - 1;
    if (i >= len) i = 0;
    if (i === index && !opts.force) return;

    const t = thumbs[i];
    const src = t.dataset.imgSrc;
    const srcset = t.dataset.imgSrcset || '';
    const alt = t.dataset.imgAlt || '';

    isAnimating = true;
    heroImg.classList.add('is-swapping');

    // Swap after short fade
    window.setTimeout(function() {
      heroImg.src = src;
      if (srcset) heroImg.srcset = srcset;
      heroImg.alt = alt;
      // Wait for load to fade back in
      if (heroImg.complete) {
        heroImg.classList.remove('is-swapping');
        isAnimating = false;
      } else {
        heroImg.addEventListener('load', function onLoad() {
          heroImg.classList.remove('is-swapping');
          heroImg.removeEventListener('load', onLoad);
          isAnimating = false;
        });
      }
    }, 150);

    thumbs.forEach(function(tt, idx) {
      const active = idx === i;
      tt.classList.toggle('is-active', active);
      tt.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    if (counter) counter.textContent = String(i + 1);

    // Scroll active thumbnail into view — only inside the thumbs container,
    // never the page (avoids horizontal page scroll cascading from scrollIntoView).
    if (!opts.skipScroll) {
      const thumbsParent = t.parentElement;
      if (thumbsParent) {
        const vertical = thumbsParent.scrollHeight > thumbsParent.clientHeight + 2;
        const targetTop = t.offsetTop - (thumbsParent.clientHeight / 2) + (t.clientHeight / 2);
        const targetLeft = t.offsetLeft - (thumbsParent.clientWidth / 2) + (t.clientWidth / 2);
        try {
          thumbsParent.scrollTo(vertical ? { top: Math.max(0, targetTop), behavior: 'smooth' } : { left: Math.max(0, targetLeft), behavior: 'smooth' });
        } catch (e) {
          if (vertical) thumbsParent.scrollTop = Math.max(0, targetTop); else thumbsParent.scrollLeft = Math.max(0, targetLeft);
        }
      }
    }

    index = i;
  }

  thumbs.forEach(function(t, i) {
    t.addEventListener('click', function() { setIndex(i); });
  });

  if (prev) prev.addEventListener('click', function() { setIndex(index - 1); });
  if (next) next.addEventListener('click', function() { setIndex(index + 1); });

  // Keyboard arrows when gallery has focus
  gallery.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') { e.preventDefault(); setIndex(index - 1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); setIndex(index + 1); }
  });

  // Touch swipe on hero image
  if (heroWrap) {
    let touchStartX = 0;
    let touchStartY = 0;
    let touchTime = 0;

    heroWrap.addEventListener('touchstart', function(e) {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      touchTime = Date.now();
    }, { passive: true });

    heroWrap.addEventListener('touchend', function(e) {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      // Ignore mostly vertical swipes (page scroll) or slow drags
      if (Math.abs(dx) < 40 || Math.abs(dy) > Math.abs(dx)) return;
      if (Date.now() - touchTime > 500) return;
      setIndex(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
})();

/* ── Mobile drawer (bottom sheet) ── */
(function() {
  const drawer = document.querySelector('.tg-product-right');
  if (!drawer) return;

  const mq = window.matchMedia('(max-width: 1024px)');
  const panel = drawer.querySelector('.tg-product-panel');

  const isMobile = function() { return mq.matches; };
  const isOpen = function() { return drawer.classList.contains('tg-drawer-open'); };
  const open = function() {
    drawer.classList.add('tg-drawer-open');
    document.body.style.overflow = 'hidden';
  };
  const close = function() {
    drawer.classList.remove('tg-drawer-open');
    document.body.style.overflow = '';
    if (panel) panel.scrollTop = 0;
  };

  // Tap when collapsed → expand
  drawer.addEventListener('click', function(e) {
    if (!isMobile()) return;
    if (isOpen()) return;
    // Don't intercept clicks on links/buttons inside collapsed peek (e.g. add-to-cart)
    const interactive = e.target.closest('button, a, input, select, label');
    if (interactive) return;
    open();
  });

  // Swipe gestures
  let touchStartY = 0;
  let touchStartX = 0;
  let touchTime = 0;
  let panelStartScrollTop = 0;

  drawer.addEventListener('touchstart', function(e) {
    if (!isMobile()) return;
    touchStartY = e.touches[0].clientY;
    touchStartX = e.touches[0].clientX;
    touchTime = Date.now();
    panelStartScrollTop = panel ? panel.scrollTop : 0;
  }, { passive: true });

  drawer.addEventListener('touchend', function(e) {
    if (!isMobile()) return;
    const endY = e.changedTouches[0].clientY;
    const endX = e.changedTouches[0].clientX;
    const dy = touchStartY - endY;
    const dx = Math.abs(endX - touchStartX);

    // Ignore mostly-horizontal swipes
    if (dx > Math.abs(dy)) return;

    // Swipe up → open
    if (dy > 40 && !isOpen()) {
      open();
    }
    // Swipe down (only when scrolled to top) → close
    else if (dy < -50 && isOpen() && panelStartScrollTop <= 0) {
      close();
    }
  }, { passive: true });

  // Restore body overflow if viewport grows past breakpoint
  mq.addEventListener('change', function(e) {
    if (!e.matches) {
      drawer.classList.remove('tg-drawer-open');
      document.body.style.overflow = '';
    }
  });
})();

(function() {
  const form = document.getElementById('tg-product-form');
  const variantInput = document.getElementById('tg-variant-id');
  const productData = {{ product.variants | json }};
  const TG_ADD_TEXT = {{ section.settings.add_to_cart_text | default: 'Add to Cart' | json }};
  const TG_SOLD_TEXT = {{ section.settings.sold_out_text | default: 'Sold Out' | json }};
  const TG_CART_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg> ';

  // Add to cart: handle it here (don't let the form navigate to /cart).
  // AJAX-add, then ask the header to open the cart drawer.
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const id = variantInput ? variantInput.value : null;
      if (!id) return;
      const addBtn = form.querySelector('.tg-btn-add-cart');
      if (addBtn) addBtn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
        .then(function(r) { return r.json(); })
        .then(function() {
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          document.dispatchEvent(new CustomEvent('cart:open'));
        })
        .catch(function() {})
        .finally(function() { if (addBtn) addBtn.disabled = false; });
    });
  }

  // "Buy Now": add the selected variant, then go straight to checkout.
  const buyNowBtn = document.querySelector('[data-tg-buy-now]');
  if (buyNowBtn) {
    buyNowBtn.addEventListener('click', function() {
      const id = variantInput ? variantInput.value : null;
      if (!id) return;
      buyNowBtn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
        .then(function() { window.location = '/checkout'; })
        .catch(function() { window.location = '/cart'; });
    });
  }

  // Handle swatch clicks
  document.querySelectorAll('.tg-color-swatch, .tg-size-swatch').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const parent = this.closest('.tg-product-option');
      parent.querySelectorAll('.tg-color-swatch, .tg-size-swatch').forEach(function(s) {
        s.classList.remove('active');
      });
      this.classList.add('active');

      // Update label
      const label = parent.querySelector('.tg-product-option-label span');
      if (label) label.textContent = '— ' + this.dataset.optionValue;

      // Find matching variant
      var selectedOptions = [];
      document.querySelectorAll('.tg-product-option').forEach(function(opt) {
        var active = opt.querySelector('.active');
        if (active) selectedOptions.push(active.dataset.optionValue);
      });

      for (var i = 0; i < productData.length; i++) {
        var variant = productData[i];
        var match = true;
        for (var j = 0; j < selectedOptions.length; j++) {
          if (variant['option' + (j + 1)] !== selectedOptions[j]) {
            match = false;
            break;
          }
        }
        if (match) {
          variantInput.value = variant.id;
          // Update price
          var priceEl = document.querySelector('[data-product-price]');
          if (priceEl) {
            var formatted = (variant.price / 100).toLocaleString(undefined, { style: 'currency', currency: '{{ shop.currency }}' });
            priceEl.innerHTML = formatted;
            if (variant.compare_at_price && variant.compare_at_price > variant.price) {
              var compareFormatted = (variant.compare_at_price / 100).toLocaleString(undefined, { style: 'currency', currency: '{{ shop.currency }}' });
              priceEl.innerHTML += ' <span class="tg-product-price-compare">' + compareFormatted + '</span>';
            }
          }
          // Update button
          var addBtn = form.querySelector('.tg-btn-add-cart');
          if (addBtn) {
            addBtn.disabled = !variant.available;
            addBtn.innerHTML = variant.available
              ? TG_CART_ICON + TG_ADD_TEXT
              : TG_SOLD_TEXT;
          }
          // Update URL
          var url = new URL(window.location);
          url.searchParams.set('variant', variant.id);
          window.history.replaceState({}, '', url);
          break;
        }
      }
    });
  });
})();
</script>

