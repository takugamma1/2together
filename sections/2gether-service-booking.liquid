{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-ramps.css' | asset_url | stylesheet_tag }}
{{ '2gether-service-booking.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

{%- liquid
  assign st = section.settings
  comment
    Liquid caps metaobjects.X.values at 50 entries, so the list of handles lives in a setting
    (one per line, in display order). Empty setting = fall back to the first 50.
  endcomment
  assign sb_handle_text = st.service_handles | default: ''
  assign sb_handles = sb_handle_text | strip | newline_to_br | split: '<br />'
  assign services = '' | split: ''
  if sb_handle_text != blank
    for sb_h in sb_handles
      assign sb_hh = sb_h | strip
      if sb_hh == blank
        continue
      endif
      assign sb_obj = shop.metaobjects.service_type[sb_hh]
      if sb_obj
        assign sb_one = sb_obj | sort: 'name'
        assign services = services | concat: sb_one
      endif
    endfor
  else
    assign services = shop.metaobjects.service_type.values | sort: 'sort'
  endif
  assign cat_list = 'Пакетно обслужване,Капли и гуми,Трансмисия,Спирачна система,Окачване,Други' | split: ','
  assign mechanics = shop.metaobjects.mechanic.values | sort: 'sort'
-%}

<div class="tg-ramps-page tg-sb" data-tg-sb data-endpoint="{{ st.endpoint | default: '/apps/club' }}" data-lead="{{ st.lead_hours | default: 2 }}">
  <section class="tg-sb-hero">
    {% if st.hero_image != blank %}<div class="tg-sb-hero-bg">{{ st.hero_image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'tg-rp-cover' }}</div>{% endif %}
    <div class="tg-rp-wrap tg-sb-hero-inner">
      <span class="tg-eyebrow">{{ st.hero_eyebrow }}</span>
      <h1 class="tg-rp-h1">{{ st.hero_title }} <span>{{ st.hero_title_accent }}</span></h1>
      <p class="tg-rp-lead">{{ st.hero_sub }}</p>
      <a href="#tg-sb-book" class="tg-rp-btn tg-rp-btn--primary">{{ st.hero_cta }}</a>
    </div>
  </section>

  <section id="tg-sb-book" class="tg-rp-section">
    <div class="tg-rp-wrap">
      <ol class="tg-sb-steps" data-sb-steps>
        <li class="is-active" data-sb-step-tab="1"><i>1</i>{{ st.step1_tab }}</li>
        <li data-sb-step-tab="2"><i>2</i>{{ st.step2_tab }}</li>
        <li data-sb-step-tab="3"><i>3</i>{{ st.step3_tab }}</li>
        <li data-sb-step-tab="4"><i>4</i>{{ st.step4_tab }}</li>
      </ol>

      <!-- STEP 1: service -->
      <div class="tg-sb-step is-active" data-sb-step="1">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step1_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step1_title }}</h2><p class="tg-rp-text">{{ st.step1_text }}</p></header>
        <div class="tg-sb-filter">
          <label class="tg-sb-search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg><input type="search" placeholder="{{ st.search_ph | escape }}" data-sb-search autocomplete="off"></label>
          <div class="tg-sb-chips" data-sb-chips>
            <button type="button" class="tg-rp-seg-btn is-active" data-sb-cat="">{{ st.all_label }}</button>
            {% for c in cat_list %}<button type="button" class="tg-rp-seg-btn" data-sb-cat="{{ c }}">{{ c }}</button>{% endfor %}
          </div>
        </div>
        <div class="tg-sb-list" data-sb-list>
          {% for c in cat_list %}
            <div class="tg-sb-group" data-sb-group="{{ c }}">
              <h3 class="tg-sb-group-title"><span>//</span> {{ c }}</h3>
              <div class="tg-sb-group-items{% if forloop.first %} tg-sb-cards{% else %} tg-sb-rows{% endif %}">
                {% for sv in services %}
                  {% if sv.active and sv.category == c and sv.bookable != false %}
                    {%- assign sb_price = sv.price_from -%}
                    <button type="button" class="{% if forloop.parentloop.first %}tg-sb-card{% else %}tg-sb-row{% endif %}" data-sb-service="{{ sv.system.handle }}" data-name="{{ sv.name | escape }}" data-duration="{{ sv.duration_minutes }}" data-price="{{ sb_price }}" data-price-to="{{ sv.price_to }}" data-cat="{{ c }}" data-search="{{ sv.name | downcase | escape }}">
                      <span class="tg-sb-card-top"><strong>{{ sv.name }}</strong><em>{{ sv.duration_minutes }} мин</em></span>
                      {% if forloop.parentloop.first and sv.description != blank %}<span class="tg-sb-card-desc">{{ sv.description | newline_to_br | split: '<br />' | first | strip_html | truncate: 110 }}</span>{% endif %}
                      <span class="tg-sb-card-price">{% if sv.price_to != blank %}€{{ sb_price }} – {{ sv.price_to }}{% else %}€{{ sb_price }}{% endif %}{% if sv.price_bgn != blank %} <small>{{ sv.price_bgn }}</small>{% endif %}</span>
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
          <p class="tg-sb-empty" data-sb-empty hidden>{{ st.no_results }}</p>
        </div>
        <div class="tg-sb-sticky" data-sb-sticky hidden>
          <span class="tg-sb-sticky-sel"><em>{{ st.selected_label }}</em><strong data-sb-sticky-name></strong></span>
          <button type="button" class="tg-rp-btn tg-rp-btn--primary" data-sb-next disabled>{{ st.next_label }}</button>
        </div>
      </div>

      <!-- STEP 2: mechanic -->
      <div class="tg-sb-step" data-sb-step="2">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step2_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step2_title }}</h2><p class="tg-rp-text">{{ st.step2_text }}</p></header>
        <div class="tg-sb-cards tg-sb-cards--mech">
          <button type="button" class="tg-sb-card tg-sb-mech is-selected" data-sb-mechanic="any" data-name="{{ st.any_mechanic | escape }}">
            <span class="tg-sb-mech-avatar tg-sb-mech-avatar--any">{% render '2gether-ramps-icon', name: 'wrench' %}</span>
            <span class="tg-sb-card-top"><strong>{{ st.any_mechanic }}</strong></span><span class="tg-sb-card-desc">{{ st.any_mechanic_text }}</span>
          </button>
          {% for m in mechanics %}
            {% if m.active %}
              <button type="button" class="tg-sb-card tg-sb-mech" data-sb-mechanic="{{ m.system.handle }}" data-name="{{ m.name | escape }}">
                <span class="tg-sb-mech-avatar">{% if m.photo != blank %}{{ m.photo | image_url: width: 240 | image_tag: loading: 'lazy', class: 'tg-rp-cover' }}{% else %}{{ m.name | slice: 0, 1 }}{% endif %}</span>
                <span class="tg-sb-card-top"><strong>{{ m.name }}</strong></span>
                {% if m.specialties != blank %}<span class="tg-sb-card-desc">{{ m.specialties }}</span>{% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>
        <div class="tg-sb-nav"><button type="button" class="tg-rp-btn tg-rp-btn--ghost" data-sb-back>{{ st.back_label }}</button><button type="button" class="tg-rp-btn tg-rp-btn--primary" data-sb-next>{{ st.next_label }}</button></div>
      </div>

      <!-- STEP 3: date + time -->
      <div class="tg-sb-step" data-sb-step="3">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step3_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step3_title }}</h2><p class="tg-rp-text" data-sb-step3-text>{{ st.step3_text }}</p></header>
        <div class="tg-sb-datetime">
          <div class="tg-sb-cal" data-sb-cal>
            <div class="tg-sb-cal-head"><button type="button" data-sb-cal-prev aria-label="Предишен месец">‹</button><strong data-sb-cal-title></strong><button type="button" data-sb-cal-next aria-label="Следващ месец">›</button></div>
            {%- assign sb_weekdays = 'Пн,Вт,Ср,Чт,Пт,Сб,Нд' | split: ',' -%}<div class="tg-sb-cal-week">{% for d in sb_weekdays %}<span>{{ d }}</span>{% endfor %}</div>
            <div class="tg-sb-cal-days" data-sb-cal-days></div>
            <p class="tg-sb-cal-note" data-sb-cal-note>{{ st.loading_text }}</p>
          </div>
          <div class="tg-sb-times">
            <h3 class="tg-rp-h3" data-sb-times-title>{{ st.pick_day_text }}</h3>
            <div class="tg-sb-time-groups" data-sb-times></div>
          </div>
        </div>
        <div class="tg-sb-nav"><button type="button" class="tg-rp-btn tg-rp-btn--ghost" data-sb-back>{{ st.back_label }}</button><button type="button" class="tg-rp-btn tg-rp-btn--primary" data-sb-next disabled>{{ st.next_label }}</button></div>
      </div>

      <!-- STEP 4: details -->
      <div class="tg-sb-step" data-sb-step="4">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step4_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step4_title }}</h2></header>
        <div class="tg-sb-final">
          <form class="tg-sb-form" data-sb-form novalidate>
            <label><span>{{ st.f_name }}</span><input type="text" name="name" required autocomplete="name"></label>
            <label><span>{{ st.f_phone }}</span><input type="tel" name="phone" required autocomplete="tel"></label>
            <label><span>{{ st.f_email }}</span><input type="email" name="email" autocomplete="email"></label>
            <label><span>{{ st.f_bike }}</span><input type="text" name="bike" placeholder="{{ st.f_bike_ph | escape }}"></label>
            <label class="tg-sb-full"><span>{{ st.f_note }}</span><textarea name="note" rows="3" placeholder="{{ st.f_note_ph | escape }}"></textarea></label>
            <p class="tg-sb-error" data-sb-error hidden></p>
            <div class="tg-sb-nav"><button type="button" class="tg-rp-btn tg-rp-btn--ghost" data-sb-back>{{ st.back_label }}</button><button type="submit" class="tg-rp-btn tg-rp-btn--primary" data-sb-submit>{{ st.submit_label }}</button></div>
            <p class="tg-sb-note">{{ st.form_note }}</p>
          </form>
          <aside class="tg-sb-summary" data-sb-summary>
            <span class="tg-eyebrow">{{ st.summary_title }}</span>
            <dl>
              <div><dt>{{ st.step1_tab }}</dt><dd data-sum="service">—</dd></div>
              <div><dt>{{ st.step2_tab }}</dt><dd data-sum="mechanic">—</dd></div>
              <div><dt>{{ st.step3_tab }}</dt><dd data-sum="when">—</dd></div>
              <div><dt>{{ st.sum_duration }}</dt><dd data-sum="duration">—</dd></div>
              <div class="tg-sb-sum-total"><dt>{{ st.sum_price }}</dt><dd data-sum="price">—</dd></div>
            </dl>
          </aside>
        </div>
      </div>

      <!-- DONE -->
      <div class="tg-sb-step tg-sb-done" data-sb-step="done">
        <div class="tg-sb-done-card">
          <span class="tg-eyebrow">{{ st.done_eyebrow }}</span>
          <h2 class="tg-rp-h2">{{ st.done_title }}</h2>
          <p class="tg-rp-text" data-sb-done-text></p>
          <p class="tg-sb-ref">№ <strong data-sb-ref></strong></p>
          <a href="{{ routes.root_url }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.done_cta }}</a>
        </div>
      </div>

      {%- comment -%} Fallback: e-mail the shop through Shopify when the worker is unreachable {%- endcomment -%}
      {%- form 'contact', id: 'tg-sb-fallback', class: 'tg-sb-fallback' -%}
        <input type="hidden" name="contact[type]" value="Service booking">
        <input type="hidden" name="contact[name]" data-fb="name"><input type="hidden" name="contact[phone]" data-fb="phone"><input type="hidden" name="contact[email]" data-fb="email"><input type="hidden" name="contact[details]" data-fb="details">
      {%- endform -%}
    </div>
  </section>

  <!-- PRICES -->
  {% if st.show_prices %}
  <section id="tg-sb-prices" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head tg-sb-prices-head"><div><span class="tg-eyebrow">{{ st.prices_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.prices_title }}</h2></div>
        <label class="tg-sb-search tg-sb-search--prices"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg><input type="search" placeholder="{{ st.search_ph | escape }}" data-sb-price-search autocomplete="off"></label>
      </header>
      <div class="tg-sb-pricelist" data-sb-pricelist>
        {% for c in cat_list %}
          <details class="tg-sb-pl-cat" data-sb-pl-cat{% if forloop.first %} open{% endif %}>
            <summary><span class="tg-sb-pl-cat-name"><i>0{{ forloop.index }}</i>{{ c }}</span><span class="tg-sb-pl-cat-meta"><span data-sb-pl-count></span><b aria-hidden="true"></b></span></summary>
            <div class="tg-sb-pl-items">
              {% for sv in services %}
                {% if sv.active and sv.category == c %}
                  <div class="tg-sb-pl-item" data-sb-pl-item data-search="{{ sv.name | downcase | escape }}">
                    <div class="tg-sb-pl-row">
                      <button type="button" class="tg-sb-pl-name" {% if sv.description != blank %}data-sb-pl-toggle aria-expanded="false"{% endif %}>
                        <span>{{ sv.name }}</span>{% if sv.description != blank %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>{% endif %}
                      </button>
                      <span class="tg-sb-pl-price"><strong>{% if sv.price_to != blank %}€{{ sv.price_from }} – {{ sv.price_to }}{% else %}€{{ sv.price_from }}{% endif %}</strong>{% if sv.price_bgn != blank %}<small>{{ sv.price_bgn }}</small>{% endif %}</span>
                      {% if sv.bookable != false %}<button type="button" class="tg-sb-pl-book" data-sb-pick="{{ sv.system.handle }}">{{ st.book_label }}</button>{% else %}<span class="tg-sb-pl-book tg-sb-pl-book--na">{{ st.ask_label }}</span>{% endif %}
                    </div>
                    {% if sv.description != blank %}<div class="tg-sb-pl-desc" hidden>{{ sv.description | newline_to_br }}</div>{% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </details>
        {% endfor %}
        <p class="tg-sb-empty" data-sb-pl-empty hidden>{{ st.no_results }}</p>
      </div>
      <p class="tg-rp-text tg-sb-prices-note">{{ st.prices_note }}</p>
    </div>
  </section>
  {% endif %}
</div>

<script>
  window.TG_SB = {
    months: {{ 'януари,февруари,март,април,май,юни,юли,август,септември,октомври,ноември,декември' | split: ',' | json }},
    t: { pickDay: {{ st.pick_day_text | json }}, noSlots: {{ st.no_slots_text | json }}, loading: {{ st.loading_text | json }}, free: {{ st.free_text | json }}, anyMech: {{ st.any_mechanic | json }}, errSlot: {{ st.err_slot | json }}, errGeneric: {{ st.err_generic | json }}, errFields: {{ st.err_fields | json }}, doneText: {{ st.done_text | json }}, doneFallback: {{ st.done_fallback | json }}, sending: {{ st.sending_label | json }} }
  };
</script>
<script src="{{ '2gether-service-booking.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Service booking",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Услугите и механиците се редактират в Content → Metaobjects (Service type / Mechanic). Работното време на всеки механик е в неговия запис." },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Background" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Сервиз · Варна" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "ЗАПИШИ ЧАС ЗА" },
    { "type": "text", "id": "hero_title_accent", "label": "Title accent", "default": "СЕРВИЗ" },
    { "type": "textarea", "id": "hero_sub", "label": "Subtitle", "default": "Избираш услуга, механик и час. Без чакане, без телефонни обаждания — колелото ти е готово, когато ти е удобно." },
    { "type": "text", "id": "hero_cta", "label": "CTA", "default": "Запази час" },
    { "type": "header", "content": "Wizard" },
    { "type": "text", "id": "endpoint", "label": "Worker endpoint", "default": "/apps/club" },
    { "type": "number", "id": "lead_hours", "label": "Minimum hours ahead (display only; worker enforces)", "default": 2 },
    { "type": "text", "id": "step1_tab", "label": "Step 1 tab", "default": "Услуга" },
    { "type": "text", "id": "step2_tab", "label": "Step 2 tab", "default": "Механик" },
    { "type": "text", "id": "step3_tab", "label": "Step 3 tab", "default": "Ден и час" },
    { "type": "text", "id": "step4_tab", "label": "Step 4 tab", "default": "Данни" },
    { "type": "text", "id": "next_label", "label": "Next", "default": "Напред" },
    { "type": "textarea", "id": "service_handles", "label": "Service handles (one per line, display order)", "info": "Metaobjects → Service type → handle. Needed because themes only see 50 entries.", "default": "paket-prigotvyane-za-sahranenie\npaket-podgotvyane-za-sezona\npaket-tsyalostna-profilaktika\npaket-premium-tsyalostna-profilaktika\npaket-okachvane\npaket-folirane-na-velosiped\npaket-pochistvane\npaket-premium-pochistvane\npaket-skorostna-sistema\npaket-spirachna-sistema-v-brake\npaket-spirachna-sistema-mehanichni-diskovi-spirachki\npaket-spirachna-sistema-hidravlichni-diskovi-spirachki\npaket-lageri-na-ramka\nsmyana-na-guma\nlepene-na-guma\nmontazh-na-tubularna-guma\nmontazh-na-bezkamerna-guma\nsmyana-na-guma-na-el-trotinetka\nsmyana-na-guma-na-el-motor\nsmyana-na-zadna-kapla-na-velosiped-s-disk\nsmyana-na-predna-kapla-na-velosiped-s-disk\nprofilaktika-na-zadna-glavina-s-nekapsulovani-lageri\nprofilaktika-na-glavina-s-kapsulovani-lageri\nprofilaktika-na-predna-glavina-s-nekapsulovani-lageri\ntsentrovka-na-kapla\nnaplitane-na-kapla-i-tsentrovka\nrazplitane-na-predna-kapla\nrazplitane-na-zadna-kapla\nrazplitane-naplitane-i-tsentrovka\nsmyana-na-komanda\nsmyana-na-zadni-ventsi\nsmyana-na-lyav-kurbel\nsmyana-na-kurbeli\nsmyana-na-plocha\nsmyana-na-veriga\nmontazh-na-vodach-za-veriga\nsmazvane-na-veriga\nsmyana-na-zhilo-za-skorosti\nsmyana-na-bronya-i-zhilo-za-skorosti\nsmyana-na-bronya-i-zhilo-za-skorosti-s-vatreshno-okabelyavan\nsmyana-na-sredno-dvizhenie\nprofilaktika-na-sredno-dvizhenie-pri-srednite-s-nekapsulovan\nremont-na-rezba-na-ramka-pri-srednoto-dvizhenie\nvazstanovyavane-na-rezba-na-kurbel\nregulirane-na-skorosti\nizpravyane-na-uho-za-skorosti-i-nastroyvane\nsmyana-na-uho-i-nastroyvane-na-skorosti\nsmyana-na-zaden-deraylor\nsmyana-na-preden-deraylor\nmontazh-na-pedali\nsmyana-na-pedali\nmontazh-i-nastroyvane-na-parcheta-i-shpaykove\nprofilaktika-na-pedali-s-kapsulovani-lageri\nsmyana-na-spirachno-lostche-mehanichno\nsmyana-na-spirachno-lostche-hidravlichno\nsmyana-na-v-brake-spirachka\nsmyana-na-diskova-mehanichna-spirachka\nsmyana-na-diskova-hidravlichna-spirachka\nsmyana-na-diskova-spirachka-s-vatreshno-okabelyavane\nsmyana-na-rotor\nsmyana-na-zhilo-na-spirachka-v-brake-u-brake-chelyustna-meha\nsmyana-na-bronya-i-zhilo-na-spirachka-v-brake-u-brake-chelyu\nsmyana-na-bronya-i-zhilo-na-spirachka-s-vatreshno-okabelyava\nsmyana-na-nakladki-na-diskova-spirachka\nsmyana-na-kalodki-na-v-brake-spirachka\nreglazh-na-spirachka-v-brake-u-brake-chelyustna-mehanichna-d\nizpravyane-na-rotor\nskasyavane-na-spirachen-hidravlichen-markuch\nsmyana-na-chashki-chelni-lageri\nmontazh-na-chashki-chelni-lageri\nobirane-na-luft-v-chashki-na-rezba\nobirane-na-luft-v-chashki\nprofilaktika-na-vilka-shok\ndemontazh-i-montazh-na-vilka\ndemontazh-i-montazh-na-shok\npodmyana-na-vsichki-lageri-na-ramka\nprofilaktika-na-chashki\nsmyana-na-kormilo\nsmyana-na-lapa\nsmyana-na-sedlo\nsmyana-na-gyudelin\nsmyana-na-gripove\nsmyana-na-sedlovo-kolche\nmontazh-na-bagazhnik\nmontazh-na-chip-za-elektricheski-velosiped\ndiagnostika-na-elektricheski-velosiped-s-elektrodvigatel-bos\nsglobyavane-na-nov-velosiped\nsglobyavane-na-velosiped\nhotel-za-velosipedi" },
    { "type": "text", "id": "all_label", "label": "'All' chip", "default": "Всички" },
    { "type": "text", "id": "search_ph", "label": "Search placeholder", "default": "Търси услуга… напр. верига, спирачки" },
    { "type": "text", "id": "no_results", "label": "No results", "default": "Нищо не намерихме. Избери „Диагностика“ или ни се обади." },
    { "type": "text", "id": "selected_label", "label": "Selected label", "default": "Избрано" },
    { "type": "text", "id": "book_label", "label": "Price list book button", "default": "Запиши" },
    { "type": "text", "id": "ask_label", "label": "Price list non-bookable label", "default": "Попитай" },
