{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-ramps.css' | asset_url | stylesheet_tag }}
{{ '2gether-service-booking.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

{%- liquid
  assign st = section.settings
  assign cat_list = 'Пакетно обслужване,Капли и гуми,Трансмисия,Спирачна система,Окачване,Други' | split: ','
  assign cat_labels = 'tg.service_booking.categories' | t | split: ','
  assign mechanics = shop.metaobjects.mechanic.values | sort: 'sort'
-%}

<div class="tg-ramps-page tg-sb" data-tg-sb data-endpoint="{{ st.endpoint | default: '/apps/club' }}" data-lead="{{ st.lead_hours | default: 2 }}">
  <section class="tg-sb-hero">
    {% if st.hero_image != blank %}<div class="tg-sb-hero-bg">{{ st.hero_image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'tg-rp-cover' }}</div>{% endif %}
    <div class="tg-rp-wrap tg-sb-hero-inner">
      <span class="tg-eyebrow">{{ st.hero_eyebrow }}</span>
      <h1 class="tg-rp-h1">{{ st.hero_title }} <span>{{ st.hero_title_accent }}</span></h1>
      <p class="tg-rp-lead">{{ st.hero_sub }}</p>
      <a href="#tg-sb-book" class="tg-rp-btn tg-rp-btn--primary">{{ st.hero_cta }}</a>
    </div>
  </section>

  <section id="tg-sb-book" class="tg-rp-section">
    <div class="tg-rp-wrap">
      <ol class="tg-sb-steps" data-sb-steps>
        <li class="is-active" data-sb-step-tab="1"><i>1</i>{{ st.step1_tab }}</li>
        <li data-sb-step-tab="2"><i>2</i>{{ st.step2_tab }}</li>
        <li data-sb-step-tab="3"><i>3</i>{{ st.step3_tab }}</li>
        <li data-sb-step-tab="4"><i>4</i>{{ st.step4_tab }}</li>
      </ol>

      <!-- STEP 1: service -->
      <div class="tg-sb-step is-active" data-sb-step="1">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step1_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step1_title }}</h2><p class="tg-rp-text">{{ st.step1_text }}</p></header>
        <div class="tg-sb-filter">
          <label class="tg-sb-search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg><input type="search" placeholder="{{ st.search_ph | escape }}" data-sb-search autocomplete="off"></label>
          <div class="tg-sb-chips" data-sb-chips>
            <button type="button" class="tg-rp-seg-btn is-active" data-sb-cat="">{{ st.all_label }}</button>
            {% for c in cat_list %}<button type="button" class="tg-rp-seg-btn" data-sb-cat="{{ c }}">{{ c }}</button>{% endfor %}
          </div>
        </div>
        <div class="tg-sb-list" data-sb-list>
          {% for c in cat_list %}
            <div class="tg-sb-group" data-sb-group="{{ c }}" hidden>
              <h3 class="tg-sb-group-title"><span>//</span> {{ c }}</h3>
              <div class="tg-sb-group-items{% if forloop.first %} tg-sb-cards{% else %} tg-sb-rows{% endif %}" data-sb-group-items></div>
            </div>
          {% endfor %}
          <p class="tg-sb-loading" data-sb-loading>{{ st.loading_text }}</p>
          <p class="tg-sb-empty" data-sb-empty hidden>{{ st.no_results }}</p>
        </div>
        <div class="tg-sb-sticky" data-sb-sticky hidden>
          <span class="tg-sb-sticky-sel"><em>{{ st.selected_label }}</em><strong data-sb-sticky-name></strong></span>
          <button type="button" class="tg-rp-btn tg-rp-btn--primary" data-sb-next disabled>{{ st.next_label }}</button>
        </div>
      </div>

      <!-- STEP 2: mechanic -->
      <div class="tg-sb-step" data-sb-step="2">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step2_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step2_title }}</h2><p class="tg-rp-text">{{ st.step2_text }}</p></header>
        <div class="tg-sb-cards tg-sb-cards--mech">
          <button type="button" class="tg-sb-card tg-sb-mech is-selected" data-sb-mechanic="any" data-name="{{ st.any_mechanic | escape }}">
            <span class="tg-sb-mech-avatar tg-sb-mech-avatar--any">{% render '2gether-ramps-icon', name: 'wrench' %}</span>
            <span class="tg-sb-card-top"><strong>{{ st.any_mechanic }}</strong></span><span class="tg-sb-card-desc">{{ st.any_mechanic_text }}</span>
          </button>
          {% for m in mechanics %}
            {% if m.active %}
              <button type="button" class="tg-sb-card tg-sb-mech" data-sb-mechanic="{{ m.system.handle }}" data-name="{{ m.name | escape }}">
                <span class="tg-sb-mech-avatar">{% if m.photo != blank %}{{ m.photo | image_url: width: 240 | image_tag: loading: 'lazy', class: 'tg-rp-cover' }}{% else %}{{ m.name | slice: 0, 1 }}{% endif %}</span>
                <span class="tg-sb-card-top"><strong>{{ m.name }}</strong></span>
                {% if m.specialties != blank %}<span class="tg-sb-card-desc">{{ m.specialties }}</span>{% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>
        <div class="tg-sb-nav"><button type="button" class="tg-rp-btn tg-rp-btn--ghost" data-sb-back>{{ st.back_label }}</button><button type="button" class="tg-rp-btn tg-rp-btn--primary" data-sb-next>{{ st.next_label }}</button></div>
      </div>

      <!-- STEP 3: date + time -->
      <div class="tg-sb-step" data-sb-step="3">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step3_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step3_title }}</h2><p class="tg-rp-text" data-sb-step3-text>{{ st.step3_text }}</p></header>
        <div class="tg-sb-datetime">
          <div class="tg-sb-cal" data-sb-cal>
            <div class="tg-sb-cal-head"><button type="button" data-sb-cal-prev aria-label="{{ 'tg.common.prev_month' | t }}">‹</button><strong data-sb-cal-title></strong><button type="button" data-sb-cal-next aria-label="{{ 'tg.common.next_month' | t }}">›</button></div>
            {%- assign sb_weekdays = 'tg.common.weekdays_short' | t | split: ',' -%}<div class="tg-sb-cal-week">{% for d in sb_weekdays %}<span>{{ d }}</span>{% endfor %}</div>
            <div class="tg-sb-cal-days" data-sb-cal-days></div>
            <p class="tg-sb-cal-note" data-sb-cal-note>{{ st.loading_text }}</p>
          </div>
          <div class="tg-sb-times">
            <h3 class="tg-rp-h3" data-sb-times-title>{{ st.pick_day_text }}</h3>
            <div class="tg-sb-time-groups" data-sb-times></div>
          </div>
        </div>
        <div class="tg-sb-nav"><button type="button" class="tg-rp-btn tg-rp-btn--ghost" data-sb-back>{{ st.back_label }}</button><button type="button" class="tg-rp-btn tg-rp-btn--primary" data-sb-next disabled>{{ st.next_label }}</button></div>
      </div>

      <!-- STEP 4: details -->
      <div class="tg-sb-step" data-sb-step="4">
        <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.step4_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.step4_title }}</h2></header>
        <div class="tg-sb-final">
          <form class="tg-sb-form" data-sb-form novalidate>
            <label><span>{{ st.f_name }}</span><input type="text" name="name" required autocomplete="name"></label>
            <label><span>{{ st.f_phone }}</span><input type="tel" name="phone" required autocomplete="tel"></label>
            <label><span>{{ st.f_email }}</span><input type="email" name="email" autocomplete="email"></label>
            <label><span>{{ st.f_bike }}</span><input type="text" name="bike" placeholder="{{ st.f_bike_ph | escape }}"></label>
            <label class="tg-sb-full"><span>{{ st.f_note }}</span><textarea name="note" rows="3" placeholder="{{ st.f_note_ph | escape }}"></textarea></label>
            <p class="tg-sb-error" data-sb-error hidden></p>
            <div class="tg-sb-nav"><button type="button" class="tg-rp-btn tg-rp-btn--ghost" data-sb-back>{{ st.back_label }}</button><button type="submit" class="tg-rp-btn tg-rp-btn--primary" data-sb-submit>{{ st.submit_label }}</button></div>
            <p class="tg-sb-note">{{ st.form_note }}</p>
          </form>
          <aside class="tg-sb-summary" data-sb-summary>
            <span class="tg-eyebrow">{{ st.summary_title }}</span>
            <dl>
              <div><dt>{{ st.step1_tab }}</dt><dd data-sum="service">—</dd></div>
              <div><dt>{{ st.step2_tab }}</dt><dd data-sum="mechanic">—</dd></div>
              <div><dt>{{ st.step3_tab }}</dt><dd data-sum="when">—</dd></div>
              <div class="tg-sb-sum-total"><dt>{{ st.sum_price }}</dt><dd data-sum="price">—</dd></div>
            </dl>
          </aside>
        </div>
      </div>

      <!-- DONE -->
      <div class="tg-sb-step tg-sb-done" data-sb-step="done">
        <div class="tg-sb-done-card">
          <span class="tg-eyebrow">{{ st.done_eyebrow }}</span>
          <h2 class="tg-rp-h2">{{ st.done_title }}</h2>
          <p class="tg-rp-text" data-sb-done-text></p>
          <p class="tg-sb-ref">№ <strong data-sb-ref></strong></p>
          <a href="{{ routes.root_url }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.done_cta }}</a>
        </div>
      </div>

      {%- comment -%} Fallback: e-mail the shop through Shopify when the worker is unreachable {%- endcomment -%}
      {%- form 'contact', id: 'tg-sb-fallback', class: 'tg-sb-fallback' -%}
        <input type="hidden" name="contact[type]" value="Service booking">
        <input type="hidden" name="contact[name]" data-fb="name"><input type="hidden" name="contact[phone]" data-fb="phone"><input type="hidden" name="contact[email]" data-fb="email"><input type="hidden" name="contact[details]" data-fb="details">
      {%- endform -%}
    </div>
  </section>

  <!-- PRICES -->
  {% if st.show_prices %}
  <section id="tg-sb-prices" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head tg-sb-prices-head"><div><span class="tg-eyebrow">{{ st.prices_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.prices_title }}</h2></div>
        <label class="tg-sb-search tg-sb-search--prices"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg><input type="search" placeholder="{{ st.search_ph | escape }}" data-sb-price-search autocomplete="off"></label>
      </header>
      <div class="tg-sb-pricelist" data-sb-pricelist>
        {% for c in cat_list %}
          <details class="tg-sb-pl-cat" data-sb-pl-cat data-cat="{{ c }}"{% if forloop.first %} open{% endif %} hidden>
            <summary><span class="tg-sb-pl-cat-name"><i>0{{ forloop.index }}</i>{{ cat_labels[forloop.index0] | default: c }}</span><span class="tg-sb-pl-cat-meta"><span data-sb-pl-count></span><b aria-hidden="true"></b></span></summary>
            <div class="tg-sb-pl-items" data-sb-pl-items></div>
          </details>
        {% endfor %}
        <p class="tg-sb-empty" data-sb-pl-empty hidden>{{ st.no_results }}</p>
      </div>
      <p class="tg-rp-text tg-sb-prices-note">{{ st.prices_note }}</p>
    </div>
  </section>
  {% endif %}
</div>

<script>
  window.TG_SB = {
    months: {{ 'tg.service_booking.months' | t | split: ',' | json }},
    t: { steps: {{ st.steps_word | json }}, stepsHint: {{ st.steps_hint | json }}, book: {{ st.book_label | json }}, ask: {{ st.ask_label | json }}, pickDay: {{ st.pick_day_text | json }}, noSlots: {{ st.no_slots_text | json }}, loading: {{ st.loading_text | json }}, free: {{ st.free_text | json }}, anyMech: {{ st.any_mechanic | json }}, errSlot: {{ st.err_slot | json }}, errGeneric: {{ st.err_generic | json }}, errFields: {{ st.err_fields | json }}, doneText: {{ st.done_text | json }}, doneFallback: {{ st.done_fallback | json }}, sending: {{ st.sending_label | json }} }
  };
</script>
<script>window.tgI18n = window.tgI18n || {}; window.tgI18n.serviceBooking = { steps: {{ 'tg.service_booking.steps' | t | json }}, book: {{ 'tg.service_booking.book' | t | json }}, ask: {{ 'tg.service_booking.ask' | t | json }} };</script>
<script src="{{ '2gether-service-booking.js' | asset_url }}" defer></script>

