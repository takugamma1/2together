{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

{%- liquid
  assign manual_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign manual_count = manual_count | plus: 1
    endif
  endfor
-%}

<section
  class="tg-reviews tg-section"
  data-tg-reviews="{{ section.id }}"
  data-endpoint="{{ section.settings.endpoint | default: '/apps/club/reviews' }}"
  data-min-rating="{{ section.settings.min_rating | default: 4 }}"
  data-max-reviews="{{ section.settings.max_reviews | default: 5 }}"
  data-fallback-maps="{{ section.settings.fallback_maps_url }}"
  data-manual-count="{{ manual_count }}"
>
  <header class="tg-reviews-head">
    <span class="tg-eyebrow">{{ section.settings.eyebrow | default: 'Отзиви' }}</span>
    <h2 class="tg-reviews-title">{{ section.settings.title | default: 'КАКВО КАЗВАТ ХОРАТА' }}</h2>
    {% if section.settings.intro != blank %}
      <p class="tg-reviews-intro">{{ section.settings.intro }}</p>
    {% endif %}
    <a class="tg-reviews-summary" data-tg-reviews-summary href="#" target="_blank" rel="noopener" hidden>
      <span class="tg-reviews-rating" data-tg-reviews-rating></span>
      <span class="tg-reviews-stars" data-tg-reviews-stars aria-hidden="true"></span>
      <span class="tg-reviews-count" data-tg-reviews-count></span>
      <span class="tg-reviews-g" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.5 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-2 3.2-4.9 3.2-7.8z"/><path fill="#34A853" d="M12 23c2.9 0 5.4-1 7.2-2.6l-3.6-2.7c-1 .7-2.3 1-3.6 1-2.8 0-5.1-1.9-6-4.4H2.3v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M6 14.3a6.6 6.6 0 0 1 0-4.2V7.3H2.3a11 11 0 0 0 0 9.8L6 14.3z"/><path fill="#EA4335" d="M12 5.5c1.6 0 3 .5 4.1 1.6l3.1-3.1A11 11 0 0 0 12 1 11 11 0 0 0 2.3 7.3L6 10.1c.9-2.5 3.2-4.6 6-4.6z"/></svg>
      </span>
    </a>
  </header>

  <div class="tg-reviews-nav">
    <button type="button" class="tg-reviews-arrow" data-tg-reviews-prev aria-label="Назад" disabled>
      <svg width="16" height="12" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 5H2M6 1 2 5l4 4"/></svg>
    </button>
    <button type="button" class="tg-reviews-arrow" data-tg-reviews-next aria-label="Напред" disabled>
      <svg width="16" height="12" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
    </button>
  </div>

  <div class="tg-reviews-track" data-tg-reviews-track tabindex="0" aria-label="{{ section.settings.title | default: 'Отзиви' | escape }}">
    {% for i in (1..3) %}
      <div class="tg-review-card tg-review-skeleton" data-tg-reviews-skeleton aria-hidden="true">
        <div class="tg-review-top"><span class="tg-sk tg-sk-photo"></span><span class="tg-sk tg-sk-line"></span></div>
        <span class="tg-sk tg-sk-line"></span>
        <span class="tg-sk tg-sk-line tg-sk-short"></span>
      </div>
    {% endfor %}
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        {%- assign b_rating = block.settings.rating | default: 5 -%}
        <article class="tg-review-card" data-manual {{ block.shopify_attributes }}>
          <div class="tg-review-top">
            <span class="tg-review-photo tg-review-photo--initials">{{ block.settings.author | strip | slice: 0, 1 | upcase }}</span>
            <div class="tg-review-meta">
              <span class="tg-review-author">{{ block.settings.author }}</span>
              {%- if block.settings.time != blank -%}
                <span class="tg-review-time">{{ block.settings.time }}</span>
              {%- endif -%}
            </div>
          </div>
          <span class="tg-review-stars" aria-label="{{ b_rating }} / 5">
            {%- for i in (1..5) -%}
              <span{% if i > b_rating %} class="tg-stars-empty"{% endif %}>★</span>
            {%- endfor -%}
          </span>
          <p class="tg-review-text">{{ block.settings.text }}</p>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {% if section.settings.cta_label != blank %}
    <a class="tg-reviews-cta" data-tg-reviews-cta href="{{ section.settings.fallback_maps_url | default: '#' }}" target="_blank" rel="noopener">
      {{ section.settings.cta_label }}
      <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
    </a>
  {% endif %}
</section>

<script>
(function () {
  var root = document.querySelector('[data-tg-reviews="{{ section.id }}"]');
  if (!root) return;

  var endpoint = root.getAttribute('data-endpoint');
  var minRating = parseInt(root.getAttribute('data-min-rating'), 10) || 0;
  var maxReviews = parseInt(root.getAttribute('data-max-reviews'), 10) || 5;
  var fallbackMaps = root.getAttribute('data-fallback-maps') || '';
  var manualCount = parseInt(root.getAttribute('data-manual-count'), 10) || 0;

  var track = root.querySelector('[data-tg-reviews-track]');
  var summary = root.querySelector('[data-tg-reviews-summary]');
  var ratingEl = root.querySelector('[data-tg-reviews-rating]');
  var starsEl = root.querySelector('[data-tg-reviews-stars]');
  var countEl = root.querySelector('[data-tg-reviews-count]');
  var ctaEl = root.querySelector('[data-tg-reviews-cta]');
  var prevBtn = root.querySelector('[data-tg-reviews-prev]');
  var nextBtn = root.querySelector('[data-tg-reviews-next]');

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function stars(n) {
    n = Math.round(n || 0);
    var out = '';
    for (var i = 1; i <= 5; i++) {
      out += '<span class="' + (i <= n ? '' : 'tg-stars-empty') + '">★</span>';
    }
    return out;
  }
  function removeSkeletons() {
    root.querySelectorAll('[data-tg-reviews-skeleton]').forEach(function (el) { el.remove(); });
  }
  function hide() { root.style.display = 'none'; }
  function fail() {
    // No Google data: keep any manually added reviews, hide otherwise.
    if (manualCount > 0) { removeSkeletons(); initCarousel(); } else { hide(); }
  }

  /* --- carousel controls (same pattern as the YouTube carousel) --- */
  function initCarousel() {
    function step() {
      var card = track.querySelector('.tg-review-card');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 16;
      return card.getBoundingClientRect().width + gap;
    }
    function update() {
      var maxScroll = track.scrollWidth - track.clientWidth - 2;
      prevBtn.disabled = track.scrollLeft <= 2;
      nextBtn.disabled = track.scrollLeft >= maxScroll;
    }
    function go(dir) {
      var from = track.scrollLeft;
      var target = from + dir * step();
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: target, behavior: reduced ? 'auto' : 'smooth' });
      setTimeout(function () {
        if (Math.abs(track.scrollLeft - from) < 4) track.scrollLeft = target;
        update();
      }, 250);
      setTimeout(update, 600);
    }
    prevBtn.addEventListener('click', function () { go(-1); });
    nextBtn.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  fetch(endpoint, { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
    .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function (data) {
      if (!data || data.error) return fail();

      var list = (data.reviews || []).filter(function (rv) {
        return (rv.rating || 0) >= minRating;
      }).slice(0, maxReviews);

      if (!list.length) return fail();

      var mapsUrl = data.mapsUrl || fallbackMaps || '#';

      // Summary
      if (typeof data.rating === 'number') {
        if (ratingEl) ratingEl.textContent = data.rating.toFixed(1);
        if (starsEl) starsEl.innerHTML = stars(data.rating);
        if (countEl) countEl.textContent = data.total ? '(' + data.total + ')' : '';
        if (summary) { summary.setAttribute('href', mapsUrl); summary.hidden = false; }
      }
      if (ctaEl && mapsUrl !== '#') ctaEl.setAttribute('href', mapsUrl);

      // Cards — Google reviews go in front of any manual ones.
      removeSkeletons();
      track.insertAdjacentHTML('afterbegin', list.map(function (rv) {
        var photo = rv.photo
          ? '<img class="tg-review-photo" src="' + esc(rv.photo) + '" alt="" loading="lazy" referrerpolicy="no-referrer">'
          : '<span class="tg-review-photo"></span>';
        return (
          '<article class="tg-review-card">' +
            '<div class="tg-review-top">' +
              photo +
              '<div class="tg-review-meta">' +
                '<span class="tg-review-author">' + esc(rv.author) + '</span>' +
                '<span class="tg-review-time">' + esc(rv.time) + '</span>' +
              '</div>' +
            '</div>' +
            '<span class="tg-review-stars" aria-label="' + (rv.rating || 0) + ' / 5">' + stars(rv.rating) + '</span>' +
            '<p class="tg-review-text">' + esc(rv.text) + '</p>' +
          '</article>'
        );
      }).join(''));

      initCarousel();
    })
    .catch(fail);
})();
</script>

{% stylesheet %}
  .tg-reviews {
    background: var(--tg-ink, #0B1220);
    color: var(--tg-text-primary, #E8ECF2);
    padding: var(--tg-s8, 64px) var(--tg-s7, 48px);
    font-family: 'General Sans', sans-serif;
  }

  .tg-reviews-head {
    max-width: 1280px;
    margin: 0 auto var(--tg-s4, 16px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--tg-s3, 12px);
  }

  .tg-reviews-title {
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--tg-text-primary, #E8ECF2);
    margin: 0;
  }

  .tg-reviews-intro {
    color: var(--tg-text-secondary, #B7C2D4);
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
  }

  .tg-reviews-summary {
    display: inline-flex;
    align-items: center;
    gap: var(--tg-s2, 8px);
    margin-top: var(--tg-s2, 8px);
    text-decoration: none;
  }
  .tg-reviews-summary[hidden] { display: none; }

  .tg-reviews-rating {
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: 26px;
    color: var(--tg-text-primary, #E8ECF2);
  }

  .tg-reviews-stars { color: var(--tg-flame, #E8601C); font-size: 18px; letter-spacing: 2px; }
  .tg-reviews-stars .tg-stars-empty,
  .tg-review-stars .tg-stars-empty { color: rgba(138, 155, 181, 0.32); }

  .tg-reviews-count { font-size: 13px; color: var(--tg-text-muted, #8A9BB5); }
  .tg-reviews-summary:hover .tg-reviews-count { color: var(--tg-flame, #E8601C); }
  .tg-reviews-g { display: inline-flex; align-items: center; }

  .tg-reviews-nav {
    max-width: 1280px;
    margin: 0 auto var(--tg-s3, 12px);
    display: flex;
    justify-content: flex-end;
    gap: var(--tg-s2, 8px);
  }

  .tg-reviews-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--tg-surface-raised, #121E34);
    border: 1px solid var(--tg-divider, rgba(138, 155, 181, 0.14));
    color: var(--tg-text-secondary, #8A9BB5);
    cursor: pointer;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    transition: color 150ms ease, border-color 150ms ease;
  }

  .tg-reviews-arrow:hover:not(:disabled) { color: var(--tg-flame, #E8601C); border-color: var(--tg-flame, #E8601C); }
  .tg-reviews-arrow:disabled { opacity: 0.35; cursor: default; }

  .tg-reviews-track {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    gap: var(--tg-s4, 16px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    align-items: stretch;
    padding: 4px 2px 10px;
  }

  .tg-reviews-track::-webkit-scrollbar { display: none; }
  .tg-reviews-track:focus-visible { outline: 1px solid var(--tg-flame, #E8601C); outline-offset: 4px; }

  .tg-review-card {
    flex: 0 0 clamp(280px, 30vw, 380px);
    scroll-snap-align: start;
    background: var(--tg-surface-raised, #121E34);
    border: 1px solid var(--tg-divider, rgba(138, 155, 181, 0.14));
    border-left: 2px solid var(--tg-flame, #E8601C);
    padding: var(--tg-s5, 24px);
    display: flex;
    flex-direction: column;
    gap: var(--tg-s3, 12px);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%);
  }

  .tg-review-top { display: flex; align-items: center; gap: var(--tg-s3, 12px); }

  .tg-review-photo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--tg-surface, #0D1526);
    display: block;
  }

  .tg-review-photo--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--tg-flame, #E8601C);
    border: 1px solid var(--tg-divider, rgba(138, 155, 181, 0.14));
  }

  .tg-review-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

  .tg-review-author {
    font-family: 'Technor', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: var(--tg-text-primary, #E8ECF2);
  }

  .tg-review-time { font-size: 11px; color: var(--tg-text-muted, #8A9BB5); }
  .tg-review-stars { color: var(--tg-flame, #E8601C); font-size: 14px; letter-spacing: 1px; }

  .tg-review-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--tg-text-secondary, #B7C2D4);
    margin: 0;
  }

  .tg-reviews-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    margin: var(--tg-s6, 32px) auto 0;
    padding: 14px 28px 14px 22px;
    background: var(--tg-flame, #E8601C);
    color: #0B1220;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
    transition: background 150ms ease;
  }
  .tg-reviews-cta:hover { background: #F47B3E; }

  /* Loading skeletons */
  .tg-sk { display: block; background: rgba(138, 155, 181, 0.12); border-radius: 4px; }
  .tg-sk-photo { width: 44px; height: 44px; border-radius: 50%; }
  .tg-sk-line { height: 12px; width: 100%; }
  .tg-sk-short { width: 60%; }
  .tg-review-skeleton { animation: tg-sk-pulse 1.2s ease-in-out infinite; }
  @keyframes tg-sk-pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }

  @media (max-width: 1024px) {
    .tg-reviews { padding: var(--tg-s6, 32px) var(--tg-s5, 24px); }
    .tg-review-card { flex-basis: clamp(270px, 42vw, 360px); }
  }
  @media (max-width: 640px) {
    .tg-reviews { padding: var(--tg-s6, 32px) var(--tg-s4, 16px); }
    .tg-reviews-track {
      margin: 0 calc(-1 * var(--tg-s4, 16px));
      padding-left: var(--tg-s4, 16px);
      padding-right: var(--tg-s4, 16px);
      scroll-padding-left: var(--tg-s4, 16px);
    }
    .tg-review-card { flex-basis: 80vw; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Google Reviews",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Отзиви" },
    { "type": "text", "id": "title", "label": "Title", "default": "КАКВО КАЗВАТ ХОРАТА" },
    { "type": "textarea", "id": "intro", "label": "Intro (optional)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Виж всички отзиви в Google" },
    { "type": "url", "id": "fallback_maps_url", "label": "Google listing URL (fallback)", "info": "Used for the button/summary link if Google doesn't return one." },
    { "type": "header", "content": "Source & filtering" },
    { "type": "text", "id": "endpoint", "label": "Reviews endpoint", "default": "/apps/club/reviews", "info": "Your Worker route behind the Shopify app proxy. Returns cached Google reviews." },
    { "type": "range", "id": "min_rating", "label": "Minimum stars to show", "min": 1, "max": 5, "step": 1, "default": 4, "info": "Hide reviews below this rating. Set to 1 to show everything." },
    { "type": "range", "id": "max_reviews", "label": "Max Google reviews", "min": 1, "max": 5, "step": 1, "default": 5, "info": "Google returns at most 5. Add more with 'Ръчен отзив' blocks — they show after the Google ones." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Ръчен отзив",
      "settings": [
        { "type": "text", "id": "author", "label": "Име", "default": "Име Фамилия" },
        { "type": "range", "id": "rating", "label": "Оценка", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Текст на отзива" },
        { "type": "text", "id": "time", "label": "Кога (напр. „преди 2 месеца”)" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "Google Reviews", "category": "Custom" }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  }
}
{% endschema %}
