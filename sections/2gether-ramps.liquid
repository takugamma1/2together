        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Flat-pack to your door anywhere in Bulgaria, free over €100. Outside BG by request." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portable Ramps",
      "category": "Custom",
      "blocks": [
        { "type": "feature", "settings": { "icon": "◣", "title": "Stackable", "text": "Slot together in seconds. Pack the whole kit in the trunk." } },
        { "type": "feature", "settings": { "icon": "◆", "title": "Anti-slip skin", "text": "Marine-grade textured surface. Grips in rain, mud, and powder." } },
        { "type": "feature", "settings": { "icon": "▲", "title": "Two-person setup", "text": "Lifted, set, ridden in under a minute. No tools." } },
        { "type": "feature", "settings": { "icon": "●", "title": "Steel-built", "text": "12mm welded frame. 120kg load rating. Won't flex under a sprint." } },
        { "type": "spec", "settings": { "label": "Frame", "value": "12mm welded steel" } },
        { "type": "spec", "settings": { "label": "Surface", "value": "Anti-slip composite" } },
        { "type": "spec", "settings": { "label": "Load rating", "value": "120 kg" } },
        { "type": "spec", "settings": { "label": "Weight (per ramp)", "value": "12 kg" } },
        { "type": "faq", "settings": { "question": "How do they ship?", "answer": "Flat-pack to your door anywhere in Bulgaria — free over €100 of ramps. Outside BG by request, we'll quote." } },
        { "type": "faq", "settings": { "question": "Can I mix and match ramps and stands?", "answer": "Yes. All our ramps fit any of our stands. Build the kit you need, scale later." } },
        { "type": "faq", "settings": { "question": "What's the warranty?", "answer": "2 years on welds, frame, and skin. If a part fails from normal use, we replace it." } },
        { "type": "faq", "settings": { "question": "Where do you make them?", "answer": "Welded and finished in Botevgrad, Bulgaria. We visit the workshop every month." } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
