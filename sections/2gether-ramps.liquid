{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-ramps.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-ramps-active');</script>

{%- liquid
  assign st = section.settings
  assign kpis = section.blocks | where: 'type', 'kpi'
  assign models = section.blocks | where: 'type', 'model'
  assign steps = section.blocks | where: 'type', 'step'
  assign terrains = section.blocks | where: 'type', 'terrain'
  assign details = section.blocks | where: 'type', 'detail'
  assign gallery = section.blocks | where: 'type', 'gallery'
  assign story_cols = section.blocks | where: 'type', 'story_col'
  assign supports = section.blocks | where: 'type', 'support'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign bundle = st.bundle_product
-%}
{%- capture rp_urls -%}{% render '2gether-ramps-urls', ramps_handle: page.handle, compare_handle: st.compare_page, support_handle: st.support_page, set_handle: st.set_page %}{%- endcapture -%}
{%- liquid
  assign rp_urls = rp_urls | strip | split: '|'
  assign compare_url = rp_urls[1]
  assign support_url = rp_urls[2]
  assign set_page_url = rp_urls[3]
  assign href_1 = request.path | append: '#' | append: st.tab_1_anchor | default: 'tg-ramps-lineup'
-%}

<div class="tg-ramps-page" id="tg-ramps-top">

  <!-- ═══ 01 HERO ═══ -->
  <section class="tg-rp-hero">
    <div class="tg-rp-wrap tg-rp-hero-grid">
      <div class="tg-rp-hero-copy">
        <span class="tg-eyebrow">{{ st.hero_eyebrow }}</span>
        <h1 class="tg-rp-h1">{{ st.hero_title | newline_to_br }}</h1>
        <p class="tg-rp-lead">{{ st.hero_sub }}</p>
        <div class="tg-rp-actions">
          {% if st.hero_cta1_text != blank %}<a href="{{ st.hero_cta1_link | default: compare_url }}" class="tg-rp-btn tg-rp-btn--primary">{{ st.hero_cta1_text }}</a>{% endif %}
          {% if st.hero_cta2_text != blank %}<a href="{{ st.hero_cta2_link | default: '#tg-ramps-transform' }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.hero_cta2_text }}</a>{% endif %}
        </div>
      </div>
      <figure class="tg-rp-hero-media">
        {% if st.hero_image != blank %}
          {{ st.hero_image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(max-width: 1024px) 100vw, 50vw', class: 'tg-rp-cover' }}
        {% else %}
          <div class="tg-rp-placeholder"></div>
        {% endif %}
        {% if st.hero_badge != blank %}<figcaption class="tg-rp-hero-badge">{{ st.hero_badge }}</figcaption>{% endif %}
      </figure>
    </div>
    {% if kpis.size > 0 %}
      <div class="tg-rp-wrap">
        <ul class="tg-rp-kpis" style="--cols: {{ kpis.size }}">
          {% for b in kpis %}
            <li {{ b.shopify_attributes }}><strong>{{ b.settings.value }}</strong><span>{{ b.settings.label }}</span></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </section>

  <!-- ═══ 02 LINEUP ═══ -->
  <section id="tg-ramps-lineup" class="tg-rp-section">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head tg-rp-head--split">
        <div>
          <span class="tg-eyebrow">{{ st.lineup_eyebrow }}</span>
          <h2 class="tg-rp-h2">{{ st.lineup_title }}</h2>
        </div>
        {% if st.lineup_cta_text != blank %}<a href="{{ compare_url }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.lineup_cta_text }}</a>{% endif %}
      </header>

      <div class="tg-rp-models" style="--cols: {{ models.size | at_least: 1 }}">
        {% for b in models %}
          {%- liquid
            assign p = b.settings.product
            assign price = b.settings.price
            if p != blank
              assign price = p.price | money
            endif
            assign img = b.settings.image
            if img == blank and p != blank
              assign img = p.featured_image
            endif
          -%}
          {%- capture url -%}{% render '2gether-ramps-product-url', product: p, link: b.settings.link, name: b.settings.name, set_url: set_page_url, fallback: compare_url %}{%- endcapture -%}
          {%- assign url = url | strip -%}
          <article class="tg-rp-model" style="--model: {{ b.settings.color | default: '#E8601C' }}" {{ b.shopify_attributes }}>
            <div class="tg-rp-model-media">
              {% if img != blank %}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 900px) 100vw, 50vw', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}
              <span class="tg-rp-corner" aria-hidden="true"></span>
            </div>
            <div class="tg-rp-model-body">
              <div class="tg-rp-model-top">
                <span class="tg-rp-tag">{{ b.settings.name }}</span>
                {% if price != blank %}<span class="tg-rp-price">{{ price }}</span>{% endif %}
              </div>
              <h3 class="tg-rp-h3">{{ b.settings.tagline }}</h3>
              <p class="tg-rp-text">{{ b.settings.description }}</p>
              <ul class="tg-rp-specs">
                {% if b.settings.weight != blank %}<li>{{ b.settings.weight }}</li>{% endif %}
                {% if b.settings.dims != blank %}<li>{{ b.settings.dims }}</li>{% endif %}
                {% if b.settings.range != blank %}<li>{{ b.settings.range }}</li>{% endif %}
                {% if b.settings.positions_label != blank %}<li>{{ b.settings.positions_label }}</li>{% endif %}
              </ul>
              <div class="tg-rp-model-choose">
                <h4>{{ b.settings.choose_title }}</h4>
                <p>{{ b.settings.choose_text }}</p>
              </div>
              {% if b.settings.cta_text != blank %}<a href="{{ url }}" class="tg-rp-btn tg-rp-btn--primary tg-rp-btn--sm">{{ b.settings.cta_text }}</a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ═══ 03 SET + COMPARE ═══ -->
  <section id="tg-ramps-compare" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      {%- liquid
        assign b_price = st.bundle_price
        assign b_compare = st.bundle_compare_price
        assign b_url = st.bundle_link
        if bundle != blank
          assign b_price = bundle.price | money
          if bundle.compare_at_price > bundle.price
            assign b_compare = bundle.compare_at_price | money
          endif
          if b_url == blank
            assign b_url = bundle.url
          endif
        endif
      -%}
      {%- capture b_url -%}{% render '2gether-ramps-product-url', product: bundle, link: b_url, name: 'BREEZE + STORM', set_url: set_page_url, fallback: set_page_url %}{%- endcapture -%}
      {%- assign b_url = b_url | strip -%}
      <div class="tg-rp-bundle">
        <div class="tg-rp-bundle-copy">
          <span class="tg-eyebrow">{{ st.bundle_eyebrow }}</span>
          <h2 class="tg-rp-h2 tg-rp-h2--sm">{{ st.bundle_title }}</h2>
          <p class="tg-rp-text">{{ st.bundle_text }}</p>
          <div class="tg-rp-bundle-price">
            {% if b_price != blank %}<strong>{{ b_price }}</strong>{% endif %}
            {% if b_compare != blank %}<s>{{ b_compare }}</s>{% endif %}
            {% if st.bundle_save != blank %}<span class="tg-rp-tag tg-rp-tag--flame">{{ st.bundle_save }}</span>{% endif %}
          </div>
        </div>
        {% if st.bundle_cta != blank %}<a href="{{ b_url }}" class="tg-rp-btn tg-rp-btn--primary">{{ st.bundle_cta }}</a>{% endif %}
      </div>

      {% if models.size > 0 %}
        <div class="tg-rp-table-wrap">
          <table class="tg-rp-table">
            <thead><tr>
              <th>{{ st.tbl_model | default: 'Модел' }}</th><th>{{ st.tbl_weight | default: 'Тегло' }}</th><th>{{ st.tbl_range | default: 'Диапазон' }}</th><th>{{ st.tbl_length | default: 'Дължина' }}</th><th>{{ st.tbl_price | default: 'Цена с ДДС' }}</th>
            </tr></thead>
            <tbody>
              {% for b in models %}
                {%- liquid
                  assign p = b.settings.product
                  assign price = b.settings.price
                  if p != blank
                    assign price = p.price | money
                  endif
                -%}
                <tr><th scope="row">{{ b.settings.name }}</th><td>{{ b.settings.weight }}</td><td>{{ b.settings.range }}</td><td>{{ b.settings.length_cm }} cm</td><td>{{ price }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- ═══ 04 POSITIONS ═══ -->
  {% if models.size > 0 %}
  <section id="tg-ramps-positions" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap tg-rp-pos-grid" data-rp-positions>
      <div class="tg-rp-pos-copy">
        <span class="tg-eyebrow">{{ st.pos_eyebrow }}</span>
        <h2 class="tg-rp-h2">{{ st.pos_title }}</h2>
        <p class="tg-rp-text">{{ st.pos_text }}</p>

        <div class="tg-rp-pos-control">
          <span class="tg-rp-pos-label">{{ st.pos_model_label | default: 'Модел' }}</span>
          <div class="tg-rp-seg" role="tablist" aria-label="{{ st.pos_model_label | default: 'Модел' }}">
            {% for b in models %}
              <button type="button" role="tab" class="tg-rp-seg-btn{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-rp-model data-name="{{ b.settings.name | escape }}" data-color="{{ b.settings.color | default: '#E8601C' }}" style="--model: {{ b.settings.color | default: '#E8601C' }}" data-length="{{ b.settings.length_cm | default: 130 }}" data-heights="{{ b.settings.heights | default: '29,32,35,38' | escape }}">{{ b.settings.name }}</button>
            {% endfor %}
          </div>
        </div>
        <div class="tg-rp-pos-control">
          <span class="tg-rp-pos-label">{{ st.pos_position_label | default: 'Позиция' }}</span>
          <div class="tg-rp-seg tg-rp-seg--num" role="tablist" aria-label="{{ st.pos_position_label | default: 'Позиция' }}">
            {% for i in (1..4) %}
              <button type="button" role="tab" class="tg-rp-seg-btn{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-rp-pos="{{ forloop.index0 }}">{{ i }}</button>
            {% endfor %}
          </div>
        </div>
      </div>

      {% render '2gether-ramps-stage', uid: section.id %}
    </div>
  </section>
  {% endif %}

  <!-- ═══ 05 TRANSFORMATION ═══ -->
  <section id="tg-ramps-transform" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap tg-rp-split">
      <figure class="tg-rp-media">
        {% if st.tf_image != blank %}{{ st.tf_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 1024px) 100vw, 55vw', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}
        {% if st.tf_video_label != blank and st.tf_video_url != blank %}
          <a class="tg-rp-play" href="{{ st.tf_video_url }}" {% if st.tf_video_url contains 'http' %}target="_blank" rel="noopener"{% endif %}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>{{ st.tf_video_label }}
          </a>
        {% endif %}
      </figure>
      <div class="tg-rp-split-copy">
        <span class="tg-eyebrow">{{ st.tf_eyebrow }}</span>
        <h2 class="tg-rp-h2">{{ st.tf_title }}</h2>
        <p class="tg-rp-text">{{ st.tf_text }}</p>
        {% if steps.size > 0 %}
          <ol class="tg-rp-steps">
            {% for b in steps %}
              <li {{ b.shopify_attributes }}>{% render '2gether-ramps-icon', name: b.settings.icon %}<span>{{ b.settings.label }}</span></li>
            {% endfor %}
          </ol>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- ═══ 06 TERRAINS ═══ -->
  {% if terrains.size > 0 %}
  <section class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.ter_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.ter_title }}</h2></header>
      <div class="tg-rp-cards" style="--cols: {{ terrains.size }}">
        {% for b in terrains %}
          <article class="tg-rp-card" {{ b.shopify_attributes }}>
            {% render '2gether-ramps-icon', name: b.settings.icon %}
            <h3 class="tg-rp-h3">{{ b.settings.title }}</h3>
            <p class="tg-rp-text">{{ b.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ═══ 07 DETAILS + GALLERY ═══ -->
  <section id="tg-ramps-details" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap tg-rp-split tg-rp-split--tight">
      <figure class="tg-rp-media tg-rp-media--square">
        {% if st.det_image != blank %}{{ st.det_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 1024px) 100vw, 45vw', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}
        {% if st.det_stamp_title != blank %}
          <div class="tg-rp-stamp"><small>{{ st.det_stamp_kicker }}</small><strong>{{ st.det_stamp_title }}</strong><span>{{ st.det_stamp_sub }}</span></div>
        {% endif %}
      </figure>
      <div class="tg-rp-split-copy">
        <span class="tg-eyebrow">{{ st.det_eyebrow }}</span>
        <h2 class="tg-rp-h2">{{ st.det_title }}</h2>
        <p class="tg-rp-text">{{ st.det_text }}</p>
        {% if details.size > 0 %}
          <ul class="tg-rp-details">
            {% for b in details %}
              <li {{ b.shopify_attributes }}>{% render '2gether-ramps-icon', name: b.settings.icon %}<div><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
    {% if gallery.size > 0 %}
      <div class="tg-rp-wrap">
        <div class="tg-rp-gallery">
          {% for b in gallery %}
            <figure {{ b.shopify_attributes }}>
              <div class="tg-rp-media">{% if b.settings.image != blank %}{{ b.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 900px) 100vw, 50vw', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}</div>
              <figcaption><h3 class="tg-rp-h3">{{ b.settings.title }}</h3><p class="tg-rp-text">{{ b.settings.text }}</p></figcaption>
            </figure>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>

  <!-- ═══ 08 STORY ═══ -->
  <section id="tg-ramps-story" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap tg-rp-split">
      <figure class="tg-rp-media">
        {% if st.story_image != blank %}{{ st.story_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 1024px) 100vw, 55vw', class: 'tg-rp-cover' }}{% else %}<div class="tg-rp-placeholder"></div>{% endif %}
        {% if st.story_video_label != blank and st.story_video_url != blank %}
          <a class="tg-rp-play" href="{{ st.story_video_url }}" {% if st.story_video_url contains 'http' %}target="_blank" rel="noopener"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>{{ st.story_video_label }}</a>
        {% endif %}
      </figure>
      <div class="tg-rp-split-copy">
        <span class="tg-eyebrow">{{ st.story_eyebrow }}</span>
        <h2 class="tg-rp-h2">{{ st.story_title }}</h2>
        <p class="tg-rp-text">{{ st.story_text }}</p>
        {% if story_cols.size > 0 %}
          <div class="tg-rp-cols" style="--cols: {{ story_cols.size }}">
            {% for b in story_cols %}<div {{ b.shopify_attributes }}><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div>{% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- ═══ 09 SUPPORT ═══ -->
  {% if supports.size > 0 %}
  <section id="tg-ramps-support" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap">
      <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.sup_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.sup_title }}</h2></header>
      <div class="tg-rp-cards" style="--cols: {{ supports.size }}">
        {% for b in supports %}
          <article class="tg-rp-card" {{ b.shopify_attributes }}>
            {% render '2gether-ramps-icon', name: b.settings.icon %}
            <h3 class="tg-rp-h3">{{ b.settings.title }}</h3>
            <p class="tg-rp-text">{{ b.settings.text }}</p>
            {% if b.settings.cta_text != blank %}<a href="{{ b.settings.cta_link | default: support_url }}" class="tg-rp-btn tg-rp-btn--{{ b.settings.cta_style | default: 'ghost' }} tg-rp-btn--sm">{{ b.settings.cta_text }}</a>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ═══ 10 FAQ ═══ -->
  {% if faqs.size > 0 %}
  <section id="tg-ramps-faq" class="tg-rp-section tg-rp-section--line">
    <div class="tg-rp-wrap tg-rp-wrap--narrow">
      <header class="tg-rp-head"><span class="tg-eyebrow">{{ st.faq_eyebrow }}</span><h2 class="tg-rp-h2">{{ st.faq_title }}</h2></header>
      <div class="tg-rp-faq">
        {% for b in faqs %}
          <details class="tg-rp-faq-item" {% if forloop.first %}open{% endif %} {{ b.shopify_attributes }}>
            <summary><span>{{ b.settings.question }}</span><i aria-hidden="true"></i></summary>
            <div class="tg-rp-faq-a">{{ b.settings.answer }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ═══ 11 CTA ═══ -->
  <section class="tg-rp-section tg-rp-section--line tg-rp-cta">
    <div class="tg-rp-wrap tg-rp-cta-inner">
      <span class="tg-eyebrow tg-eyebrow--center">{{ st.cta_eyebrow }}</span>
      <h2 class="tg-rp-h2">{{ st.cta_title }}</h2>
      <div class="tg-rp-actions tg-rp-actions--center">
        {% if st.cta1_text != blank %}<a href="{{ st.cta1_link | default: compare_url }}" class="tg-rp-btn tg-rp-btn--primary">{{ st.cta1_text }}</a>{% endif %}
        {% if st.cta2_text != blank %}<a href="{{ st.cta2_link | default: '/pages/contact' }}" class="tg-rp-btn tg-rp-btn--ghost">{{ st.cta2_text }}</a>{% endif %}
      </div>
    </div>
  </section>

  {% render '2gether-ramps-tabs', settings: section.settings, href_1: href_1, href_2: compare_url, href_3: support_url, brand_href: '/', hero_selector: '.tg-rp-hero' %}
</div>

<script src="{{ '2gether-ramps-positions.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Portable Ramps",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "01 · Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "2getherbikes Portable Ramps · Made in Bulgaria" },
    { "type": "textarea", "id": "hero_title", "label": "Title (line breaks allowed)", "default": "СЪЗДАЙ СПОТ.\nНАВСЯКЪДЕ." },
    { "type": "textarea", "id": "hero_sub", "label": "Subtitle", "default": "BREEZE и STORM се регулират в 4 позиции, сгъват се за 30 секунди и се носят на гръб." },
    { "type": "text", "id": "hero_cta1_text", "label": "Primary CTA", "default": "Сравни моделите" },
    { "type": "text", "id": "hero_cta1_link", "label": "Primary CTA link", "info": "Empty = comparison page" },
    { "type": "text", "id": "hero_cta2_text", "label": "Secondary CTA", "default": "Виж ги в действие" },
    { "type": "text", "id": "hero_cta2_link", "label": "Secondary CTA link", "default": "#tg-ramps-transform" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_badge", "label": "Image badge", "default": "Произведени в България" },

    { "type": "header", "content": "02 · Lineup" },
    { "type": "text", "id": "lineup_eyebrow", "label": "Eyebrow", "default": "Избери своята" },
    { "type": "text", "id": "lineup_title", "label": "Title", "default": "ДВА МОДЕЛА. РАЗЛИЧЕН ХАРАКТЕР." },
    { "type": "text", "id": "lineup_cta_text", "label": "Compare button", "default": "Пълно сравнение" },

    { "type": "header", "content": "03 · Set + comparison table" },
    { "type": "text", "id": "bundle_eyebrow", "label": "Eyebrow", "default": "Пълният спот" },
    { "type": "text", "id": "bundle_title", "label": "Title", "default": "BREEZE + STORM · TAKE-OFF & LANDING SET" },
    { "type": "textarea", "id": "bundle_text", "label": "Text", "default": "Използвай едната за изстрелване, а другата за приземяване. Или изгради два различни скока." },
    { "type": "page", "id": "set_page", "label": "Set page (Виж комплекта)", "info": "If empty, the theme finds the page using the ramps-set template" },
    { "type": "product", "id": "bundle_product", "label": "Set product (overrides the page)" },
    { "type": "text", "id": "bundle_price", "label": "Price (fallback if no product)", "default": "€590" },
    { "type": "text", "id": "bundle_compare_price", "label": "Compare-at price (fallback)", "default": "€645" },
    { "type": "text", "id": "bundle_save", "label": "Savings badge", "default": "Спестяваш €55" },
    { "type": "text", "id": "bundle_cta", "label": "CTA", "default": "Виж комплекта" },
    { "type": "url", "id": "bundle_link", "label": "CTA link (fallback)" },
    { "type": "text", "id": "tbl_model", "label": "Table: model column", "default": "Модел" },
    { "type": "text", "id": "tbl_weight", "label": "Table: weight column", "default": "Тегло" },
    { "type": "text", "id": "tbl_range", "label": "Table: range column", "default": "Диапазон" },
