      "label": "Origin label",
      "default": "MADE IN BOTEVGRAD · BULGARIA"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "PORTABLE"
    },
    {
      "type": "text",
      "id": "hero_title_accent",
      "label": "Title (flame accent)",
      "default": "RAMPS"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Subtitle",
      "default": "Take your line anywhere. Welded steel, anti-slip skin, stackable in seconds. Built by hand in Botevgrad — tested in the dirt every weekend."
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "Hero primary CTA",
      "default": "Shop the lineup"
    },
    {
      "type": "text",
      "id": "hero_secondary_text",
      "label": "Hero secondary CTA",
      "default": "See how we build them"
    },
    {
      "type": "url",
      "id": "hero_secondary_link",
      "label": "Hero secondary link"
    },
    {
      "type": "header",
      "content": "Hero KPIs (3 stats overlay)"
    },
    { "type": "text", "id": "kpi_1_value", "label": "KPI 1 value", "default": "12kg" },
    { "type": "text", "id": "kpi_1_label", "label": "KPI 1 label", "default": "Per ramp" },
    { "type": "text", "id": "kpi_2_value", "label": "KPI 2 value", "default": "120kg" },
    { "type": "text", "id": "kpi_2_label", "label": "KPI 2 label", "default": "Load rating" },
    { "type": "text", "id": "kpi_3_value", "label": "KPI 3 value", "default": "2 yr" },
    { "type": "text", "id": "kpi_3_label", "label": "KPI 3 label", "default": "Warranty" },
    {
      "type": "header",
      "content": "Lineup"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Ramps collection",
      "info": "Products in this collection are listed in the lineup grid. Use tags like 'spec:Length 240cm' on a product to surface a stat. Use 'badge:Best seller' for a tag pill."
    },
    {
      "type": "text",
      "id": "lineup_eyebrow",
      "label": "Eyebrow",
      "default": "The lineup"
    },
    {
      "type": "text",
      "id": "lineup_title",
      "label": "Title",
      "default": "PICK YOUR LINE"
    },
    {
      "type": "textarea",
      "id": "lineup_intro",
      "label": "Intro paragraph"
    },
    {
      "type": "header",
      "content": "Features (block-driven)"
    },
    { "type": "text", "id": "features_eyebrow", "label": "Eyebrow", "default": "Built right" },
    { "type": "text", "id": "features_title", "label": "Title", "default": "WHY OURS" },
    {
      "type": "header",
      "content": "Manufacturing story"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image (workshop)"
    },
    { "type": "text", "id": "story_eyebrow", "label": "Eyebrow", "default": "The shop" },
    { "type": "text", "id": "story_title", "label": "Title", "default": "WELDED BY HAND." },
    { "type": "text", "id": "story_title_em", "label": "Title (italic line)", "default": "Tested by us." },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story body",
      "default": "Each ramp is welded in a workshop in Botevgrad, then powder-coated and finished with an anti-slip skin. Before any unit ships, we ride it ourselves — at the shop, in the trails, on the Sunday rides. If a weld feels off, it goes back. Simple as that."
    },
