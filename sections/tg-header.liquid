{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

{%- liquid
  assign logo_text = section.settings.logo_text | default: shop.name
  assign current_path = request.path
  assign nav_menu = linklists[section.settings.menu]
  assign menu_links_count = 0
  if nav_menu and nav_menu.links
    assign menu_links_count = nav_menu.links.size
  endif
-%}

<tg-header class="tg-header" data-sticky="{{ section.settings.sticky }}" style="--tg-logo-size: {{ section.settings.logo_size | default: 36 }}px;">
  <div class="tg-header-inner">
    <a href="{{ routes.root_url }}" class="tg-header-brand" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 240 | image_tag: class: 'tg-header-logo', loading: 'eager', alt: shop.name }}
      {% else %}
        <span class="tg-header-wordmark">{{ logo_text }}</span>
      {% endif %}
    </a>

    <div class="tg-header-actions">
      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="tg-header-icon" aria-label="Търсене">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg>
        </a>
      {% endif %}
      {% if section.settings.show_account %}
        <a href="{{ routes.account_url }}" class="tg-header-icon" aria-label="Профил">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {% endif %}
      {%- comment -%} Real link so the cart stays reachable without JS — the click handler upgrades it to the drawer. {%- endcomment -%}
      <a href="{{ routes.cart_url }}" class="tg-header-icon tg-header-cart" aria-label="Количка" aria-controls="tg-cart-drawer" data-tg-cart-open>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="tg-header-cart-count" data-tg-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      <button type="button" class="tg-header-burger" aria-label="Отвори менюто" aria-expanded="false" aria-controls="tg-takeover" data-tg-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Full-screen navigation takeover -->
  <div id="tg-takeover" class="tg-takeover" data-tg-takeover hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Основна навигация">
    <div class="tg-takeover-backdrop" data-tg-takeover-close></div>

    <div class="tg-takeover-inner">
      <div class="tg-takeover-head">
        <button type="button" class="tg-takeover-close" data-tg-takeover-close aria-label="Затвори менюто">
          <span>{{ section.settings.close_label | default: 'Затвори' }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      {%- liquid
        assign nav_tile_count = 0
        for block in section.blocks
          if block.type == 'nav_tile'
            assign nav_tile_count = nav_tile_count | plus: 1
          endif
        endfor
      -%}

      <div class="tg-takeover-grid" data-tg-takeover-grid>
        {% if menu_links_count > 0 %}
          {%- comment -%} Menu mode — drive tiles from the configured Shopify menu, enrich with matching nav_tile blocks {%- endcomment -%}
          {% for link in nav_menu.links %}
            {%- liquid
              assign matched_block = null
              assign positional_block = null
              assign nav_tile_position = 0

              assign link_handle_norm = link.handle | downcase | strip
              assign link_title_plain = link.title | downcase | strip

              for block in section.blocks
                if block.type != 'nav_tile'
                  continue
                endif
                assign nav_tile_position = nav_tile_position | plus: 1

                comment
                  Track the block at this menu link's position as a fallback,
                  so blocks added in the same order as the menu Just Work.
                  NB: inside this inner loop `forloop` is the BLOCK loop —
                  the menu link's position lives on forloop.parentloop.
                endcomment
                if nav_tile_position == forloop.parentloop.index and positional_block == null
                  assign positional_block = block
                endif

                if block.settings.link_handle != blank and matched_block == null
                  assign block_match = block.settings.link_handle | downcase | strip
                  assign block_match_slug = block_match | replace: ' ', '-'
                  if block_match == link_handle_norm or block_match == link_title_plain or block_match_slug == link_handle_norm
                    assign matched_block = block
                  endif
                endif
              endfor

              if matched_block == null
                assign matched_block = positional_block
              endif

              assign auto_num = forloop.index | prepend: '0' | slice: -2, 2
              assign tile_num = matched_block.settings.number | default: auto_num
              assign tile_descriptor = matched_block.settings.descriptor
              assign tile_image = matched_block.settings.image

              assign is_active = false
              if link.active
                assign is_active = true
              elsif current_path != '/' and link.url == current_path
                assign is_active = true
              endif
            -%}
            <a href="{{ link.url }}" class="tg-takeover-tile{% if is_active %} is-active{% endif %}" {% if matched_block %}{{ matched_block.shopify_attributes }}{% endif %} style="--tg-tile-i: {{ forloop.index0 }};">
              <div class="tg-takeover-tile-media">
                {% if tile_image != blank %}
                  {{ tile_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: link.title, sizes: '(max-width: 768px) 100vw, 33vw' }}
                {% else %}
                  <div class="tg-takeover-tile-placeholder" aria-hidden="true"></div>
                {% endif %}
                <div class="tg-takeover-tile-overlay"></div>
              </div>
              <div class="tg-takeover-tile-info">
                <span class="tg-takeover-tile-num">{{ tile_num }}</span>
                <span class="tg-takeover-tile-title">{{ link.title }}</span>
                {% if tile_descriptor != blank %}
                  <span class="tg-takeover-tile-desc">{{ tile_descriptor }}</span>
                {% endif %}
                <span class="tg-takeover-tile-arrow" aria-hidden="true">
                  <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M0 5h20M16 1l4 4-4 4"/>
                  </svg>
                </span>
              </div>
            </a>
          {% endfor %}

        {% elsif nav_tile_count > 0 %}
          {%- comment -%} Block mode — no menu selected, render nav_tile blocks directly {%- endcomment -%}
          {% for block in section.blocks %}
            {% if block.type == 'nav_tile' %}
              {%- liquid
                assign tile_link = block.settings.link | default: '#'
                assign is_active = false
                if current_path != '/' and tile_link == current_path
                  assign is_active = true
                endif
                assign auto_num = forloop.index | prepend: '0' | slice: -2, 2
              -%}
              <a href="{{ tile_link }}" class="tg-takeover-tile{% if is_active %} is-active{% endif %}" {{ block.shopify_attributes }} style="--tg-tile-i: {{ forloop.index0 }};">
                <div class="tg-takeover-tile-media">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.title, sizes: '(max-width: 768px) 100vw, 33vw' }}
                  {% else %}
                    <div class="tg-takeover-tile-placeholder" aria-hidden="true"></div>
                  {% endif %}
                  <div class="tg-takeover-tile-overlay"></div>
                </div>
                <div class="tg-takeover-tile-info">
                  <span class="tg-takeover-tile-num">{{ block.settings.number | default: auto_num }}</span>
                  <span class="tg-takeover-tile-title">{{ block.settings.title | default: 'Category' }}</span>
                  {% if block.settings.descriptor != blank %}
                    <span class="tg-takeover-tile-desc">{{ block.settings.descriptor }}</span>
                  {% endif %}
                  <span class="tg-takeover-tile-arrow" aria-hidden="true">
                    <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M0 5h20M16 1l4 4-4 4"/>
                    </svg>
                  </span>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          {%- comment -%} Fallback so the menu works before the merchant configures anything {%- endcomment -%}
          {%- assign default_tiles = 'Е-МАГАЗИН|Велосипеди, аксесоари и мърч|/collections||СЕРВИЗ|Ремонт, профилактика, настройка|/pages/bike-service||НАЕМ НА КОЛЕЛА|Дневен и седмичен наем|/pages/bike-rental||МЪРЧ|Тениски, джърсита, аксесоари|/collections/march-c199||РАМПИ|Преносими рампи 2GETHER|/pages/portable-ramps||SUNDAY CLUB|Неделни групови карания|/pages/sunday-club' | split: '||' -%}
          {% for entry in default_tiles %}
            {%- assign parts = entry | split: '|' -%}
            {%- assign t_num = forloop.index | prepend: '0' | slice: -2, 2 -%}
            {%- assign t_link = parts[2] | default: '#' | strip -%}
            <a href="{{ t_link }}" class="tg-takeover-tile" style="--tg-tile-i: {{ forloop.index0 }};">
              <div class="tg-takeover-tile-media">
                <div class="tg-takeover-tile-placeholder" aria-hidden="true"></div>
                <div class="tg-takeover-tile-overlay"></div>
              </div>
              <div class="tg-takeover-tile-info">
                <span class="tg-takeover-tile-num">{{ t_num }}</span>
                <span class="tg-takeover-tile-title">{{ parts[0] }}</span>
                <span class="tg-takeover-tile-desc">{{ parts[1] }}</span>
                <span class="tg-takeover-tile-arrow" aria-hidden="true">
                  <svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M0 5h20M16 1l4 4-4 4"/>
                  </svg>
                </span>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>

      {% if section.settings.takeover_footer_text != blank %}
        <div class="tg-takeover-foot">
          <span class="tg-takeover-foot-text">{{ section.settings.takeover_footer_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- ── Cart drawer (sliced) ── -->
  <div id="tg-cart-drawer" class="tg-cart-drawer" data-tg-cart-drawer data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-collections-url="{{ routes.collections_url }}" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ section.settings.cart_title | default: 'Количка' }}">
    <div class="tg-cart-drawer-backdrop" data-tg-cart-close></div>
    <aside class="tg-cart-drawer-panel">
      <header class="tg-cart-drawer-head">
        <div class="tg-cart-drawer-head-text">
          <span class="tg-cart-drawer-eyebrow">{{ section.settings.cart_title | default: 'Количка' }}</span>
          <span class="tg-cart-drawer-count"><span data-tg-cart-drawer-count>{{ cart.item_count }}</span> {{ cart.item_count | pluralize: 'артикул', 'артикула' }}</span>
        </div>
        <button type="button" class="tg-cart-drawer-close" data-tg-cart-close aria-label="Затвори количката">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </header>

      <div class="tg-cart-drawer-body" data-tg-cart-body>
        <div class="tg-cart-drawer-loading" data-tg-cart-loading>
          <span></span><span></span><span></span>
        </div>
      </div>

      <footer class="tg-cart-drawer-foot" data-tg-cart-foot>
        <div class="tg-cart-drawer-subtotal">
          <span>{{ section.settings.cart_subtotal_label | default: 'Междинна сума' }}</span>
          <strong data-tg-cart-subtotal>{{ cart.total_price | money }}</strong>
        </div>
        <a href="{{ routes.cart_url }}/checkout" class="tg-cart-drawer-checkout" data-tg-cart-checkout>
          {{ section.settings.cart_checkout_label | default: 'Към плащане' }}
          <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" class="tg-cart-drawer-view">{{ section.settings.cart_view_label | default: 'Виж цялата количка' }}</a>
      </footer>
    </aside>
  </div>
</tg-header>

{% schema %}
{
  "name": "2Gether Header",
  "tag": "header",
  "class": "tg-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Wordmark (used if no logo image)",
      "default": "2GETHER"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "header",
      "content": "Header actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation takeover"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Source menu",
      "default": "main-menu",
      "info": "Top-level links from this menu drive the takeover tiles. Add a Navigation tile block below and match its handle to attach an image and descriptor to a specific link."
    },
    {
      "type": "text",
      "id": "takeover_footer_text",
      "label": "Footer line (optional)"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Menu close button",
      "default": "Затвори"
    },
    {
      "type": "text",
      "id": "cart_title",
      "label": "Cart drawer title",
      "default": "Количка"
    },
    {
      "type": "text",
      "id": "cart_subtotal_label",
      "label": "Cart subtotal label",
      "default": "Междинна сума"
    },
    {
      "type": "text",
      "id": "cart_checkout_label",
      "label": "Checkout button",
      "default": "Към плащане"
    },
    {
      "type": "text",
      "id": "cart_view_label",
      "label": "View full cart link",
      "default": "Виж цялата количка"
    }
  ],
  "blocks": [
    {
      "type": "nav_tile",
      "name": "Navigation tile",
      "limit": 8,
      "settings": [
        {
          "type": "paragraph",
          "content": "Attach an image and descriptor to a menu link. Leave 'Match' blank to bind this block to the menu link in the same position. Or type the link's title or handle to bind explicitly. Or fill in title + link below to use this block standalone (when no source menu is selected)."
        },
        {
          "type": "text",
          "id": "link_handle",
          "label": "Match menu link",
          "info": "Type the menu link's title (e.g. \"Сервиз на колела\") or handle (e.g. \"bicycles\"). Leave blank to bind by position."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image"
        },
        {
          "type": "text",
          "id": "descriptor",
          "label": "Descriptor (1 line)"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number override",
          "info": "Defaults to position (01, 02, …)"
        },
        {
          "type": "header",
          "content": "Standalone (no source menu) only"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "2Gether Header",
      "blocks": [
        {
          "type": "nav_tile",
          "settings": {
            "link_handle": "Е-МАГАЗИН",
            "title": "Е-МАГАЗИН",
            "descriptor": "Велосипеди, аксесоари и мърч",
            "link": "/collections"
          }
        },
        {
          "type": "nav_tile",
          "settings": {
            "link_handle": "СЕРВИЗ",
            "title": "СЕРВИЗ",
            "descriptor": "Ремонт, профилактика, настройка",
            "link": "/pages/bike-service"
          }
        },
        {
          "type": "nav_tile",
          "settings": {
            "link_handle": "НАЕМ НА КОЛЕЛА",
            "title": "НАЕМ НА КОЛЕЛА",
            "descriptor": "Дневен и седмичен наем",
            "link": "/pages/bike-rental"
          }
        },
        {
          "type": "nav_tile",
          "settings": {
            "link_handle": "МЪРЧ",
            "title": "МЪРЧ",
            "descriptor": "Тениски, джърсита, аксесоари",
            "link": "/collections/march-c199"
          }
        },
        {
          "type": "nav_tile",
          "settings": {
            "link_handle": "РАМПИ",
            "title": "РАМПИ",
            "descriptor": "Преносими рампи 2GETHER",
            "link": "/pages/portable-ramps"
          }
        },
        {
          "type": "nav_tile",
          "settings": {
            "link_handle": "SUNDAY CLUB",
            "title": "SUNDAY CLUB",
            "descriptor": "Неделни групови карания",
            "link": "/pages/sunday-club"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  tg-header {
    display: block;
    position: relative;
    z-index: 100;
    background: #0B1220;
    color: #E8ECF2;
    font-family: 'General Sans', sans-serif;
    isolation: isolate;
  }

  /* Stickiness is handled by #header-group in 2gether-custom.css —
     this attribute is read there via :has(). */

  .tg-header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 18px 48px;
    min-height: 88px;
    border-bottom: 1px solid rgba(138, 155, 181, 0.12);
    background: inherit;
  }

  /* Brand */
  .tg-header-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .tg-header-logo {
    display: block;
    max-height: var(--tg-logo-size, 36px);
    width: auto;
  }

  .tg-header-wordmark {
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    color: #E8ECF2;
  }

  .tg-header-wordmark::first-letter {
    color: #E8601C;
  }

  /* Header actions */
  .tg-header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tg-header-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #E8ECF2;
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    cursor: pointer;
    transition: color 150ms ease, background 150ms ease;
  }

  .tg-header-icon:hover {
    background: rgba(232, 96, 28, 0.12);
    color: #FFA468;
  }

  .tg-header-cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: #E8601C;
    color: #0B1220;
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .tg-header-cart-count[hidden] { display: none; }

  /* Burger — always visible, morphs to X when open */
  .tg-header-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 8px;
    margin-left: 4px;
  }

  .tg-header-burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: #E8ECF2;
    transform-origin: center;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
                opacity 200ms ease;
  }

  .tg-header-burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .tg-header-burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .tg-header-burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ════════════════════════════════════
     FULL-SCREEN NAVIGATION TAKEOVER
     ════════════════════════════════════ */
  .tg-takeover {
    position: fixed;
    inset: 0;
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0s linear 320ms;
  }

  .tg-takeover[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0s linear 0s;
  }

  .tg-takeover[hidden] { display: none; }

  .tg-takeover-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 18, 32, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .tg-takeover-inner {
    position: relative;
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 32px 48px 48px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Head: just the close button on the right */
  .tg-takeover-head {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 24px;
    flex-shrink: 0;
  }

  .tg-takeover-close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    background: transparent;
    border: 1px solid rgba(138, 155, 181, 0.2);
    color: #E8ECF2;
    font-family: 'General Sans', sans-serif;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
  }

  .tg-takeover-close:hover {
    border-color: #E8601C;
    color: #E8601C;
    background: rgba(232, 96, 28, 0.06);
  }

  /* Tiles grid — fills the available height as 3 cols × 2 rows on desktop */
  .tg-takeover-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 16px;
    flex: 1 1 auto;
    min-height: 0;
  }

  /* Tile — sliced corner cut, hero image, info bottom-left */
  .tg-takeover-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #121E34;
    text-decoration: none;
    color: inherit;
    min-height: 200px;
    /* Sliced top-right corner cut — brand signature */
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);
    transform: translateY(24px);
    opacity: 0;
    transition: transform 460ms cubic-bezier(0.16, 1, 0.3, 1),
                opacity 320ms ease,
                filter 280ms ease;
    /* Stagger via per-tile index */
    --tg-stagger-base: 60ms;
    --tg-stagger-step: 50ms;
  }

  .tg-takeover[data-open='true'] .tg-takeover-tile {
    transform: translateY(0);
    opacity: 1;
    transition-delay: calc(var(--tg-stagger-base) + (var(--tg-tile-i, 0) * var(--tg-stagger-step)));
  }

  /* Tile media */
  .tg-takeover-tile-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .tg-takeover-tile-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1),
                filter 320ms ease;
    filter: brightness(0.7);
  }

  .tg-takeover-tile-placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, rgba(232, 96, 28, 0.08) 0%, transparent 60%),
      repeating-linear-gradient(45deg, rgba(138, 155, 181, 0.04) 0 12px, transparent 12px 24px),
      #121E34;
  }

  .tg-takeover-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 18, 32, 0.92) 0%,
      rgba(11, 18, 32, 0.55) 35%,
      rgba(11, 18, 32, 0.2) 65%,
      transparent 100%
    );
    pointer-events: none;
    transition: background 280ms ease;
  }

  /* Tile info */
  .tg-takeover-tile-info {
    position: relative;
    z-index: 2;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #E8ECF2;
  }

  .tg-takeover-tile-num {
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #E8601C;
    margin-bottom: 4px;
    transition: transform 320ms ease;
  }

  .tg-takeover-tile-title {
    font-family: 'Technor', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2vw, 28px);
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-transform: uppercase;
    color: #E8ECF2;
    position: relative;
    padding-bottom: 6px;
  }

  /* Flame underline that slides in from the left on hover */
  .tg-takeover-tile-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 36px;
    height: 2px;
    background: #E8601C;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tg-takeover-tile-desc {
    font-size: 13px;
    color: #8A9BB5;
    line-height: 1.4;
    max-width: 280px;
  }

  .tg-takeover-tile-arrow {
    display: inline-flex;
    align-items: center;
    margin-top: 6px;
    color: #E8601C;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 280ms ease, transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Active tile (current page) — permanent flame underline + dot */
  .tg-takeover-tile.is-active .tg-takeover-tile-title::after {
    transform: scaleX(1);
  }

  .tg-takeover-tile.is-active::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 28px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E8601C;
    box-shadow: 0 0 14px rgba(232, 96, 28, 0.7);
    z-index: 3;
  }

  /* ── SPOTLIGHT HOVER (pointer devices only) ──
     When any tile is hovered, dim+desaturate the others, brighten the focused one.
     Gated behind hover/pointer so touch scrolling on mobile never triggers the
     dim+grayscale spotlight — that "sticky hover" was the greyish glitch. */
  @media (hover: hover) and (pointer: fine) {
    .tg-takeover-grid:has(.tg-takeover-tile:hover) .tg-takeover-tile:not(:hover) {
      opacity: 0.45;
      filter: grayscale(0.55);
    }

    .tg-takeover-tile:hover .tg-takeover-tile-media img {
      transform: scale(1.06);
      filter: brightness(0.85);
    }

    .tg-takeover-tile:hover .tg-takeover-tile-overlay {
      background: linear-gradient(
        to top,
        rgba(11, 18, 32, 0.78) 0%,
        rgba(11, 18, 32, 0.35) 40%,
        rgba(11, 18, 32, 0.12) 70%,
        transparent 100%
      );
    }

    .tg-takeover-tile:hover .tg-takeover-tile-title::after {
      transform: scaleX(1);
    }

    .tg-takeover-tile:hover .tg-takeover-tile-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    .tg-takeover-tile:hover .tg-takeover-tile-num {
      transform: translateX(2px);
    }
  }

  /* Keyboard focus = same as hover */
  .tg-takeover-tile:focus-visible {
    outline: 2px solid #E8601C;
    outline-offset: -2px;
  }

  .tg-takeover-grid:has(.tg-takeover-tile:focus-visible) .tg-takeover-tile:not(:focus-visible) {
    opacity: 0.45;
    filter: grayscale(0.55);
  }

  .tg-takeover-tile:focus-visible .tg-takeover-tile-title::after {
    transform: scaleX(1);
  }

  .tg-takeover-tile:focus-visible .tg-takeover-tile-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Footer line (optional) */
  .tg-takeover-foot {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(138, 155, 181, 0.12);
    flex-shrink: 0;
  }

  .tg-takeover-foot-text {
    font-size: 12px;
    color: #566A85;
    letter-spacing: 0.04em;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tg-header-inner {
      padding: 12px 20px;
      min-height: 64px;
    }

    .tg-takeover-inner {
      padding: 24px 24px 32px;
    }

    /* 2 cols × 3 rows; let tiles take a fixed aspect since the panel scrolls */
    .tg-takeover-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: 14px;
      flex: 0 0 auto;
    }

    .tg-takeover-tile {
      min-height: 220px;
      aspect-ratio: 4 / 5;
    }

    .tg-takeover-tile-info {
      padding: 20px;
    }
  }

  @media (max-width: 640px) {
    .tg-takeover-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .tg-takeover-tile {
      min-height: 160px;
      aspect-ratio: 16 / 10;
    }

    .tg-takeover-tile-title {
      font-size: 22px;
    }
  }

  @media (max-width: 480px) {
    .tg-header-inner { padding: 10px 16px; min-height: 56px; }
    .tg-header-actions { gap: 0; }
    .tg-header-icon { width: 36px; height: 36px; }
    .tg-takeover-inner { padding: 20px 16px 28px; }
    .tg-takeover-head { margin-bottom: 16px; }
    .tg-takeover-close span { display: none; }
    .tg-takeover-close { padding: 10px 12px; }
  }

  /* Reduced motion: drop scale + stagger */
  @media (prefers-reduced-motion: reduce) {
    .tg-takeover-tile,
    .tg-takeover-tile-media img,
    .tg-takeover-tile-arrow,
    .tg-takeover-tile-num,
    .tg-takeover-tile-title::after {
      transition: none !important;
      transform: none !important;
    }
    .tg-takeover[data-open='true'] .tg-takeover-tile {
      transform: none;
      opacity: 1;
    }
  }

  /* ════════════════════════════════════
     CART DRAWER — sliced, slides from right
     ════════════════════════════════════ */
  .tg-cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 250;
    opacity: 0;
    visibility: hidden;
    transition: opacity 280ms ease, visibility 0s linear 280ms;
  }

  .tg-cart-drawer[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 280ms ease, visibility 0s linear 0s;
  }

  .tg-cart-drawer[hidden] { display: none; }

  .tg-cart-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 18, 32, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Sliced left edge — diagonal cut on the panel itself */
  .tg-cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 92vw);
    background: #0D1526;
    color: #E8ECF2;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -16px 0 40px rgba(0, 0, 0, 0.5);
    /* Top-left corner cut — brand slash */
    clip-path: polygon(28px 0, 100% 0, 100% 100%, 0 100%, 0 28px);
  }

  .tg-cart-drawer[data-open='true'] .tg-cart-drawer-panel {
    transform: translateX(0);
