  .tg-cart-drawer-loading span:nth-child(2) { animation-delay: 0.15s; }
  .tg-cart-drawer-loading span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes tg-cart-pulse {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* Empty state */
  .tg-cart-drawer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
