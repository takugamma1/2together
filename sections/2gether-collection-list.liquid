{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-collection-list.css' | asset_url | stylesheet_tag }}
{{ '2gether-search.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-collections-active');</script>

{%- liquid
  assign st = section.settings
  assign departments = section.blocks | where: 'type', 'department'
  assign finders = section.blocks | where: 'type', 'finder'
  assign highlights = section.blocks | where: 'type', 'highlight'
-%}

<div class="tg-hub" data-tg-hub>
  <div class="tg-rp-wrap">

    <!-- ═══ HEAD: title + instant search ═══ -->
    <header class="tg-hub-head">
      <div>
        {% if st.eyebrow != blank %}<span class="tg-eyebrow">{{ st.eyebrow }}</span>{% endif %}
        <h1 class="tg-hub-title">{{ st.title }}</h1>
      </div>
      <form class="tg-hub-search" action="{{ routes.search_url }}" method="get" role="search" data-tg-suggest>
        <input type="hidden" name="type" value="product">
        <label class="tg-search-bar tg-hub-search-bar" for="tg-hub-q">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m20.5 20.5-4-4"/></svg>
          <input type="search" id="tg-hub-q" name="q" placeholder="{{ st.search_placeholder }}" autocomplete="off" data-tg-hub-q data-tg-cl-search>
          <kbd aria-hidden="true">{{ 'tg.collection_list.enter_hint' | t }}</kbd>
        </label>
        <p class="tg-hub-search-hint" data-tg-hub-hint aria-live="polite"></p>
      </form>
    </header>

    <!-- ═══ DEPARTMENT CHIPS ═══ -->
    <nav class="tg-hub-chips" aria-label="{{ 'tg.collection_list.departments' | t }}" data-tg-hub-chips>
      {% for b in departments %}
        <a href="#dept-{{ b.id }}" class="tg-hub-chip" data-tg-hub-chip="dept-{{ b.id }}" style="--model: {{ b.settings.color }}">{% render '2gether-ramps-icon', name: b.settings.icon %}<span>{{ b.settings.title }}</span></a>
      {% endfor %}
      {% if st.show_brands %}<a href="#dept-brands" class="tg-hub-chip" data-tg-hub-chip="dept-brands" style="--model: #8A9BB5"><span>{{ st.brands_title }}</span></a>{% endif %}
      {% for b in highlights %}{% if b.settings.collection != blank %}<a href="{{ b.settings.collection.url }}" class="tg-hub-chip tg-hub-chip--sale" style="--model: #E8601C"><span>{{ b.settings.title }}</span></a>{% endif %}{% endfor %}
    </nav>

    <!-- ═══ HIGHLIGHT (sale) TILE ═══ -->
    {% for b in highlights %}
      {%- assign hc = b.settings.collection -%}
      {%- if hc != blank -%}
        {%- assign max_pct = 0 -%}
        {%- for prod in hc.products limit: 50 -%}
          {%- if prod.compare_at_price > prod.price and prod.compare_at_price > 0 -%}
            {%- assign diff = prod.compare_at_price | minus: prod.price | times: 100 -%}
            {%- assign pct = diff | divided_by: prod.compare_at_price -%}
            {%- if pct > max_pct -%}{%- assign max_pct = pct -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <section class="tg-hub-sale" {{ b.shopify_attributes }}>
          <div class="tg-hub-sale-body">
            {% if b.settings.eyebrow != blank %}<span class="tg-hub-sale-eyebrow">{{ b.settings.eyebrow }}</span>{% endif %}
            <h2 class="tg-hub-sale-title">{{ b.settings.title }}</h2>
            {% if b.settings.text != blank %}<p class="tg-hub-sale-text">{{ b.settings.text }}</p>{% endif %}
            <a href="{{ hc.url }}" class="tg-btn-primary tg-hub-sale-cta">{{ b.settings.cta_label }} &rarr;</a>
          </div>
          <a href="{{ hc.url }}" class="tg-hub-sale-stat" aria-label="{{ b.settings.title | escape }}">
            {% if max_pct > 0 %}<span class="tg-hub-sale-pct"><small>{{ 'tg.collection_list.sale_upto' | t }}</small>-{{ max_pct }}%</span>{% endif %}
            <span class="tg-hub-sale-count">{{ 'tg.common.products_count' | t: count: hc.products_count }}</span>
          </a>
        </section>
      {%- elsif request.design_mode -%}
        <p class="tg-hub-empty">{{ 'tg.collection_list.highlight_pick' | t }}</p>
      {%- endif -%}
    {% endfor %}

    <!-- ═══ QUICK FINDERS ═══ -->
    {% if finders.size > 0 %}
      <section class="tg-hub-finders" aria-label="{{ st.finders_title | escape }}">
        <span class="tg-hub-finders-label">{{ st.finders_title }}</span>
        <div class="tg-hub-finders-track">
          {% for b in finders %}
            <a href="{{ b.settings.url }}" class="tg-hub-finder" {{ b.shopify_attributes }}>
              <strong>{{ b.settings.label }}</strong>{% if b.settings.kicker != blank %}<small>{{ b.settings.kicker }}</small>{% endif %}
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- ═══ DEPARTMENTS ═══ -->
    {% for b in departments %}
      {%- assign items = b.settings.items | newline_to_br | split: '<br />' -%}
      <section class="tg-hub-dept" id="dept-{{ b.id }}" data-tg-hub-dept style="--model: {{ b.settings.color }}" {{ b.shopify_attributes }}>
        <header class="tg-hub-dept-head">
          <div class="tg-hub-dept-icon">{% render '2gether-ramps-icon', name: b.settings.icon %}</div>
          <div>
            <h2 class="tg-hub-dept-title">{{ b.settings.title }}</h2>
            {% if b.settings.text != blank %}<p class="tg-hub-dept-text">{{ b.settings.text }}</p>{% endif %}
          </div>
        </header>
        <div class="tg-hub-grid">
          {% for line in items %}
            {%- assign parts = line | strip | split: '|' -%}
            {%- assign h = parts[0] | strip -%}
            {%- if h == blank -%}{%- continue -%}{%- endif -%}
            {%- assign c = collections[h] -%}
            {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
            {%- assign label = parts[1] | default: c.title | strip -%}
            {%- assign kw = parts[2] | default: '' -%}
            <a href="{{ c.url }}" class="tg-hub-card" data-tg-hub-card data-search="{{ label | downcase | escape }} {{ c.title | downcase | escape }} {{ kw | downcase | escape }} {{ b.settings.title | downcase | escape }}">
              <span class="tg-hub-card-media">
                {% if c.image != blank %}{{ c.image | image_url: width: 480 | image_tag: loading: 'lazy', class: 'tg-rp-cover' }}{% elsif c.products.first.featured_image != blank %}{{ c.products.first.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', class: 'tg-rp-cover' }}{% else %}<span class="tg-hub-card-ph">{% render '2gether-ramps-icon', name: b.settings.icon %}</span>{% endif %}
              </span>
              <span class="tg-hub-card-body">
                <span class="tg-hub-card-title">{{ label }}</span>
                {% if label != c.title %}<span class="tg-hub-card-sub">{{ c.title }}</span>{% endif %}
                <span class="tg-hub-card-count">{{ 'tg.common.products_count' | t: count: c.products_count }}</span>
              </span>
            </a>
          {% endfor %}
        </div>
        <p class="tg-hub-empty" data-tg-hub-empty hidden>{{ 'tg.collection_list.empty_department' | t }}</p>
      </section>
    {% endfor %}

    <!-- ═══ BRANDS A–Z ═══ -->
    {% if st.show_brands %}
      <section class="tg-hub-dept tg-hub-dept--brands" id="dept-brands" data-tg-hub-dept style="--model: #8A9BB5">
        <header class="tg-hub-dept-head">
          <div class="tg-hub-dept-icon">{% render '2gether-ramps-icon', name: 'grip' %}</div>
          <div><h2 class="tg-hub-dept-title">{{ st.brands_title }}</h2>{% if st.brands_text != blank %}<p class="tg-hub-dept-text">{{ st.brands_text }}</p>{% endif %}</div>
        </header>
        <div class="tg-hub-brands">
          {% for c in collections %}
            {% if c.handle contains 'brand-' and c.products_count > 0 %}
              <a href="{{ c.url }}" class="tg-hub-brand" data-tg-hub-card data-search="{{ c.title | downcase | escape }} марка brand">{{ c.title }}<small>{{ c.products_count }}</small></a>
            {% endif %}
          {% endfor %}
        </div>
        <p class="tg-hub-empty" data-tg-hub-empty hidden>{{ 'tg.collection_list.empty_brands' | t }}</p>
      </section>
    {% endif %}

    <p class="tg-hub-none" data-tg-hub-none hidden>{{ 'tg.collection_list.none_match' | t }} <button type="submit" form="tg-hub-form-proxy" class="tg-hub-none-btn" data-tg-hub-submit>{{ 'tg.collection_list.search_products' | t }} →</button></p>
  </div>
</div>

<script>
  window.tgI18n = window.tgI18n || {};
  window.tgI18n.search = {
    {%- capture tg_qph -%}{q}{%- endcapture -%}
    suggestEmpty: {{ 'tg.search.suggest_empty' | t: query: tg_qph | json }},
    products: {{ 'tg.search.suggest_products' | t | json }},
    collections: {{ 'tg.common.categories' | t | json }},
    viewAll: {{ 'tg.search.suggest_all' | t | json }},
    searchUrl: {{ routes.search_url | json }}
  };
</script>
<script src="{{ '2gether-search.js' | asset_url }}" defer></script>
<script>
(() => {
  const hub = document.querySelector('[data-tg-hub]'); if (!hub) return;
  const q = hub.querySelector('[data-tg-hub-q]'), hint = hub.querySelector('[data-tg-hub-hint]');
  const cards = [...hub.querySelectorAll('[data-tg-hub-card]')];
  const depts = [...hub.querySelectorAll('[data-tg-hub-dept]')];
  const chips = [...hub.querySelectorAll('[data-tg-hub-chip]')];
  const none = hub.querySelector('[data-tg-hub-none]');
  const norm = (s) => (s || '').toLowerCase().replace(/ё/g, 'е').trim();
  const catWord = (n) => n === 1 ? {{ 'tg.collection_list.category_word' | t: count: 1 | json }} : {{ 'tg.collection_list.category_word' | t: count: 2 | json }};
  const enterHint = {{ 'tg.collection_list.enter_for_products' | t | json }};
  const lat2cyr = { a:'а', b:'б', v:'в', g:'г', d:'д', e:'е', z:'з', i:'и', k:'к', l:'л', m:'м', n:'н', o:'о', p:'п', r:'р', s:'с', t:'т', u:'у', f:'ф', h:'х', c:'ц' };
  const filter = () => {
    const val = norm(q.value); const terms = val.split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach(c => { const hay = c.dataset.search; const ok = terms.every(t => hay.includes(t)); c.hidden = !ok; if (ok) shown++; });
    depts.forEach(d => { const vis = [...d.querySelectorAll('[data-tg-hub-card]')].some(c => !c.hidden); d.classList.toggle('is-empty', !vis); const e = d.querySelector('[data-tg-hub-empty]'); if (e) e.hidden = true; d.hidden = terms.length > 0 && !vis; });
    chips.forEach(ch => { const d = document.getElementById(ch.dataset.tgHubChip); ch.classList.toggle('is-dim', !!(d && d.hidden)); });
    if (none) none.hidden = !(terms.length && shown === 0);
    if (hint) hint.textContent = terms.length ? (shown ? `${shown} ${catWord(shown)} ${enterHint}` : '') : '';
    hub.classList.toggle('is-searching', terms.length > 0);
  };
  q.addEventListener('input', filter);
  q.addEventListener('keydown', (e) => { if (e.key === 'Escape') { q.value = ''; filter(); } });
  const submitBtn = hub.querySelector('[data-tg-hub-submit]');
  if (submitBtn) submitBtn.addEventListener('click', (e) => { e.preventDefault(); q.form.submit(); });
  // chips: smooth scroll + active state via scroll-spy
  chips.forEach(ch => ch.addEventListener('click', (e) => { const d = document.getElementById(ch.dataset.tgHubChip); if (!d) return; e.preventDefault(); d.scrollIntoView({ behavior: 'smooth', block: 'start' }); history.replaceState(null, '', '#' + ch.dataset.tgHubChip); }));
  const spy = () => { let cur = null; const line = window.innerHeight * 0.35; depts.forEach(d => { if (!d.hidden && d.getBoundingClientRect().top <= line) cur = d.id; }); chips.forEach(ch => ch.classList.toggle('is-active', ch.dataset.tgHubChip === cur)); };
  window.addEventListener('scroll', spy, { passive: true }); spy();
  if (location.hash) { const d = document.getElementById(location.hash.slice(1)); d && setTimeout(() => d.scrollIntoView({ block: 'start' }), 50); }
})();
</script>

{% schema %}
{
  "name": "2Gether Collection List",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "t:tg.d.collection_list.eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "t:tg.d.collection_list.title"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "t:tg.d.collection_list.search_placeholder"
    },
    {
      "type": "text",
      "id": "finders_title",
      "label": "Quick finders label",
      "default": "t:tg.d.collection_list.finders_title"
    },
    {
      "type": "checkbox",
      "id": "show_brands",
      "label": "Show brands A–Z (collections with handle brand-*)",
      "default": true
    },
    {
      "type": "text",
      "id": "brands_title",
      "label": "Brands title",
      "default": "t:tg.d.collection_list.brands_title"
    },
    {
      "type": "text",
      "id": "brands_text",
      "label": "Brands text",
      "default": "t:tg.d.collection_list.brands_text"
    }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "t:tg.d.collection_list.b_department.title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Short text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "fold",
          "options": [
            {
              "value": "ride",
              "label": "Bike"
            },
            {
              "value": "wheel",
              "label": "Wheel"
            },
            {
              "value": "fold",
              "label": "Parts"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "carry",
              "label": "Clothing"
            },
            {
              "value": "pin",
              "label": "Pin"
            },
            {
              "value": "jump",
              "label": "Jump"
            },
            {
              "value": "landing",
              "label": "Landing"
            },
            {
              "value": "grip",
              "label": "Grid"
            },
            {
              "value": "book",
              "label": "Book"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Accent",
          "default": "#E8601C"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Collections (one per line: handle | Bulgarian label | search keywords)",
          "info": "Collections with 0 products are skipped automatically."
        }
      ]
    },
    {
      "type": "highlight",
      "name": "Sale tile",
      "limit": 2,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "t:tg.d.collection_list.b_highlight.eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "default": "t:tg.d.collection_list.b_highlight.title" },
        { "type": "text", "id": "text", "label": "Text", "default": "t:tg.d.collection_list.b_highlight.text" },
        { "type": "text", "id": "cta_label", "label": "Button", "default": "t:tg.d.collection_list.b_highlight.cta_label" }
      ]
    },
    {
      "type": "finder",
      "name": "Quick finder",
      "limit": 16,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "t:tg.d.collection_list.b_finder.label"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "t:tg.d.collection_list.b_finder.kicker"
        },
        {
          "type": "text",
          "id": "url",
          "label": "URL (collection, optionally /tag-a+tag-b)",
          "default": "/collections/tires-tubes-od20/tyre-size-29"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "2Gether Collection List"
    }
  ]
}
{% endschema %}
