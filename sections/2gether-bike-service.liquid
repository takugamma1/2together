{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{{ '2gether-bike-service.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link href="https://api.fontshare.com/v2/css?f[]=technor@400,500,600,700&f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
{% # theme-check-enable RemoteAsset %}

<script>document.body.classList.add('tg-service-active');</script>

<div class="tg-service-page">

  <!-- ═══ HERO ═══ -->
  <section class="tg-service-hero">
    <div class="tg-service-hero-media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', sizes: '100vw', class: 'tg-service-hero-img' }}
      {% else %}
        <div class="tg-service-hero-placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="tg-service-hero-overlay"></div>
    </div>
    <div class="tg-service-hero-content">
      <span class="tg-eyebrow">{{ section.settings.hero_eyebrow | default: 'Bike service' }}</span>
      <h1 class="tg-service-hero-title">
        {{ section.settings.hero_title | default: 'BOOK YOUR' }} <span>{{ section.settings.hero_title_accent | default: 'SERVICE' }}</span>
      </h1>
      <p class="tg-service-hero-sub">{{ section.settings.hero_sub | default: 'Tell us what is wrong, pick a time, drop the bike off. We handle the rest.' }}</p>
      <a href="#tg-service-book" class="tg-service-hero-cta">
        {{ section.settings.hero_cta | default: 'Book now' }}
        <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
      </a>
    </div>
  </section>

  <!-- ═══ BOOKING FORM ═══ -->
  <section id="tg-service-book" class="tg-service-book">
    <aside class="tg-service-book-media">
      {% if section.settings.form_image != blank %}
        {{ section.settings.form_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '50vw', class: 'tg-service-book-img' }}
      {% else %}
        <div class="tg-service-hero-placeholder" aria-hidden="true"></div>
      {% endif %}
      <div class="tg-service-book-media-info">
        <span class="tg-eyebrow">{{ section.settings.form_caption_eyebrow | default: 'Workshop' }}</span>
        <p>{{ section.settings.form_caption | default: 'Hands-on by certified mechanics. Most jobs done in 24h.' }}</p>
      </div>
    </aside>

    <div class="tg-service-book-form-wrap">
      <header class="tg-service-book-head">
        <span class="tg-eyebrow">{{ section.settings.form_eyebrow | default: 'Step 1 of 1' }}</span>
        <h2 class="tg-service-book-title">{{ section.settings.form_title | default: 'TELL US WHAT IS WRONG' }}</h2>
      </header>

      {%- form 'contact', id: 'tg-service-form', class: 'tg-service-form', data-tg-wizard: '' -%}
        <input type="hidden" name="contact[type]" value="Bike service booking">

        {% if form.posted_successfully? %}
          <div class="tg-service-form-ok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            {{ section.settings.form_success | default: 'Thanks — we got your booking. We will reply within 24h to confirm.' }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="tg-service-form-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <!-- Progress bar -->
        <div class="tg-wizard-progress">
          <div class="tg-wizard-progress-track">
            <div class="tg-wizard-progress-fill" data-tg-wizard-fill style="width: 33%"></div>
          </div>
          <div class="tg-wizard-progress-steps">
            <span class="tg-wizard-step-label is-active" data-tg-step-label="1">
              <span class="tg-wizard-step-dot">1</span>
              <span>{{ section.settings.step1_label | default: 'Date & time' }}</span>
            </span>
            <span class="tg-wizard-step-label" data-tg-step-label="2">
              <span class="tg-wizard-step-dot">2</span>
              <span>{{ section.settings.step2_label | default: 'The problem' }}</span>
            </span>
            <span class="tg-wizard-step-label" data-tg-step-label="3">
              <span class="tg-wizard-step-dot">3</span>
              <span>{{ section.settings.step3_label | default: 'Your details' }}</span>
            </span>
          </div>
        </div>

        <!-- ── STEP 1: DATE & TIME ── -->
        <div class="tg-wizard-step is-active" data-tg-step="1">
          <header class="tg-wizard-step-head">
            <span class="tg-wizard-step-num">{{ section.settings.step1_eyebrow | default: '01 · Booking' }}</span>
            <h3 class="tg-wizard-step-title">{{ section.settings.step1_title | default: 'When can you bring it in?' }}</h3>
            <p class="tg-wizard-step-sub">{{ section.settings.step1_sub | default: 'Pick a day and a time slot. We will confirm by email within 24h.' }}</p>
          </header>

          <div class="tg-booking-grid">
            <div class="tg-service-field tg-service-field--full">
              <span class="tg-service-field-label">{{ section.settings.date_label | default: 'Date' }}</span>

              <!-- Custom calendar picker -->
              <div class="tg-cal" data-tg-cal>
                <div class="tg-cal-head">
                  <button type="button" class="tg-cal-nav" data-tg-cal-prev aria-label="Previous month">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                  </button>
                  <span class="tg-cal-title" data-tg-cal-title aria-live="polite"></span>
                  <button type="button" class="tg-cal-nav" data-tg-cal-next aria-label="Next month">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  </button>
                </div>
                <div class="tg-cal-weekdays" aria-hidden="true">
                  <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
                </div>
                <div class="tg-cal-grid" data-tg-cal-grid role="grid">
                  <!-- Filled by JS -->
                </div>
                <p class="tg-cal-selected" data-tg-cal-selected>
                  <span class="tg-cal-selected-empty">Pick a day above</span>
                </p>
              </div>

              <!-- Hidden field populated by the calendar -->
              <input type="hidden" name="contact[preferred_date]" data-tg-cal-input data-tg-validate required>
            </div>

            <fieldset class="tg-service-field tg-service-field--full">
              <legend class="tg-service-field-label">{{ section.settings.timeslot_label | default: 'Time slot' }}</legend>
              <div class="tg-slot-grid">
                {% assign slots = section.settings.time_slots | default: 'Morning|9:00 — 12:00||Afternoon|12:00 — 16:00||Evening|16:00 — 19:00' | split: '||' %}
                {% for slot in slots %}
                  {%- assign sp = slot | split: '|' -%}
                  <label class="tg-slot">
                    <input type="radio" name="contact[preferred_time]" value="{{ sp[0] | strip }} ({{ sp[1] | strip }})" required data-tg-validate>
                    <span class="tg-slot-name">{{ sp[0] | strip }}</span>
                    <span class="tg-slot-hours">{{ sp[1] | strip }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>

            <label class="tg-service-field tg-service-field--full">
              <span class="tg-service-field-label">{{ section.settings.flexibility_label | default: 'How flexible are you?' }}</span>
              <div class="tg-radio-grid tg-radio-grid--inline">
                <label class="tg-radio">
                  <input type="radio" name="contact[flexibility]" value="{{ section.settings.flex_yes | default: 'Soonest free slot is fine' }}" checked>
                  <span class="tg-radio-dot"></span>
                  <span class="tg-radio-label">{{ section.settings.flex_yes | default: 'Soonest free slot is fine' }}</span>
                </label>
                <label class="tg-radio">
                  <input type="radio" name="contact[flexibility]" value="{{ section.settings.flex_no | default: 'Only the slot above' }}">
                  <span class="tg-radio-dot"></span>
                  <span class="tg-radio-label">{{ section.settings.flex_no | default: 'Only the slot above' }}</span>
                </label>
              </div>
            </label>
          </div>

          <div class="tg-wizard-actions">
            <span></span>
            <button type="button" class="tg-wizard-btn tg-wizard-btn--next" data-tg-next>
              {{ section.settings.step1_next | default: 'Next: The problem' }}
              <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
            </button>
          </div>
        </div>

        <!-- ── STEP 2: THE PROBLEM ── -->
        <div class="tg-wizard-step" data-tg-step="2">
          <header class="tg-wizard-step-head">
            <span class="tg-wizard-step-num">{{ section.settings.step2_eyebrow | default: '02 · Diagnostics' }}</span>
            <h3 class="tg-wizard-step-title">{{ section.settings.step2_title | default: 'What is wrong with the bike?' }}</h3>
            <p class="tg-wizard-step-sub">{{ section.settings.step2_sub | default: 'The more we know up front, the faster we get you back on the road.' }}</p>
          </header>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.problem_area_label | default: 'Problem area' }}</span>
            <select name="contact[problem_area]" required data-tg-validate>
              <option value="" disabled selected>{{ section.settings.problem_area_placeholder | default: 'Pick the part of the bike' }}</option>
              {%- assign area_opts = section.settings.problem_area_options | default: 'Brakes / Спирачки
Drivetrain — gears, chain / Трансмисия
Wheels & tires / Капли и гуми
Suspension — fork or shock / Окачване
Frame & bearings / Рамка и лагери
Electric system (e-bike) / Електрика
Full service package / Пакетно обслужване
Other / I am not sure / Друго' | newline_to_br | split: '<br />' -%}
              {%- for opt in area_opts -%}
                {%- assign opt_clean = opt | strip_newlines | strip -%}
                {%- if opt_clean != blank -%}
                  <option value="{{ opt_clean | escape }}">{{ opt_clean }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </label>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.symptoms_label | default: 'Symptoms (pick all that apply)' }}</span>
            <div class="tg-checkbox-grid">
              {%- assign symptoms = section.settings.symptoms_list | default: "Strange noise
Brakes feel weak
Skips gears or won't shift
Tire flat or slow leak
Wheel wobble / out of true
Loose / play in a part
Crash damage
Won't turn on (e-bike)
Annual tune-up" | newline_to_br | split: '<br />' -%}
              {% for symptom in symptoms %}
                {%- assign symptom_clean = symptom | strip_newlines | strip -%}
                {%- if symptom_clean != blank -%}
                  <label class="tg-check">
                    <input type="checkbox" name="contact[symptoms][]" value="{{ symptom_clean | escape }}">
                    <span class="tg-check-box"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>
                    <span class="tg-check-label">{{ symptom_clean }}</span>
                  </label>
                {%- endif -%}
              {% endfor %}
            </div>
          </label>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.issue_started_label | default: 'When did the issue start?' }}</span>
            <select name="contact[issue_started]">
              <option value="" disabled selected>{{ section.settings.issue_started_placeholder | default: 'Pick one' }}</option>
              {%- assign issue_opts = section.settings.issue_options | default: 'Today
This week
This month
Months ago — got worse over time
Don''t remember' | newline_to_br | split: '<br />' -%}
              {%- for opt in issue_opts -%}
                {%- assign opt_clean = opt | strip_newlines | strip -%}
                {%- if opt_clean != blank -%}
                  <option value="{{ opt_clean | escape }}">{{ opt_clean }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </label>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.describe_label | default: 'Describe it in your own words' }}</span>
            <textarea name="contact[problem_description]" rows="3" placeholder="{{ section.settings.describe_placeholder | default: 'When did it start? Anything else that helps us prepare?' }}" required data-tg-validate></textarea>
          </label>

          <div class="tg-wizard-actions">
            <button type="button" class="tg-wizard-btn tg-wizard-btn--back" data-tg-back>
              <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 5H2M6 1L2 5l4 4"/></svg>
              {{ section.settings.back_label | default: 'Back' }}
            </button>
            <button type="button" class="tg-wizard-btn tg-wizard-btn--next" data-tg-next>
              {{ section.settings.step2_next | default: 'Next: Your details' }}
              <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
            </button>
          </div>
        </div>

        <!-- ── STEP 3: YOUR DETAILS ── -->
        <div class="tg-wizard-step" data-tg-step="3">
          <header class="tg-wizard-step-head">
            <span class="tg-wizard-step-num">{{ section.settings.step3_eyebrow | default: '03 · Contact' }}</span>
            <h3 class="tg-wizard-step-title">{{ section.settings.step3_title | default: 'How do we reach you?' }}</h3>
            <p class="tg-wizard-step-sub">{{ section.settings.step3_sub | default: 'We will email a confirmation and call only if we need extra info.' }}</p>
          </header>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.bike_label | default: 'Bike (make / model)' }}</span>
            <input type="text" name="contact[bike]" placeholder="{{ section.settings.bike_placeholder | default: 'e.g. hardtail MTB, 2022' }}">
          </label>

          <label class="tg-service-field">
            <span class="tg-service-field-label">{{ section.settings.name_label | default: 'Your name' }}</span>
            <input type="text" name="contact[name]" required data-tg-validate>
          </label>

          <label class="tg-service-field">
            <span class="tg-service-field-label">{{ section.settings.phone_label | default: 'Phone' }}</span>
            <input type="tel" name="contact[phone]" required data-tg-validate>
          </label>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.email_label | default: 'Email' }}</span>
            <input type="email" name="contact[email]" required data-tg-validate>
          </label>

          <label class="tg-service-field tg-service-field--full">
            <span class="tg-service-field-label">{{ section.settings.notes_label | default: 'Anything else?' }}</span>
            <textarea name="contact[notes]" rows="2" placeholder="{{ section.settings.notes_placeholder | default: 'Optional — anything you would like us to know.' }}"></textarea>
          </label>

          <div class="tg-wizard-actions">
            <button type="button" class="tg-wizard-btn tg-wizard-btn--back" data-tg-back>
              <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 5H2M6 1L2 5l4 4"/></svg>
              {{ section.settings.back_label | default: 'Back' }}
            </button>
            <button type="submit" class="tg-service-form-submit">
              {{ section.settings.form_submit | default: 'Book service' }}
              <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
            </button>
          </div>
        </div>

        <p class="tg-service-form-note">
          {{ section.settings.form_note | default: 'We will reply within 24h to confirm the slot. Drop-off only — no on-site repairs while you wait.' }}
        </p>
      {%- endform -%}
    </div>
  </section>

  <!-- ═══ PRICING ACCORDION ═══ -->
  {%- liquid
    assign pricing_count = 0
    for block in section.blocks
      if block.type == 'pricing_category'
        assign pricing_count = pricing_count | plus: 1
      endif
    endfor
  -%}

  {% if pricing_count > 0 %}
    <section id="tg-service-prices" class="tg-service-prices" style="scroll-margin-top: 100px;">
      <header class="tg-service-prices-head">
        <span class="tg-eyebrow">{{ section.settings.prices_eyebrow | default: 'Our rates' }}</span>
        <h2 class="tg-service-prices-title">{{ section.settings.prices_title | default: 'PRICES & PACKAGES' }}</h2>
        {% if section.settings.prices_intro != blank %}
          <p class="tg-service-prices-intro">{{ section.settings.prices_intro }}</p>
        {% endif %}
      </header>

      <div class="tg-service-prices-list">
        {% for block in section.blocks %}
          {% if block.type == 'pricing_category' %}
            <details class="tg-price-cat" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
              <summary class="tg-price-cat-head">
                <span class="tg-price-cat-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="tg-price-cat-name">{{ block.settings.name }}</span>
                <span class="tg-price-cat-toggle" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <ul class="tg-price-cat-body">
                {%- assign rows = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for row in rows -%}
                  {%- assign line = row | strip -%}
                  {%- if line == '' -%}{%- continue -%}{%- endif -%}
                  {%- assign parts = line | split: '|' -%}
                  <li class="tg-price-row">
                    <span class="tg-price-row-name">{{ parts[0] | strip }}</span>
                    <span class="tg-price-row-prices">
                      {% if parts.size > 1 %}<span class="tg-price-row-bgn">{{ parts[1] | strip }} лв.</span>{% endif %}
                      {% if parts.size > 2 %}<span class="tg-price-row-eur">{{ parts[2] | strip }}€</span>{% endif %}
                    </span>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- ═══ CTA STRIP ═══ -->
  <section class="tg-service-cta">
    <h3 class="tg-service-cta-title">{{ section.settings.cta_title | default: 'Ready to book?' }}</h3>
    <a href="#tg-service-book" class="tg-service-cta-btn">
      {{ section.settings.cta_btn | default: 'Pick a time' }}
      <svg width="14" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
    </a>
  </section>
</div>

<script>
  // Auto-scroll to the booking form on success
  (function () {
    const ok = document.querySelector('.tg-service-form-ok');
    if (ok) ok.scrollIntoView({ behavior: 'smooth', block: 'start' });
  })();

  // ── Calendar picker ─────────────────────────────────────────────
  (function () {
    const cal = document.querySelector('[data-tg-cal]');
    if (!cal) return;

    const titleEl = cal.querySelector('[data-tg-cal-title]');
    const gridEl = cal.querySelector('[data-tg-cal-grid]');
    const prevBtn = cal.querySelector('[data-tg-cal-prev]');
    const nextBtn = cal.querySelector('[data-tg-cal-next]');
    const selectedEl = cal.querySelector('[data-tg-cal-selected]');
    const hiddenInput = document.querySelector('[data-tg-cal-input]');

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const maxDate = new Date(today);
    maxDate.setDate(maxDate.getDate() + 90); // 3 months ahead

    let view = new Date(today.getFullYear(), today.getMonth(), 1);
    let selected = null;

    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                        'July', 'August', 'September', 'October', 'November', 'December'];

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function isoDate(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
    function sameDate(a, b) { return a && b && a.toDateString() === b.toDateString(); }

    function render() {
      titleEl.textContent = monthNames[view.getMonth()] + ' ' + view.getFullYear();

      const year = view.getFullYear();
      const month = view.getMonth();
      const firstDay = new Date(year, month, 1);
      // Mon = 0, Sun = 6
      const startOffset = (firstDay.getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      // Disable prev nav if showing this month already
      const prevMonth = new Date(year, month - 1, 1);
      const lastOfPrev = new Date(year, month, 0);
      prevBtn.disabled = lastOfPrev < today;
      // Disable next nav if 3 months out
      nextBtn.disabled = new Date(year, month + 1, 1) > maxDate;

      let html = '';

      // Leading blanks
      for (let i = 0; i < startOffset; i++) {
        html += '<span class="tg-cal-cell tg-cal-cell--blank" aria-hidden="true"></span>';
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const date = new Date(year, month, d);
        const iso = isoDate(date);
        const dow = date.getDay(); // 0 = Sun
        const past = date < today;
        const tooFar = date > maxDate;
        // Sundays closed
        const closed = dow === 0;
        const disabled = past || tooFar || closed;
        const isSelected = sameDate(date, selected);
        const isToday = sameDate(date, today);

        const classes = [
          'tg-cal-cell',
          disabled ? 'is-disabled' : '',
          isSelected ? 'is-selected' : '',
          isToday ? 'is-today' : ''
        ].filter(Boolean).join(' ');

        const aria = disabled ? 'aria-disabled="true"' : 'tabindex="0"';
        const tag = disabled ? 'span' : 'button';
        html += '<' + tag + ' type="button" class="' + classes + '" data-tg-cal-day="' + iso + '" ' + aria + '>'
              + '<span class="tg-cal-cell-num">' + d + '</span>'
              + '</' + tag + '>';
      }

      gridEl.innerHTML = html;
    }

    function pick(date) {
      selected = date;
      if (hiddenInput) {
        hiddenInput.value = isoDate(date);
        hiddenInput.classList.remove('tg-invalid');
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
      const fmt = date.toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' });
      selectedEl.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> ' + fmt;
      render();
    }

    prevBtn.addEventListener('click', () => {
      if (prevBtn.disabled) return;
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      render();
    });

    nextBtn.addEventListener('click', () => {
      if (nextBtn.disabled) return;
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      render();
    });

    gridEl.addEventListener('click', (e) => {
      const cell = e.target.closest('[data-tg-cal-day]');
      if (!cell || cell.classList.contains('is-disabled')) return;
      const [y, m, d] = cell.dataset.tgCalDay.split('-').map(Number);
      pick(new Date(y, m - 1, d));
    });

    gridEl.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const cell = e.target.closest('[data-tg-cal-day]');
      if (!cell || cell.classList.contains('is-disabled')) return;
      e.preventDefault();
      const [y, m, d] = cell.dataset.tgCalDay.split('-').map(Number);
      pick(new Date(y, m - 1, d));
    });

    render();
  })();

  // ── 3-step wizard ──────────────────────────────────────────────
  (function () {
    const wizard = document.querySelector('[data-tg-wizard]');
    if (!wizard) return;

    const steps = Array.from(wizard.querySelectorAll('[data-tg-step]'));
    const labels = Array.from(wizard.querySelectorAll('[data-tg-step-label]'));
    const fill = wizard.querySelector('[data-tg-wizard-fill]');
    const total = steps.length;
    let current = 1;

    function isVisible(el) {
      return el && el.offsetParent !== null;
    }

    function validateStep(stepNum) {
      const step = steps.find(s => s.dataset.tgStep === String(stepNum));
      if (!step) return true;
      const fields = step.querySelectorAll('[data-tg-validate]');
      let firstInvalid = null;
      let ok = true;
      for (const f of fields) {
        // Skip visually hidden conditional fields
        if (!isVisible(f)) continue;
        if (!f.checkValidity()) {
          ok = false;
          if (!firstInvalid) firstInvalid = f;
          f.classList.add('tg-invalid');
        } else {
          f.classList.remove('tg-invalid');
        }
      }
      if (firstInvalid) {
        firstInvalid.focus({ preventScroll: false });
        firstInvalid.reportValidity();
      }
      return ok;
    }

    function goTo(n) {
      n = Math.max(1, Math.min(total, n));
      current = n;
      steps.forEach(s => s.classList.toggle('is-active', s.dataset.tgStep === String(n)));
      labels.forEach(l => {
        const ln = parseInt(l.dataset.tgStepLabel, 10);
        l.classList.toggle('is-active', ln === n);
        l.classList.toggle('is-done', ln < n);
      });
      if (fill) fill.style.width = ((n / total) * 100) + '%';
      // Scroll the wizard head into view
      const head = wizard.querySelector('.tg-wizard-progress');
      if (head) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    wizard.addEventListener('click', (e) => {
      if (e.target.closest('[data-tg-next]')) {
        if (validateStep(current)) goTo(current + 1);
      } else if (e.target.closest('[data-tg-back]')) {
        goTo(current - 1);
      }
    });

    // On form submit, validate the final step (browser also runs HTML5 validation)
    wizard.addEventListener('submit', (e) => {
      if (!validateStep(current)) {
        e.preventDefault();
      }
    });

    // Clear invalid state on input
    wizard.addEventListener('input', (e) => {
      if (e.target.classList && e.target.classList.contains('tg-invalid')) {
        e.target.classList.remove('tg-invalid');
      }
    });

    // If form has a server-side error after submit, jump to the last step
    const errorBox = wizard.querySelector('.tg-service-form-error');
    if (errorBox) goTo(total);
  })();
</script>

