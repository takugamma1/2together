      "default": "Tell us what is wrong, pick a time, drop the bike off. We handle the rest."
    },
    {
      "type": "text",
      "id": "hero_cta",
      "label": "CTA label",
      "default": "Book now"
    },
    {
      "type": "header",
      "content": "Booking form"
    },
    {
      "type": "image_picker",
      "id": "form_image",
      "label": "Form-side image"
    },
    {
      "type": "text",
      "id": "form_caption_eyebrow",
      "label": "Image caption eyebrow",
      "default": "Workshop"
    },
    {
      "type": "text",
      "id": "form_caption",
      "label": "Image caption",
      "default": "Hands-on by certified mechanics. Most jobs done in 24h."
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Form eyebrow",
      "default": "All in one form"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "TELL US WHAT IS WRONG"
    },
    {
      "type": "text",
      "id": "form_submit",
      "label": "Submit label",
      "default": "Book service"
    },
    {
      "type": "textarea",
      "id": "form_note",
      "label": "Below-form note",
      "default": "We will reply within 24h to confirm the slot. Drop-off only — no on-site repairs while you wait."
    },
    {
      "type": "textarea",
      "id": "form_success",
      "label": "Success message",
      "default": "Thanks — we got your booking. We will reply within 24h to confirm."
    },
    {
      "type": "header",
      "content": "Pricing accordion"
    },
    {
      "type": "text",
      "id": "prices_eyebrow",
      "label": "Eyebrow",
      "default": "Our rates"
    },
    {
      "type": "text",
      "id": "prices_title",
      "label": "Title",
      "default": "PRICES & PACKAGES"
    },
    {
      "type": "textarea",
      "id": "prices_intro",
      "label": "Intro paragraph"
    },
    {
      "type": "header",
      "content": "Closing CTA"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA title",
      "default": "Ready to book?"
    },
    {
      "type": "text",
      "id": "cta_btn",
      "label": "CTA button label",
      "default": "Pick a time"
    }
  ],
  "blocks": [
    {
      "type": "pricing_category",
      "name": "Pricing category",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Category"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Items",
          "info": "One per line. Format: Service name | BGN price | EUR price (price 2 optional). Example: СМЯНА НА ГУМА | 10 | 5.11"
        }
      ]
    }
  ],
  "templates": ["page"]
}
{% endschema %}
