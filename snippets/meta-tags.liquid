{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign tg_desc = page_description
  assign d_home_desc = 'tg.seo.home_description' | t
  assign d_home_title = 'tg.seo.home_title' | t
  if request.page_type == 'index' and request.locale.primary == false
    assign tg_desc = d_home_desc
  elsif request.page_type == 'index' and settings.home_meta_description != blank
    assign tg_desc = settings.home_meta_description
  endif
  assign og_description = tg_desc | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  comment
    Tell crawlers which picture represents this page: the product/article/collection image first,
    the theme's share image otherwise. Without it Google pairs random page images with the title.
  endcomment
  assign tg_og_image = page_image
  if request.page_type == 'product' and product.featured_image
    assign tg_og_image = product.featured_image
  elsif request.page_type == 'article' and article.image
    assign tg_og_image = article.image
  elsif request.page_type == 'collection' and collection.image
    assign tg_og_image = collection.image
  endif
-%}
{%- if tg_og_image -%}
  <meta
    property="og:image"
    content="{{ tg_og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ tg_og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ tg_og_image.width | at_most: 1200 }}"
  >
  <meta
    property="og:image:height"
    content="{{ tg_og_image.height | times: 1200 | divided_by: tg_og_image.width | at_most: tg_og_image.height }}"
  >
  {%- if tg_og_image.alt != blank -%}
  <meta
    property="og:image:alt"
    content="{{ tg_og_image.alt | escape }}"
  >
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {%- if request.page_type == 'index' and request.locale.primary == false -%}{{ d_home_title }}{%- elsif request.page_type == 'index' and settings.home_meta_title != blank -%}{{ settings.home_meta_title }}{%- else -%}{{ page_title }}{%- endif -%}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name or request.page_type == 'index' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if tg_desc != blank %}
  <meta
    name="description"
    content="{{ tg_desc | escape }}"
  >
{% endif %}
