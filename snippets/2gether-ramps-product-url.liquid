{%- comment -%} Outputs the best URL for a ramp model. Params: product, link (override), name (e.g. BREEZE; names with + / set go to set_url), set_url, fallback {%- endcomment -%}
{%- liquid
  assign out = link
  if out == blank and set_url != blank and name != blank
    if name contains '+' or name contains 'SET' or name contains 'set' or name contains 'КОМПЛЕКТ' or name contains 'комплект'
      assign out = set_url
    endif
  endif
  if out == blank and product != blank
    assign out = product.url
  endif
  if out == blank and name != blank
    assign h = name | downcase | strip | replace: ' + ', '-' | replace: ' ', '-'
    if all_products[h] != empty
      assign out = all_products[h].url
    endif
  endif
  assign set_handles = 'breeze-storm-set,breeze-storm,take-off-landing-set,ramp-set' | split: ','
  if out == blank and name != blank
    for h in set_handles
      if name contains '+' and all_products[h] != empty
        assign out = all_products[h].url
        break
      endif
    endfor
  endif
  if out == blank and collections['portable-ramps'] != empty
    assign out = collections['portable-ramps'].url
  endif
  if out == blank
    assign out = fallback
  endif
-%}{{ out }}