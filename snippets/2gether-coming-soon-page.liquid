{%- comment -%} Full-page coming-soon screen for gated paths (settings.soon_paths) {%- endcomment -%}
{{ '2gether-custom.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign d_soon_badge = 'tg.coming_soon.badge' | t
  assign d_soon_title = 'tg.coming_soon.title' | t
  assign d_soon_back = 'tg.coming_soon.back' | t
  assign d_soon_text = 'tg.coming_soon.text' | t
-%}
{%- if request.locale.primary -%}{%- assign s_soon_badge = settings.soon_badge | default: d_soon_badge -%}{%- else -%}{%- assign s_soon_badge = d_soon_badge -%}{%- endif -%}
{%- if request.locale.primary -%}{%- assign s_soon_title = settings.soon_title | default: d_soon_title -%}{%- else -%}{%- assign s_soon_title = d_soon_title -%}{%- endif -%}
{%- if request.locale.primary -%}{%- assign s_soon_text = settings.soon_text | default: d_soon_text -%}{%- else -%}{%- assign s_soon_text = d_soon_text -%}{%- endif -%}
{%- if request.locale.primary -%}{%- assign s_soon_back = settings.soon_back | default: d_soon_back -%}{%- else -%}{%- assign s_soon_back = d_soon_back -%}{%- endif -%}

<section class="tg-section" style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:120px 24px;background:var(--tg-ink);">
  <div style="max-width:640px;display:flex;flex-direction:column;gap:18px;align-items:center;">
    <span class="tg-label">{{ s_soon_badge }}</span>
    <h1 class="tg-f-display" style="margin:0;font-size:clamp(40px,7vw,88px);line-height:0.95;color:var(--tg-text-primary);">{{ s_soon_title }}</h1>
    <p style="margin:0;color:var(--tg-text-secondary);line-height:1.6;">{{ s_soon_text }}</p>
    <a href="{{ routes.root_url }}" class="tg-btn-primary">{{ s_soon_back }} &rarr;</a>
  </div>
</section>
